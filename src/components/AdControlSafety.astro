---
// Why it is safe to let Claude or ChatGPT change ads. Shared by the homepage
// and /ai-ad-control in both locales, so the three promises never drift apart.
//
// Every line here is checked in docs/what-ships.md (ad control, 14 October
// 2026): changes are two-phase and need the user's approval, anything created
// starts switched off, an applied change lands in the brand's Change Log, and
// the approval screen has an "Also allow it to make changes" box. That screen
// is English only in the app, which is why the Arabic quotes it in English.
interface Props {
  locale?: "en" | "ar";
  /** Heading level. h3 inside a homepage section, h2 on its own page. */
  as?: "h2" | "h3";
  class?: string;
}
const { locale = "en", as: Heading = "h3", class: className = "" } = Astro.props;

const COPY = {
  en: {
    heading: "Worried about giving an AI your ad accounts?",
    items: [
      { title: "You approve every change", body: "Each change is shown to you as a preview first, and only happens once you approve it in the chat." },
      { title: "Anything new starts paused", body: "New campaigns, ad sets and ads are created switched off, so nothing new spends until you turn it on." },
      { title: "Every change is on record", body: "Each change is written to the brand's Change Log, with what changed and when. Prefer read-only? Untick one box when you connect." },
    ],
  },
  ar: {
    heading: "تقلق من منح AI صلاحية على حساباتك الإعلانية؟",
    items: [
      { title: "لا تغيير بدون موافقتك", body: "يُعرض عليك كل تغيير كمعاينة أولًا، ولا يُنفَّذ إلا بعد موافقتك في المحادثة." },
      { title: "كل جديد يبدأ متوقفًا", body: "تُنشأ الحملات والمجموعات الإعلانية والإعلانات الجديدة متوقفة، فلا يُصرف عليها شيء قبل أن تشغّلها بنفسك." },
      { title: "كل تغيير مسجّل", body: "يُسجَّل كل تغيير في سجل التغييرات الخاص بالعلامة التجارية، مع ما تغيّر ومتى. تفضّل القراءة فقط؟ ألغِ تحديد خانة \"Also allow it to make changes\" عند الربط." },
    ],
  },
};
const T = COPY[locale];

const icons = [
  `<path d="M20 6 9 17l-5-5"/>`,
  `<rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/>`,
  `<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/>`,
];
---

<div class={className}>
  <Heading class="text-center font-display text-2xl font-bold tracking-tight text-zinc-950 sm:text-3xl">
    {T.heading}
  </Heading>
  <ul class="mt-8 grid gap-4 md:grid-cols-3">
    {T.items.map((item, i) => (
      <li class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-50 text-brand-700">
          <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[i]} />
        </span>
        <p class="mt-4 font-display text-lg font-bold text-zinc-950">{item.title}</p>
        <p class="mt-2 text-sm leading-relaxed text-zinc-500">{item.body}</p>
      </li>
    ))}
  </ul>
</div>
