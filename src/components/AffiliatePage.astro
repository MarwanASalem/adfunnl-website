---
// Markup for /affiliates and /ar/affiliates. All copy lives in each page's
// frontmatter and arrives here as `copy`.
//
// The button is the one exception to "Start free" (CLAUDE.md rule 4): it opens
// the app's join link, which signs people in or makes them a short account and
// then shows the in-app application.

const APP_URL = "https://app.adfunnl.com";
const JOIN_URL = `${APP_URL}/affiliate/join`;

export interface Copy {
  hero: { heading: string; body: string; cta: string };
  steps: { heading: string; items: { title: string; body: string; chip: string }[] };
  counts: { heading: string; body: string; termsLink: string };
  faq: { heading: string; items: { q: string; a: string }[] };
  closing: { heading: string; body: string; cta: string };
}

interface Props {
  copy: Copy;
  termsHref: string;
}
const { copy, termsHref } = Astro.props;
const card = "flex flex-col rounded-[1.6rem] border border-white bg-[linear-gradient(165deg,#ffffff,#f7f5fe_55%,#eae5fc)] p-7 shadow-[0_18px_34px_-20px_rgba(43,29,97,.28)] ring-1 ring-[rgba(87,56,201,.06)]";
const button = "inline-block w-full rounded-xl bg-brand-600 px-8 py-3.5 text-center text-base font-semibold text-white transition hover:bg-brand-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 sm:w-auto";
---

<!-- ================================ HERO ================================ -->
<section class="relative overflow-hidden bg-white px-6 pt-16 pb-16 sm:pt-20">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_70%_55%_at_50%_-15%,#e6e1fb,transparent)]"></div>
  <div class="mx-auto max-w-5xl">
    <h1 class="max-w-3xl font-display text-4xl font-bold tracking-tight text-zinc-950 sm:text-5xl">{copy.hero.heading}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-zinc-500">{copy.hero.body}</p>
    <a href={JOIN_URL} data-track-location="affiliates-hero" class:list={["mt-8 focus-visible:outline-brand-600", button]}>{copy.hero.cta}</a>
  </div>
</section>

<!-- ============================ HOW IT WORKS =========================== -->
<section class="bg-zinc-50/70 px-6 py-16">
  <div class="mx-auto max-w-5xl">
    <h2 class="font-display text-3xl font-bold tracking-tight text-zinc-950">{copy.steps.heading}</h2>
    <ol class="m-snap mt-8 grid gap-5 md:grid-cols-3">
      {copy.steps.items.map((s, i) => (
        <li class={card}>
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white" aria-hidden="true">{i + 1}</span>
          <h3 class="mt-5 text-[1.15rem] font-bold tracking-tight text-[#1e1b4b]">{s.title}</h3>
          <p class="mt-2 flex-1 text-[13px] leading-relaxed text-zinc-500">{s.body}</p>
          <span class:list={["mt-5 self-start rounded-lg border border-brand-100 bg-white px-3 py-1.5 text-xs text-brand-700", { "font-mono": /^[\x20-\x7e·]+$/.test(s.chip) }]} dir="auto">{s.chip}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- ============================ WHAT COUNTS ============================ -->
<section class="bg-white px-6 py-16">
  <div class="mx-auto max-w-3xl">
    <h2 class="font-display text-2xl font-bold tracking-tight text-zinc-950">{copy.counts.heading}</h2>
    <p class="mt-3 text-base leading-relaxed text-zinc-600">{copy.counts.body}</p>
    <a href={termsHref} class="mt-4 inline-block text-sm font-semibold text-brand-700 hover:underline">{copy.counts.termsLink}</a>
  </div>
</section>

<!-- ================================ FAQ ================================ -->
<section class="bg-white px-6 pb-16 sm:pb-20">
  <div class="mx-auto max-w-3xl">
    <h2 class="font-display text-3xl font-bold tracking-tight text-zinc-950">{copy.faq.heading}</h2>
    <div class="mt-8 divide-y divide-zinc-100 border-y border-zinc-100">
      {copy.faq.items.map((f) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-semibold text-zinc-900 [&::-webkit-details-marker]:hidden">
            {f.q}
            <svg class="mt-1 h-4 w-4 shrink-0 text-zinc-400 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8l4 4 4-4"/></svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-zinc-600">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- ================================ CTA ================================ -->
<section class="px-6 pb-24">
  <div class="mx-auto max-w-5xl rounded-3xl bg-ink px-6 py-16 text-center sm:py-20">
    <div class="mx-auto max-w-2xl">
      <h2 class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">{copy.closing.heading}</h2>
      <p class="mt-4 text-lg text-zinc-400">{copy.closing.body}</p>
      <a href={JOIN_URL} data-track-location="affiliates-closing" class:list={["mt-9 focus-visible:outline-white", button]}>{copy.closing.cta}</a>
    </div>
  </div>
</section>
