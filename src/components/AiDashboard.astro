---
// ──────────────────────────────────────────────────────────────────────────
// "Ask for the dashboard" section.
//
// The capability (docs/what-ships.md, checked 22 September 2026): the
// assistant, in the app or over MCP, builds a whole dashboard from a request.
// It is two-phase. The first call returns a plan: the sections, the widget
// count under each, the goal it assumed, and caveats naming the panels that
// would come back empty. Nothing is built until that plan is approved.
//
// So the picture is the plan on one side and the built canvas on the other,
// and the plan card carries an Approve control, because approving is the real
// step. Do not redraw this as a prompt going straight to a finished report:
// that would be a claim the product does not make.
//
// The canvas tiles reuse the homepage's anonymized demo figures, so the two
// sections agree. The page passes the copy in; the labels inside the panels
// live here, in both languages, the way AnalysisStages does it.
// ──────────────────────────────────────────────────────────────────────────
import PlatformIcon from "./PlatformIcon.astro";

interface Props {
  sectionId?: string;
  sectionClass?: string;
  heading: string;
  body: string;
  /** The request typed at the assistant. Persona pages phrase their own. */
  prompt?: string;
  /** Small line under the body: where it works and which plans have it. */
  meta?: string;
  locale?: "en" | "ar";
}

const {
  sectionId = "ai-dashboard",
  sectionClass = "border-t border-zinc-100 bg-white px-6 py-24",
  heading,
  body,
  prompt,
  meta,
  locale = "en",
} = Astro.props;

const rtl = locale === "ar";

const COPY = {
  en: {
    eyebrow: "Built by AI",
    prompt: "Build me a dashboard for Tiffin Co.",
    assistant: "AdFunnl Assistant",
    planChip: "Plan",
    planIntro: "Here is what I would build, from what this brand has connected:",
    goalLabel: "Goal",
    goal: "ecommerce",
    widgets: (n: number) => `${n} widgets`,
    caveat: "Leads has no data in the last 30 days, so I left that panel out.",
    approve: "Approve and build",
    change: "Change something",
    building: "Building",
    built: "Built",
    canvasName: "Tiffin Co. · Blended Overview",
    blended: "Blended",
    sections: [
      { name: "Overview", n: 9 },
      { name: "Performance over time", n: 4 },
      { name: "Campaigns", n: 3 },
      { name: "Geography", n: 2 },
      { name: "Demographics", n: 4 },
      { name: "Placement", n: 2 },
    ],
    bands: { overview: "Overview", time: "Performance over time", rest: "Campaigns, Geography and Demographics" },
    tiles: { spend: "Spend", roas: "ROAS", revenue: "Revenue", campaigns: "Top campaigns", geo: "By region", age: "By age" },
  },
  ar: {
    eyebrow: "من بناء AI",
    prompt: "ابنِ لي لوحة لـ Tiffin Co.",
    assistant: "مساعد AdFunnl",
    planChip: "الخطة",
    planIntro: "هذه اللوحة التي سأبنيها، بناءً على ما ربطته هذه العلامة:",
    goalLabel: "الهدف",
    goal: "ecommerce",
    widgets: (n: number) => `${n} عناصر`,
    caveat: "لا توجد بيانات Leads في آخر 30 يومًا، لذلك استبعدت هذه اللوحة.",
    approve: "اعتمد وابنِ",
    change: "عدّل شيئًا",
    building: "جارٍ البناء",
    built: "تم البناء",
    canvasName: "Tiffin Co. · نظرة عامة مدمجة",
    blended: "المدمج",
    sections: [
      { name: "نظرة عامة", n: 9 },
      { name: "الأداء عبر الوقت", n: 4 },
      { name: "الحملات", n: 3 },
      { name: "الجغرافيا", n: 2 },
      { name: "الديموغرافيا", n: 4 },
      { name: "Placement", n: 2 },
    ],
    bands: { overview: "نظرة عامة", time: "الأداء عبر الوقت", rest: "الحملات والجغرافيا والديموغرافيا" },
    tiles: { spend: "الإنفاق", roas: "ROAS", revenue: "الإيرادات", campaigns: "أعلى الحملات", geo: "حسب المنطقة", age: "حسب العمر" },
  },
};

const T = COPY[locale];
const askText = prompt ?? T.prompt;

// Per-platform ROAS tiles. Same anonymized demo figures as the homepage hero.
const platforms = [
  { key: "meta",       name: "Meta",     roas: "5.79x" },
  { key: "tiktok",     name: "TikTok",   roas: "5.75x" },
  { key: "snapchat",   name: "Snapchat", roas: "8.60x" },
];

// Campaign rows for the small table tile.
const campaignRows = [
  { w: "78%", v: "6.1x" },
  { w: "58%", v: "4.4x" },
  { w: "36%", v: "2.8x" },
];

// The area chart under "Performance over time".
const spark = [26, 34, 30, 45, 41, 58, 52, 69, 64, 80];
const SW = 260, SH = 76;
const sparkPts = spark.map((v, i) => [
  Math.round((i / (spark.length - 1)) * SW * 10) / 10,
  Math.round((SH - (v / 92) * SH) * 10) / 10,
]);
const sparkLine = sparkPts.map((p, i) => `${i ? "L" : "M"}${p[0]} ${p[1]}`).join(" ");
const sparkArea = `${sparkLine} L${SW} ${SH} L0 ${SH} Z`;

// Age bars for the demographics tile.
const ageBars = [38, 72, 90, 54, 30, 18];
---

<section id={sectionId} class={sectionClass}>
  <div class="mx-auto max-w-6xl">
    <div class="aib relative overflow-hidden rounded-3xl bg-ink px-6 py-12 sm:px-10 sm:py-14" data-ai-dashboard>
      <!-- brand glow behind the panels -->
      <div class="pointer-events-none absolute inset-0 -z-0 opacity-90">
        <div class="absolute -left-24 -top-32 h-[38rem] w-[38rem] rounded-full bg-[radial-gradient(closest-side,rgba(101,73,221,0.55),transparent)]"></div>
        <div class="absolute -bottom-40 end-[-6rem] h-[32rem] w-[32rem] rounded-full bg-[radial-gradient(closest-side,rgba(139,115,230,0.32),transparent)]"></div>
      </div>

      <div class="relative">
        <!-- Copy -->
        <div class="mx-auto max-w-2xl text-center">
          <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-semibold text-brand-100">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18M3 12h18"/><path d="M6.5 6.5l11 11M17.5 6.5l-11 11"/></svg>
            {T.eyebrow}
          </span>
          <h2 class="mt-5 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">{heading}</h2>
          <p class="mt-4 text-base leading-relaxed text-zinc-300 sm:text-lg">{body}</p>
          {meta && <p class="mt-4 text-sm text-zinc-400">{meta}</p>}
        </div>

        <!-- Illustration: the plan, then the canvas it builds -->
        <div class="mt-11 grid items-center gap-6 lg:grid-cols-[0.92fr_auto_1.08fr] lg:gap-5">
          <!-- ── The ask, and the plan that comes back ── -->
          <div class="aib-step rounded-2xl border border-white/10 bg-white shadow-2xl shadow-black/40" style="--d:0ms">
            <div class="flex items-center gap-2 border-b border-zinc-100 bg-zinc-50 px-4 py-2.5">
              <span class="flex h-5 w-5 items-center justify-center rounded-md bg-brand-600 text-white">
                <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18M3 12h18"/><path d="M6.5 6.5l11 11M17.5 6.5l-11 11"/></svg>
              </span>
              <span class="text-[11px] font-semibold text-zinc-600">{T.assistant}</span>
              <span class="ms-auto rounded-md bg-brand-50 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-brand-700">{T.planChip}</span>
            </div>

            <div class="flex flex-col gap-3 p-4">
              <div class="flex justify-end">
                <p class="aib-step max-w-[88%] rounded-2xl rounded-br-sm bg-brand-600 px-3.5 py-2 text-sm leading-relaxed text-white" style="--d:120ms">{askText}</p>
              </div>

              <div class="aib-step rounded-2xl rounded-bl-sm bg-zinc-100 p-3.5" style="--d:420ms">
                <p class="text-[13px] leading-relaxed text-zinc-700">{T.planIntro}</p>

                <div class="mt-2.5 flex items-center gap-2">
                  <span class="text-[10px] font-semibold uppercase tracking-wide text-zinc-400">{T.goalLabel}</span>
                  <span class="rounded-full bg-white px-2 py-0.5 text-[11px] font-semibold text-brand-700 ring-1 ring-brand-200">{T.goal}</span>
                </div>

                <ul class="mt-3 space-y-1.5">
                  {T.sections.map((s, i) => (
                    <li class="aib-step flex items-center gap-2 rounded-lg bg-white px-2.5 py-1.5" style={`--d:${560 + i * 90}ms`}>
                      <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500"></span>
                      <span class="flex-1 truncate text-[12px] font-semibold text-zinc-700">{s.name}</span>
                      <span class="shrink-0 rounded-full bg-zinc-100 px-2 py-0.5 text-[10px] font-medium tabular-nums text-zinc-500">{T.widgets(s.n)}</span>
                    </li>
                  ))}
                </ul>

                <p class="aib-step mt-3 flex items-start gap-2 rounded-lg bg-amber-50 px-2.5 py-2 text-[11px] leading-relaxed text-amber-800" style="--d:1160ms">
                  <svg class="mt-px h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
                  {T.caveat}
                </p>

                <div class="aib-step mt-3 flex flex-wrap gap-2" style="--d:1280ms">
                  <span class="aib-approve inline-flex items-center gap-1.5 rounded-lg bg-brand-600 px-3 py-1.5 text-[11px] font-semibold text-white">
                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6.5"/></svg>
                    {T.approve}
                  </span>
                  <span class="inline-flex items-center rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-[11px] font-semibold text-zinc-600">{T.change}</span>
                </div>
              </div>
            </div>
          </div>

          <!-- the hinge -->
          <div class="aib-step flex items-center justify-center lg:flex-col" style="--d:1400ms" aria-hidden="true">
            <span class="h-px w-10 bg-gradient-to-r from-transparent to-white/25 lg:h-10 lg:w-px lg:bg-gradient-to-b"></span>
            <span class="mx-2 flex h-8 w-8 items-center justify-center rounded-full border border-white/20 bg-white/10 text-white lg:my-2 lg:mx-0">
              <svg class={`h-4 w-4 ${rtl ? "rotate-180" : ""} lg:rotate-90`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
            <span class="h-px w-10 bg-gradient-to-l from-transparent to-white/25 lg:h-10 lg:w-px lg:bg-gradient-to-t"></span>
          </div>

          <!-- ── The canvas it builds ── -->
          <div class="aib-step overflow-hidden rounded-2xl border border-white/10 bg-white shadow-2xl shadow-black/40" style="--d:1440ms">
            <div class="flex items-center gap-2 border-b border-zinc-100 bg-zinc-50 px-4 py-2.5">
              <span class="h-2.5 w-2.5 rounded-full bg-zinc-300"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-zinc-300"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-zinc-300"></span>
              <span class="ms-2 truncate text-[11px] font-medium text-zinc-500">{T.canvasName}</span>
              <span class="aib-status ms-auto inline-flex shrink-0 items-center gap-1.5 rounded-md bg-brand-50 px-2 py-0.5 text-[10px] font-semibold text-brand-700">
                <span class="aib-dot h-1.5 w-1.5 rounded-full bg-brand-500"></span>
                <span class="grid">
                  <span class="aib-when-building col-start-1 row-start-1">{T.building}</span>
                  <span class="aib-when-built col-start-1 row-start-1">{T.built}</span>
                </span>
              </span>
            </div>

            <div class="grid grid-cols-6 gap-2 bg-[#faf9fd] p-3 [background-image:radial-gradient(#e4e0f6_1px,transparent_1px)] [background-size:16px_16px]">
              <!-- Overview band -->
              <div class="aib-tile col-span-6 rounded-lg bg-brand-600 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-white" style="--d:1560ms">{T.bands.overview}</div>

              {platforms.map((p, i) => (
                <div class="aib-tile col-span-2 rounded-lg border border-zinc-200 bg-white p-2.5" style={`--d:${1660 + i * 110}ms`}>
                  <div class="flex items-center gap-1.5">
                    <span class="flex h-4 w-4 items-center justify-center"><PlatformIcon platform={p.key} class="h-3.5 w-3.5" /></span>
                    <span class="truncate text-[10px] font-semibold text-zinc-500">{p.name}</span>
                  </div>
                  <p class="mt-1 font-display text-sm font-bold tabular-nums lining-nums text-zinc-900">{p.roas}</p>
                  <p class="text-[9px] font-medium uppercase tracking-wide text-zinc-400">{T.tiles.roas}</p>
                </div>
              ))}

              <div class="aib-tile col-span-6 grid grid-cols-3 gap-2 rounded-lg border border-brand-200 bg-brand-50 p-2.5" style="--d:2000ms">
                <div>
                  <p class="text-[9px] font-semibold uppercase tracking-wide text-brand-500">{T.tiles.spend}</p>
                  <p class="font-display text-sm font-bold tabular-nums lining-nums text-brand-900">26,323</p>
                </div>
                <div>
                  <p class="text-[9px] font-semibold uppercase tracking-wide text-brand-500">{T.blended} ROAS</p>
                  <p class="font-display text-sm font-bold tabular-nums lining-nums text-brand-900">6.69x</p>
                </div>
                <div>
                  <p class="text-[9px] font-semibold uppercase tracking-wide text-brand-500">{T.tiles.revenue}</p>
                  <p class="font-display text-sm font-bold tabular-nums lining-nums text-brand-900">180,138</p>
                </div>
              </div>

              <!-- Performance over time -->
              <div class="aib-tile col-span-6 rounded-lg bg-zinc-900 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-white" style="--d:2120ms">{T.bands.time}</div>

              <div class="aib-tile col-span-6 rounded-lg border border-zinc-200 bg-white p-2.5" style="--d:2220ms">
                <svg class="block h-auto w-full" viewBox={`0 0 ${SW} ${SH}`} preserveAspectRatio="none" style="direction:ltr;height:76px" role="img" aria-hidden="true">
                  <path class="aib-area" d={sparkArea} fill="rgba(101,73,221,0.14)" />
                  <path class="aib-spark" d={sparkLine} pathLength="1" fill="none" stroke="#6549dd" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>

              <!-- Campaigns, Geography, Demographics -->
              <div class="aib-tile col-span-6 rounded-lg bg-zinc-900 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-white" style="--d:2480ms">{T.bands.rest}</div>

              <div class="aib-tile col-span-2 rounded-lg border border-zinc-200 bg-white p-2.5" style="--d:2580ms">
                <p class="mb-1.5 text-[9px] font-semibold uppercase tracking-wide text-zinc-400">{T.tiles.campaigns}</p>
                <div class="space-y-1.5">
                  {campaignRows.map((r) => (
                    <div class="flex items-center gap-2">
                      <span class="h-2 flex-1 overflow-hidden rounded-full bg-zinc-100">
                        <span class="block h-full rounded-full bg-brand-500" style={`width:${r.w}`}></span>
                      </span>
                      <span class="w-8 shrink-0 text-end text-[9px] font-semibold tabular-nums text-zinc-500">{r.v}</span>
                    </div>
                  ))}
                </div>
              </div>

              <div class="aib-tile col-span-2 rounded-lg border border-zinc-200 bg-white p-2.5" style="--d:2680ms">
                <p class="mb-1.5 text-[9px] font-semibold uppercase tracking-wide text-zinc-400">{T.tiles.geo}</p>
                <svg class="block h-[52px] w-full" viewBox="0 0 60 52" preserveAspectRatio="xMidYMid meet" style="direction:ltr" role="img" aria-hidden="true">
                  <path d="M8 6h20l8 6h16v14l-6 8v12H22l-8-8H8z" fill="#ded7f9" />
                  <path d="M22 12h14l6 6v10H26l-4-6z" fill="#6549dd" />
                  <circle cx="30" cy="20" r="3" fill="#fff" opacity="0.9" />
                </svg>
              </div>

              <div class="aib-tile col-span-2 rounded-lg border border-zinc-200 bg-white p-2.5" style="--d:2760ms">
                <p class="mb-1.5 text-[9px] font-semibold uppercase tracking-wide text-zinc-400">{T.tiles.age}</p>
                <div class="flex h-[52px] items-end gap-1" style="direction:ltr">
                  {ageBars.map((h, i) => (
                    <span class="aib-bar flex-1 rounded-sm bg-brand-400" style={`height:${h}%;--d:${2840 + i * 70}ms`}></span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* ── "Ask for the dashboard": the build, played once on scroll ──
     Everything is visible by default. The component's own script marks the
     card primed, which is what hides the steps, so a page without JS shows
     the finished picture instead of an empty box. */
  .aib[data-primed] .aib-step,
  .aib[data-primed] .aib-tile { opacity: 0; }
  .aib[data-primed].is-on .aib-step { animation: aibIn .55s cubic-bezier(.2,.7,.2,1) both; animation-delay: var(--d, 0ms); }
  .aib[data-primed].is-on .aib-tile { animation: aibTile .5s cubic-bezier(.2,.7,.2,1) both; animation-delay: var(--d, 0ms); }
  @keyframes aibIn { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes aibTile { from { opacity: 0; transform: translateY(10px) scale(.96); } to { opacity: 1; transform: none; } }

  /* The Approve control pulses once, just before the canvas starts filling. */
  .aib[data-primed].is-on .aib-approve { animation: aibPress 1s ease-in-out 1.28s 1; }
  @keyframes aibPress {
    0%, 100% { transform: none; box-shadow: 0 0 0 0 rgba(139,115,230,0); }
    40% { transform: scale(1.05); box-shadow: 0 0 0 7px rgba(139,115,230,.28); }
    70% { transform: scale(.97); }
  }

  /* Status chip: Building while the tiles land, then Built. The two words sit
     in one grid cell, so the chip never changes width mid-build. */
  .aib .aib-when-building { opacity: 0; }
  .aib[data-primed].is-on .aib-when-building { animation: aibLabelOut 0.3s linear 3.35s both; }
  .aib[data-primed].is-on .aib-when-built { animation: aibLabelIn 0.3s linear 3.35s both; }
  .aib[data-primed].is-on .aib-dot { animation: aibPulse 1s ease-in-out 0s 3; }
  @keyframes aibLabelOut { from { opacity: 1; } to { opacity: 0; } }
  @keyframes aibLabelIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes aibPulse { 0%,100% { opacity: 1; } 50% { opacity: .25; } }

  .aib[data-primed].is-on .aib-spark { animation: aibDraw 1.1s ease-out 2.3s both; }
  @keyframes aibDraw { from { stroke-dasharray: 1; stroke-dashoffset: 1; } to { stroke-dasharray: 1; stroke-dashoffset: 0; } }
  .aib[data-primed].is-on .aib-area { animation: aibIn .8s ease-out 2.6s both; }
  .aib[data-primed].is-on .aib-bar { transform-origin: bottom; animation: aibGrow .5s cubic-bezier(.2,.7,.2,1) both; animation-delay: var(--d, 0ms); }
  @keyframes aibGrow { from { transform: scaleY(.1); opacity: 0; } to { transform: none; opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .aib[data-primed] .aib-step,
    .aib[data-primed] .aib-tile { opacity: 1; }
    .aib .aib-step, .aib .aib-tile, .aib .aib-approve,
    .aib .aib-spark, .aib .aib-area, .aib .aib-bar,
    .aib .aib-dot, .aib .aib-when-building, .aib .aib-when-built { animation: none !important; }
    .aib .aib-when-building { opacity: 0; }
    .aib .aib-when-built { opacity: 1; }
  }
</style>

<script>
  // Prime the card (which is what hides its steps), then play the build once
  // it is on screen. Reduced motion skips straight to the finished state.
  const cards = document.querySelectorAll<HTMLElement>("[data-ai-dashboard]");
  if (cards.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    cards.forEach((c) => c.setAttribute("data-primed", ""));
    if (reduced) {
      cards.forEach((c) => c.classList.add("is-on"));
    } else {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add("is-on");
          io.unobserve(e.target);
        }
      }, { threshold: 0.25 });
      cards.forEach((c) => io.observe(c));

      // Belt and braces. Priming is what hides the steps, so anything that
      // stops the observer from firing would leave an empty card on the page.
      // Unpriming a card that never played puts it back to its finished state,
      // which does not depend on an animation running.
      window.setTimeout(() => {
        cards.forEach((c) => {
          if (!c.classList.contains("is-on")) c.removeAttribute("data-primed");
        });
      }, 8000);
    }
  }
</script>
