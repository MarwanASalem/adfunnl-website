---
// ── Blog post shell ─────────────────────────────────────────────────────
// Every post, English and Arabic, renders through this one component, so the
// markup, the Article and FAQPage schema and the breadcrumbs stay identical
// across posts. The copy itself stays in the post's page frontmatter, like
// every other page on the site, and comes in through `post`.
//
// Inline formatting: **bold**, and [[...]] for a run that must stay left to
// right inside Arabic (a sum, a rate, a percentage), see docs/voice.md
// section 7. Strings are escaped first, so nothing else can become HTML.
import Layout from "../layouts/Layout.astro";
import type { Post } from "../data/blog";

interface Props {
  post: Post;
  locale?: "en" | "ar";
}

const { post, locale = "en" } = Astro.props;
const ar = locale === "ar";
const APP_URL = "https://app.adfunnl.com";
const SITE = "https://www.adfunnl.com";

const UI = {
  en: { blog: "Blog", by: "AdFunnl", startFree: "Start free", dateLocale: "en-GB" },
  ar: { blog: "المدونة", by: "AdFunnl", startFree: "ابدأ مجانًا", dateLocale: "ar-EG-u-nu-latn" },
}[locale];

const blogPath = ar ? "/ar/blog" : "/blog";
const postPath = `${blogPath}/${post.slug}`;
const url = `${SITE}${postPath}`;

const fmtDate = (iso: string) =>
  new Intl.DateTimeFormat(UI.dateLocale, { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })
    .format(new Date(`${iso}T00:00:00Z`));

const esc = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const rich = (s: string) =>
  esc(s)
    .replace(/\*\*(.+?)\*\*/g, '<strong class="font-semibold text-zinc-900">$1</strong>')
    .replace(/\[\[(.+?)\]\]/g, '<bdi dir="ltr" class="whitespace-nowrap">$1</bdi>');
const plain = (s: string) => s.replace(/\*\*(.+?)\*\*/g, "$1").replace(/\[\[(.+?)\]\]/g, "$1");

const schema = [
  {
    "@type": "BlogPosting",
    "@id": `${url}#article`,
    headline: post.title,
    description: post.description,
    datePublished: post.published,
    dateModified: post.updated ?? post.published,
    inLanguage: locale,
    url,
    image: `${SITE}/og-image.png`,
    mainEntityOfPage: { "@id": `${url}#webpage` },
    author: { "@id": `${SITE}/#organization` },
    publisher: { "@id": `${SITE}/#organization` },
  },
  {
    "@type": "FAQPage",
    "@id": `${url}#faq`,
    mainEntity: post.faq.items.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: plain(f.a) },
    })),
  },
];
---

<Layout
  locale={locale}
  title={post.title}
  seoTitle={post.seoTitle}
  description={post.description}
  ogType="article"
  schema={schema}
  crumbTrail={[
    { name: UI.blog, path: "/blog" },
    { name: post.title, path: `/blog/${post.slug}` },
  ]}
>
  <main>
    <article class="mx-auto max-w-3xl px-6 pt-12 pb-20 sm:pt-16">
      <header data-track-location="hero">
        <nav aria-label="Breadcrumb" class="text-sm font-medium text-brand-700">
          <a href={blogPath} class="hover:underline">{UI.blog}</a>
        </nav>
        <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-zinc-950 sm:text-5xl">{post.title}</h1>
        <p class="mt-5 text-lg leading-relaxed text-zinc-500">{post.lead}</p>
        <p class="mt-5 text-sm text-zinc-400">
          {UI.by} · <time datetime={post.published}>{fmtDate(post.published)}</time>
        </p>
        <a href={`${APP_URL}/signup`}
           class="mt-7 inline-block w-full rounded-xl bg-brand-600 px-7 py-3.5 text-center text-base font-semibold text-white shadow-lg shadow-brand-200 transition hover:bg-brand-700 sm:w-auto">
          {UI.startFree}
        </a>
      </header>

      {post.sections.map((section) => (
        <section id={section.id} class="mt-14 scroll-mt-24">
          <h2 class="font-display text-2xl font-bold tracking-tight text-zinc-950 sm:text-3xl">{section.heading}</h2>
          <div class="mt-5 space-y-5 text-[17px] leading-relaxed text-zinc-600">
            {section.blocks.map((b) => {
              if (b.type === "p") return <p set:html={rich(b.text)} />;
              if (b.type === "formula")
                return (
                  <p class="rounded-xl border border-brand-100 bg-brand-50/60 px-5 py-4 text-center font-display text-lg font-bold text-brand-800">
                    {b.text}
                  </p>
                );
              if (b.type === "list")
                return (
                  <ul class="space-y-3">
                    {b.items.map((it) => (
                      <li class="flex gap-3">
                        <span class="mt-[0.6em] h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500" aria-hidden="true"></span>
                        <span><strong class="font-semibold text-zinc-900" set:html={rich(it.lead)} /> <span set:html={rich(it.text)} /></span>
                      </li>
                    ))}
                  </ul>
                );
              return (
                <div class="-mx-6 overflow-x-auto px-6 sm:mx-0 sm:px-0">
                  <table class="w-full min-w-[36rem] border-collapse text-sm tabular-nums lining-nums">
                    <thead>
                      <tr class="border-b border-zinc-200 text-start text-xs font-semibold uppercase tracking-wide text-zinc-500">
                        {b.head.map((h) => <th scope="col" class="px-3 py-2 text-start first:ps-0">{h}</th>)}
                      </tr>
                    </thead>
                    <tbody>
                      {b.rows.map((row) => (
                        <tr class="border-b border-zinc-100">
                          {row.map((cell, i) => (
                            i === 0
                              ? <th scope="row" class="px-3 py-2.5 text-start font-medium text-zinc-900 first:ps-0">{cell}</th>
                              : <td class="px-3 py-2.5 text-start text-zinc-700">{cell}</td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                    {b.foot && (
                      <tfoot>
                        <tr class="font-semibold text-zinc-900">
                          {b.foot.map((cell) => <td class="px-3 py-2.5 text-start first:ps-0">{cell}</td>)}
                        </tr>
                      </tfoot>
                    )}
                  </table>
                </div>
              );
            })}
          </div>
        </section>
      ))}

      <section id={post.faq.id} class="mt-14 scroll-mt-24">
        <h2 class="font-display text-2xl font-bold tracking-tight text-zinc-950 sm:text-3xl">{post.faq.heading}</h2>
        <dl class="mt-6 divide-y divide-zinc-100 border-y border-zinc-100">
          {post.faq.items.map((f) => (
            <div class="py-5">
              <dt class="text-[17px] font-semibold text-zinc-900">{f.q}</dt>
              <dd class="mt-2 text-[17px] leading-relaxed text-zinc-600" set:html={rich(f.a)} />
            </div>
          ))}
        </dl>
      </section>

      <section id={post.close.id} class="mt-14 rounded-2xl bg-zinc-50 px-6 py-10 text-center sm:px-10">
        <h2 class="font-display text-2xl font-bold tracking-tight text-zinc-950 sm:text-3xl">{post.close.heading}</h2>
        <p class="mx-auto mt-4 max-w-xl text-[17px] leading-relaxed text-zinc-600">{post.close.body}</p>
        <a href={`${APP_URL}/signup`}
           class="mt-7 inline-block w-full rounded-xl bg-brand-600 px-7 py-3.5 text-center text-base font-semibold text-white shadow-lg shadow-brand-200 transition hover:bg-brand-700 sm:w-auto">
          {UI.startFree}
        </a>
      </section>
    </article>
  </main>
</Layout>
