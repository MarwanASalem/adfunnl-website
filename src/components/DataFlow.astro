---
// Animated data-flow pipeline: sources → AdFunnl → live dashboard → recipient.
//
// Shared by the homepage and the "AdFunnl For" persona pages. The diagram is
// identical everywhere; only the framing copy changes, so every user-visible
// string is a prop. Keep the geometry here: if the picture needs to change,
// it should change in one place.
//
// `scroll` turns the section into a scroll-driven story on a dark, animated
// ground (the homepage uses it). The script writes one number, --p from 0 to
// 1, as you scroll, and every piece reads its own window of it through --a
// (start) and --b (length). On desktops tall enough, the section pins while
// the diagram assembles. Phones get a vertical diagram that assembles as it
// passes through the screen, with no pinning. Without JS, or with reduced
// motion, --p stays at 1 and the finished diagram shows.
interface Props {
  /** Section wrapper */
  sectionId?: string;
  sectionClass?: string;
  /**
   * Framing copy above the diagram. `eyebrow` is opt-in and usually wrong:
   * see R1 in docs/voice.md. Only pass it when it says something the heading
   * does not.
   */
  eyebrow?: string;
  heading?: string;
  body?: string;
  /** Terminal node: the persona-specific payoff */
  outLabel?: string;
  outSub?: string;
  /** Accessible description of the whole picture */
  alt?: string;
  /**
   * Suffix for the SVG's internal ids, so two instances on one page can't
   * clash over <defs> references.
   */
  uid?: string;
  /** Scroll-driven version on a dark animated background. */
  scroll?: boolean;
}

const {
  sectionId,
  scroll = false,
  sectionClass = scroll ? "sf relative bg-ink" : "relative overflow-hidden bg-white px-6 py-24",
  eyebrow,
  heading = "From every source to a client-ready report",
  body,
  outLabel = "Delivered",
  outSub = "to your client",
  alt = "Data flows from Meta, Google Ads, Shopify, TikTok, Snapchat and Bosta into AdFunnl, which unifies and visualizes it before delivering a report to the client.",
  uid = Math.random().toString(36).slice(2, 8),
} = Astro.props;

// Scoped ids for <defs>, see the `uid` prop.
const ID = {
  particle: `flowParticle-${uid}`,
  glow: `flowGlow-${uid}`,
  p: (n: string) => `${n}-${uid}`,
};

// ── SVG-native platform logos ──
// (inside an <svg> we can't use <img>, so Google Ads is inlined as the
// 4-colour "G" and the rest reuse the app's official marks.) Each glyph is a
// nested 26×26 svg placed by a translated parent <g>.
const TIKTOK_D = "M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z";
const SHOPIFY_D = "M15.337 23.979l7.216-1.561s-2.604-17.613-2.625-17.73c-.018-.116-.114-.192-.211-.192s-1.929-.136-1.929-.136-1.275-1.274-1.439-1.411c-.045-.037-.075-.057-.121-.074l-.914 21.104h.023zM11.71 11.305s-.81-.424-1.774-.424c-1.447 0-1.504.906-1.504 1.141 0 1.232 3.24 1.715 3.24 4.629 0 2.295-1.44 3.76-3.406 3.76-2.354 0-3.54-1.465-3.54-1.465l.646-2.086s1.245 1.066 2.28 1.066c.675 0 .975-.545.975-.932 0-1.619-2.654-1.694-2.654-4.359-.034-2.237 1.571-4.416 4.827-4.416 1.257 0 1.875.361 1.875.361l-.945 2.715-.02.01zM11.17.83c.136 0 .271.038.405.135-.984.465-2.064 1.639-2.508 3.992-.656.213-1.293.405-1.889.578C7.697 3.75 8.951.84 11.17.84V.83zm1.235 2.949v.135c-.754.232-1.583.484-2.394.736.466-1.777 1.333-2.645 2.085-2.971.193.501.309 1.176.309 2.1zm.539-2.234c.694.074 1.141.867 1.429 1.755-.349.114-.735.231-1.158.366v-.252c0-.752-.096-1.371-.271-1.871v.002zm2.992 1.289c-.02 0-.06.021-.078.021s-.289.075-.714.21c-.423-1.233-1.176-2.37-2.508-2.37h-.115C12.135.209 11.669 0 11.265 0 8.159 0 6.675 3.877 6.21 5.846c-1.194.365-2.063.636-2.16.674-.675.213-.694.232-.772.87-.075.462-1.83 14.063-1.83 14.063L15.009 24l.927-21.166z";
const SNAP_D = "M12.206.793c.99 0 4.347.276 5.93 3.821.529 1.193.403 3.219.299 4.847l-.003.06c-.012.18-.022.345-.03.51.075.045.203.09.401.09.3-.016.659-.12 1.033-.301.165-.088.344-.104.464-.104.182 0 .359.029.509.09.45.149.734.479.734.838.015.449-.39.839-1.213 1.168-.089.029-.209.075-.344.119-.45.135-1.139.36-1.333.81-.09.224-.061.524.12.868l.015.015c.06.136 1.526 3.475 4.791 4.014.255.044.435.27.42.509 0 .075-.015.149-.045.225-.24.569-1.273.988-3.146 1.271-.059.091-.12.375-.164.57-.029.179-.074.36-.134.553-.076.271-.27.405-.555.405h-.03c-.135 0-.313-.031-.538-.074-.36-.075-.765-.135-1.273-.135-.3 0-.599.015-.913.074-.6.104-1.123.464-1.723.884-.853.599-1.826 1.288-3.294 1.288-.06 0-.119-.015-.18-.015h-.149c-1.468 0-2.427-.675-3.279-1.288-.599-.42-1.107-.779-1.707-.884-.314-.045-.629-.074-.928-.074-.54 0-.958.089-1.272.149-.211.043-.391.074-.54.074-.374 0-.523-.224-.583-.42-.061-.192-.09-.389-.135-.567-.046-.181-.105-.494-.166-.57-1.918-.222-2.95-.642-3.189-1.226-.031-.063-.052-.15-.055-.225-.015-.243.165-.465.42-.509 3.264-.54 4.73-3.879 4.791-4.02l.016-.029c.18-.345.224-.645.119-.869-.195-.434-.884-.658-1.332-.809-.121-.029-.24-.074-.346-.119-1.107-.435-1.257-.93-1.197-1.273.09-.479.674-.793 1.168-.793.146 0 .27.029.383.074.42.194.789.3 1.104.3.234 0 .384-.06.465-.105l-.046-.569c-.098-1.626-.225-3.651.307-4.837C7.392 1.077 10.739.807 11.727.807l.419-.015h.06z";
const META_D = "M6.915 4.03c-1.968 0-3.683 1.28-4.871 3.113C.704 9.208 0 11.883 0 14.449c0 .706.07 1.369.21 1.973a6.624 6.624 0 0 0 .265.86 5.297 5.297 0 0 0 .371.761c.696 1.159 1.818 1.927 3.593 1.927 1.497 0 2.633-.671 3.965-2.444.76-1.012 1.144-1.626 2.663-4.32l.756-1.339.186-.325c.061.1.121.196.183.3l2.152 3.595c.724 1.21 1.665 2.556 2.47 3.314 1.046.987 1.992 1.22 3.06 1.22 1.075 0 1.876-.355 2.455-.843a3.743 3.743 0 0 0 .81-.973c.542-.939.861-2.127.861-3.745 0-2.72-.681-5.357-2.084-7.45-1.282-1.912-2.957-2.93-4.716-2.93-1.047 0-2.088.467-3.053 1.308-.652.57-1.257 1.29-1.82 2.05-.69-.875-1.335-1.547-1.958-2.056-1.182-.966-2.315-1.303-3.454-1.303zm10.16 2.053c1.147 0 2.188.758 2.992 1.999 1.132 1.748 1.647 4.195 1.647 6.4 0 1.548-.368 2.9-1.839 2.9-.58 0-1.027-.23-1.664-1.004-.496-.601-1.343-1.878-2.832-4.358l-.617-1.028a44.908 44.908 0 0 0-1.255-1.98c.07-.109.141-.224.211-.327 1.12-1.667 2.118-2.602 3.358-2.602zm-10.201.553c1.265 0 2.058.791 2.675 1.446.307.327.737.871 1.234 1.579l-1.02 1.566c-.757 1.163-1.882 3.017-2.837 4.338-1.191 1.649-1.81 1.817-2.486 1.817-.524 0-1.038-.237-1.383-.794-.263-.426-.464-1.13-.464-2.046 0-2.221.63-4.535 1.66-6.088.454-.687.964-1.226 1.533-1.533a2.264 2.264 0 0 1 1.088-.285z";

const FLOW_LOGOS: Record<string, string> = {
  meta: `<svg width="26" height="26" viewBox="0 0 24 24"><path fill="#0082FB" d="${META_D}"/></svg>`,
  google_ads: `<svg width="26" height="26" viewBox="0 0 48 48"><path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"/><path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z"/><path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.211 35.091 26.715 36 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/><path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303c-.792 2.237-2.231 4.166-4.087 5.571l6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/></svg>`,
  shopify: `<svg width="26" height="26" viewBox="0 0 24 24"><path fill="#95BF47" d="${SHOPIFY_D}"/></svg>`,
  tiktok: `<svg width="26" height="26" viewBox="0 0 24 24"><path fill="#25F4EE" transform="translate(-0.7 0.5)" d="${TIKTOK_D}"/><path fill="#FE2C55" transform="translate(0.7 -0.5)" d="${TIKTOK_D}"/><path fill="#010101" d="${TIKTOK_D}"/></svg>`,
  snapchat: `<svg width="26" height="26" viewBox="0 0 24 24"><rect width="24" height="24" rx="4" fill="#FFFC00"/><path fill="#FFF" stroke="#000" stroke-width="0.5" transform="translate(3 3) scale(0.75)" d="${SNAP_D}"/></svg>`,
  bosta: `<svg width="26" height="26" viewBox="0 0 24 24"><rect width="24" height="24" rx="6" fill="#E8173B"/><path fill="#fff" d="M12 5a4 4 0 0 1 4 4c0 2.5-2 4.5-4 6.5C10 13.5 8 11.5 8 9a4 4 0 0 1 4-4zm0 2.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zM7 17h10v2H7z"/></svg>`,
};

const sources = [
  { y: 40,  key: "meta",       label: "Meta" },
  { y: 120, key: "google_ads", label: "Google Ads" },
  { y: 200, key: "shopify",    label: "Shopify" },
  { y: 280, key: "tiktok",     label: "TikTok" },
  { y: 360, key: "snapchat",   label: "Snapchat" },
  { y: 440, key: "bosta",      label: "Bosta" },
];

const particles = [
  { p: "fp1", d: "2.6s", b: "0s" },   { p: "fp1", d: "2.6s", b: "1.3s" },
  { p: "fp2", d: "2.8s", b: "0.5s" }, { p: "fp2", d: "2.8s", b: "1.9s" },
  { p: "fp3", d: "2.3s", b: "0.2s" }, { p: "fp3", d: "2.3s", b: "1.4s" },
  { p: "fp4", d: "2.5s", b: "0.9s" }, { p: "fp4", d: "2.5s", b: "2.0s" },
  { p: "fp5", d: "2.9s", b: "0.4s" }, { p: "fp5", d: "2.9s", b: "1.7s" },
  { p: "fp6", d: "2.4s", b: "1.1s" }, { p: "fp6", d: "2.4s", b: "2.2s" },
  { p: "fpv", d: "1.5s", b: "0s" },   { p: "fpv", d: "1.5s", b: "0.7s" },
  { p: "fpc", d: "1.3s", b: "0.3s" }, { p: "fpc", d: "1.3s", b: "0.9s" },
];

const paths = [
  { id: "fp1", d: "M184,40  C 300,40  330,240 452,240" },
  { id: "fp2", d: "M184,120 C 300,120 330,240 452,240" },
  { id: "fp3", d: "M184,200 C 320,200 360,240 452,240" },
  { id: "fp4", d: "M184,280 C 320,280 360,240 452,240" },
  { id: "fp5", d: "M184,360 C 300,360 330,240 452,240" },
  { id: "fp6", d: "M184,440 C 300,440 330,240 452,240" },
  { id: "fpv", d: "M570,240 L700,240" },
  { id: "fpc", d: "M852,240 L940,240" },
];

const bars = [
  { x: 722, c: "#c4b5fd", h: 0.55, d: "0s" },
  { x: 752, c: "#8b6ff0", h: 0.8,  d: ".2s" },
  { x: 782, c: "#6549dd", h: 0.45, d: ".4s" },
  { x: 812, c: "#a78bfa", h: 0.95, d: ".6s" },
];

const HUB_MARK = `<path d="M-18,-14 C-18,3 0,0 0,20 M0,-20 V20 M18,-14 C18,3 0,0 0,20" fill="none" stroke="#6549dd" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" /><circle cx="-18" cy="-16" r="6" fill="#67E8F9" /><circle cx="0" cy="-20" r="6" fill="#C4B5FD" /><circle cx="18" cy="-16" r="6" fill="#FDE68A" /><circle cx="0" cy="20" r="6" fill="#6549dd" />`;

// ── Scroll timeline ──
// Each window is [start, length] in scroll progress, 0 to 1. `win` turns one
// into the --a/--b pair the CSS reads. Desktop draws left to right; the phone
// diagram is vertical and has its own windows.
type Win = [number, number];
const win = ([a, b]: Win) => `--a:${a};--b:${b}`;
const lineIndex = (id: string) => paths.findIndex((f) => f.id === id);
const DESK = {
  card: [0, 0.16] as Win,
  src: (i: number): Win => [0.04 + i * 0.035, 0.12],
  more: [0.25, 0.08] as Win,
  line: (id: string): Win =>
    id === "fpv" ? [0.46, 0.08] : id === "fpc" ? [0.64, 0.08] : [0.1 + lineIndex(id) * 0.035, 0.16],
  hub: [0.3, 0.14] as Win,
};
// Dashes and particles follow once their line has finished drawing.
const after = ([a, b]: Win, len = 0.06): Win => [a + b, len];
const MOB = {
  card: [0, 0.1] as Win,
  src: (i: number): Win => [0.02 + i * 0.05, 0.14],
  line1: [0.3, 0.1] as Win,
  line2: [0.5, 0.08] as Win,
  line3: [0.7, 0.08] as Win,
};

const FONT = "Archivo Variable, Zain, ui-sans-serif, system-ui, sans-serif";
---

<section id={sectionId} class={sectionClass} data-sf={scroll ? "" : undefined}>
  <div class={scroll ? "sf-track" : undefined}>
    <div class={scroll ? "sf-stick relative overflow-hidden px-6 py-20" : undefined}>
      {scroll ? (
        <div class="sf-bg" aria-hidden="true">
          <div class="sf-grid"></div>
          <div class="sf-glow sf-glow-a"></div>
          <div class="sf-glow sf-glow-b"></div>
          <div class="sf-glow sf-glow-c"></div>
          <span class="sf-streak" style="top:16%;width:26%;animation-duration:7s;animation-delay:-2s"></span>
          <span class="sf-streak" style="top:38%;width:34%;animation-duration:9s;animation-delay:-6s"></span>
          <span class="sf-streak" style="top:61%;width:22%;animation-duration:6.5s;animation-delay:-4s"></span>
          <span class="sf-streak" style="top:84%;width:30%;animation-duration:10s;animation-delay:-1s"></span>
        </div>
      ) : (
        <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_60%_50%_at_50%_0%,#efeafc,transparent)]"></div>
      )}

      <div class="relative mx-auto w-full max-w-6xl">
        <div class="reveal mx-auto max-w-2xl text-center">
          {eyebrow && (
            <p class={`mb-3 text-sm font-semibold uppercase tracking-widest ${scroll ? "text-brand-300" : "text-brand-600"}`}>{eyebrow}</p>
          )}
          <h2 class={`font-display text-3xl font-bold tracking-tight sm:text-4xl ${scroll ? "text-white" : "text-zinc-950"}`}>
            {heading}
          </h2>
          {body && <p class={`mt-4 text-lg ${scroll ? "text-zinc-400" : "text-zinc-500"}`}>{body}</p>}
        </div>

        <div class={scroll ? `relative ${body ? "mt-12" : "mt-10"}` : undefined}>
          {scroll && <div class="sf-halo" data-k style={win(DESK.hub)} aria-hidden="true"></div>}

          <!-- Horizontal diagram. The static version scrolls sideways on very
               small screens; the scroll version is desktop only, and phones
               get the vertical diagram below. A heading on its own sits closer
               to the diagram than heading + body. -->
          <div
            class={scroll
              ? "sf-card relative hidden sf-dark rounded-3xl p-6 ring-1 ring-white/10 lg:block xl:p-8"
              : `reveal ${body ? "mt-14" : "mt-10"} overflow-x-auto rounded-3xl border border-zinc-100 bg-white p-5 shadow-sm sm:p-8`}
            data-sf-card={scroll ? "" : undefined}
            data-k={scroll ? "" : undefined}
            style={scroll ? win(DESK.card) : undefined}
          >
            <svg class={scroll ? "flow-svg sf-svg mx-auto block h-auto w-full max-w-[1100px]" : "flow-svg mx-auto block min-w-[860px] max-w-[1100px]"} viewBox="0 0 1120 500" role="img" aria-label={alt}>
              <defs>
                <radialGradient id={ID.particle} cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#8b6ff0" />
                  <stop offset="100%" stop-color="#6549dd" />
                </radialGradient>
                <filter id={ID.glow} x="-50%" y="-50%" width="200%" height="200%">
                  <feGaussianBlur stdDeviation="2.5" result="b" />
                  <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
                </filter>

                <!-- Convergence paths into the AdFunnl hub, then hub → Visualize → recipient -->
                {paths.map((f) => <path id={ID.p(f.id)} d={f.d} fill="none" />)}
              </defs>

              <!-- Scroll version: each line draws itself before its dashes start moving -->
              {scroll && paths.map((f) => (
                <path d={f.d} pathLength="1" class="sf-draw" data-k style={win(DESK.line(f.id))} />
              ))}

              <!-- animated stream lines (marching dashes) -->
              {paths.map((f) => (
                <use href={`#${ID.p(f.id)}`} class="flow-stream" data-k style={win(after(DESK.line(f.id)))} />
              ))}

              <!-- flowing particles -->
              {particles.map((c) => (
                <g class="sf-fade" data-k style={win(after(DESK.line(c.p), 0.05))}>
                  <circle r="4.5" fill={`url(#${ID.particle})`} filter={`url(#${ID.glow})`}>
                    <animateMotion dur={c.d} begin={c.b} repeatCount="indefinite" rotate="auto">
                      <mpath href={`#${ID.p(c.p)}`} />
                    </animateMotion>
                  </circle>
                </g>
              ))}

              <!-- ── Source nodes (real platform logos) ── -->
              {sources.map((s, i) => (
                <g class="sf-pop" data-k style={`${win(DESK.src(i))};--dx:-36px`}>
                  <rect class="sf-node" x="24" y={s.y - 23} width="160" height="46" rx="12" fill="#fff" stroke="#e4e4e7" />
                  <g transform={`translate(40 ${s.y - 13})`} set:html={FLOW_LOGOS[s.key]} />
                  <text class="sf-t1" x="78" y={s.y + 5} font-family={FONT} font-size="15" font-weight="600" fill="#3f3f46">{s.label}</text>
                </g>
              ))}
              <text class="sf-fade sf-t2" data-k style={win(DESK.more)} x="104" y="486" text-anchor="middle" font-family={FONT} font-size="12" font-weight="600" letter-spacing="1" fill="#a1a1aa">+ MORE SOURCES</text>

              <!-- ── AdFunnl hub ── -->
              <g>
                <circle class="flow-hub-ring" cx="510" cy="240" r="58" fill="none" stroke="#6549dd" stroke-width="2" />
                <circle class="sf-node" cx="510" cy="240" r="52" fill="#fff" stroke="#e4e4e7" stroke-width="1.5" />
                <g class="sf-hubmark" transform="translate(510 240)" set:html={HUB_MARK} />
                <text class="sf-t1" x="510" y="322" text-anchor="middle" font-family={FONT} font-size="15" font-weight="700" fill="#27272a">AdFunnl</text>
                <text class="sf-t2" x="510" y="340" text-anchor="middle" font-family={FONT} font-size="11.5" font-weight="500" fill="#a1a1aa">Unify · normalize · blend</text>
              </g>

              <!-- ── Visualize node ── -->
              <g>
                <rect class="sf-node" x="700" y="176" width="152" height="128" rx="16" fill="#fff" stroke="#e4e4e7" stroke-width="1.5" />
                <text class="sf-accent" x="776" y="199" text-anchor="middle" font-family={FONT} font-size="11" font-weight="700" letter-spacing="0.5" fill="#6549dd">LIVE DASHBOARD</text>
                <g>
                  {bars.map((b) => (
                    <rect class="flow-bar" x={b.x} y="220" width="20" height="66" rx="4" fill={b.c} style={`--h:${b.h};--d:${b.d}`} />
                  ))}
                </g>
                <line class="sf-rule" x1="716" y1="286" x2="836" y2="286" stroke="#e4e4e7" stroke-width="1.5" />
                <text class="sf-t1" x="776" y="330" text-anchor="middle" font-family={FONT} font-size="15" font-weight="700" fill="#27272a">Visualized</text>
              </g>

              <!-- ── Recipient node ── -->
              <g>
                <rect x="940" y="176" width="152" height="128" rx="16" fill="#6549dd" />
                <rect x="972" y="200" width="88" height="60" rx="6" fill="#fff" opacity="0.95" />
                <rect x="982" y="211" width="52" height="6" rx="3" fill="#c4b5fd" />
                <rect x="982" y="223" width="68" height="5" rx="2.5" fill="#e4e4e7" />
                <rect x="982" y="233" width="60" height="5" rx="2.5" fill="#e4e4e7" />
                <rect x="982" y="243" width="44" height="5" rx="2.5" fill="#e4e4e7" />
                <g>
                  <circle class="flow-check" cx="1054" cy="254" r="13" fill="#22c55e" stroke="#fff" stroke-width="2.5" />
                  <path class="flow-check" d="M1048,254 l4,4 l7,-8" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </g>
                <text class="sf-t1" x="1016" y="330" text-anchor="middle" font-family={FONT} font-size="15" font-weight="700" fill="#27272a">{outLabel}</text>
                <text class="sf-t2" x="1016" y="348" text-anchor="middle" font-family={FONT} font-size="11.5" font-weight="500" fill="#a1a1aa">{outSub}</text>
              </g>
            </svg>
          </div>

          {scroll && (
            <!-- Phones and tablets: the same pipeline, top to bottom. -->
            <div class="sf-card relative mx-auto max-w-md sf-dark rounded-3xl p-5 ring-1 ring-white/10 sm:max-w-xl sm:p-7 lg:hidden" data-sf-card data-k style={win(MOB.card)} role="img" aria-label={alt}>
              <div class="grid grid-cols-2 gap-2 sm:grid-cols-3" aria-hidden="true">
                {sources.map((s, i) => (
                  <div class="sf-pop flex min-w-0 items-center gap-2 rounded-xl border border-white/10 bg-white/[.04] px-2.5 py-2.5 sm:gap-2.5 sm:px-3" data-k style={`${win(MOB.src(i))};--dy:14px`}>
                    <span class="flex h-[26px] w-[26px] shrink-0" set:html={FLOW_LOGOS[s.key]} />
                    <span class="truncate text-[13px] font-semibold text-zinc-100 sm:text-sm">{s.label}</span>
                  </div>
                ))}
              </div>
              <p class="sf-fade mt-2.5 text-center text-[11px] font-semibold tracking-wider text-zinc-500" data-k style={win(MOB.src(6))} aria-hidden="true">+ MORE SOURCES</p>

              <div class="sf-vconn" data-k style={win(MOB.line1)} aria-hidden="true"><span class="sf-vline"></span><span class="sf-vdot"></span></div>

              <div class="flex flex-col items-center" aria-hidden="true">
                <div class="relative grid h-[84px] w-[84px] place-items-center rounded-full border border-white/10 bg-[#1b1740]">
                  <span class="flow-hub-ring absolute -inset-1.5 rounded-full border-2 border-brand-500"></span>
                  <svg class="sf-hubmark h-11 w-11" viewBox="-26 -26 52 52" set:html={HUB_MARK} />
                </div>
                <p class="mt-3 text-sm font-bold text-white">AdFunnl</p>
                <p class="text-xs font-medium text-zinc-400">Unify · normalize · blend</p>
              </div>

              <div class="sf-vconn" data-k style={win(MOB.line2)} aria-hidden="true"><span class="sf-vline"></span><span class="sf-vdot"></span></div>

              <div class="mx-auto flex max-w-[220px] flex-col items-center" aria-hidden="true">
                <div class="w-full rounded-2xl border border-white/10 bg-[#1b1740] p-3">
                  <p class="text-center text-[10px] font-bold tracking-wide text-brand-300">LIVE DASHBOARD</p>
                  <div class="mt-2 flex h-14 items-end gap-2 border-b border-white/10 px-2">
                    {bars.map((b) => (
                      <span class="flow-bar h-full flex-1 rounded-t" style={`background:${b.c};--h:${b.h};--d:${b.d}`}></span>
                    ))}
                  </div>
                </div>
                <p class="mt-2 text-sm font-bold text-white">Visualized</p>
              </div>

              <div class="sf-vconn" data-k style={win(MOB.line3)} aria-hidden="true"><span class="sf-vline"></span><span class="sf-vdot"></span></div>

              <div class="mx-auto flex max-w-[220px] flex-col items-center text-center" aria-hidden="true">
                <div class="relative w-full rounded-2xl bg-[#6549dd] p-4">
                  <div class="mx-auto w-3/4 rounded-md bg-white/95 p-2.5">
                    <span class="block h-1.5 w-3/5 rounded-full bg-[#c4b5fd]"></span>
                    <span class="mt-1.5 block h-1 w-4/5 rounded-full bg-zinc-200"></span>
                    <span class="mt-1.5 block h-1 w-2/3 rounded-full bg-zinc-200"></span>
                    <span class="mt-1.5 block h-1 w-1/2 rounded-full bg-zinc-200"></span>
                  </div>
                  <span class="absolute bottom-3 right-5 grid h-7 w-7 place-items-center rounded-full border-2 border-white bg-[#22c55e]">
                    <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5l3 3 6-7" /></svg>
                  </span>
                </div>
                <p class="mt-2 text-sm font-bold text-white">{outLabel}</p>
                <p class="text-xs font-medium text-zinc-400">{outSub}</p>
              </div>
            </div>
          )}

          {scroll && <div class="sf-rail" aria-hidden="true"><span></span></div>}
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* ── Animated data-flow diagram ── */
  .flow-stream { fill: none; stroke: #e0d9f9; stroke-width: 2; stroke-dasharray: 5 9; stroke-linecap: round; animation: flowDash 1.1s linear infinite; }
  @keyframes flowDash { to { stroke-dashoffset: -14; } }
  .flow-hub-ring { transform-box: fill-box; transform-origin: center; animation: flowHub 2.6s ease-in-out infinite; }
  @keyframes flowHub { 0%,100% { opacity: .55; transform: scale(1); } 50% { opacity: 1; transform: scale(1.08); } }
  .flow-bar { transform-box: fill-box; transform-origin: bottom; animation: flowBar 2.4s cubic-bezier(.4,0,.2,1) infinite; animation-delay: var(--d, 0s); }
  @keyframes flowBar { 0%,100% { transform: scaleY(calc(var(--h) * .55)); } 50% { transform: scaleY(var(--h)); } }
  .flow-check { animation: flowCheck 2.8s ease-in-out infinite; }
  @keyframes flowCheck { 0%,70%,100% { opacity: 1; } 80% { opacity: .3; } }

  /* ── Scroll version ──
     --p is scroll progress. Every [data-k] piece turns it into its own local
     progress --k over its window, and --e is that eased. Children without
     their own window inherit the parent's --e. */
  .sf { --p: 1; }
  .sf [data-k] {
    --k: clamp(0, (var(--p) - var(--a)) / var(--b), 1);
    --e: calc(var(--k) * var(--k) * (3 - 2 * var(--k)));
  }
  .sf .sf-fade, .sf .flow-stream { opacity: var(--e); }
  .sf .sf-pop {
    opacity: var(--e);
    transform-box: fill-box;
    transform-origin: center;
    transform:
      translate(calc((1 - var(--e)) * var(--dx, 0px)), calc((1 - var(--e)) * var(--dy, 0px)))
      scale(calc(var(--s0, .88) + (1 - var(--s0, .88)) * var(--e)));
  }
  .sf .sf-draw {
    fill: none; stroke: #2e2860; stroke-width: 2;
    stroke-dasharray: 1px 1px;
    stroke-dashoffset: calc((1 - var(--e)) * 1px);
  }
  .sf .sf-card {
    transform-origin: 50% 0;
    transform: perspective(1600px) rotateX(calc((1 - var(--e)) * 14deg)) scale(calc(.94 + .06 * var(--e)));
    box-shadow: 0 40px 120px -30px rgba(101, 73, 221, calc(.25 + .45 * var(--p)));
  }
  .sf .sf-halo {
    position: absolute; inset: -12% -6%; pointer-events: none;
    background: radial-gradient(closest-side, rgba(139, 115, 230, .55), transparent);
    opacity: var(--e);
  }

  /* Phone connectors: a line that grows down, with a packet travelling it. */
  .sf .sf-vconn { position: relative; margin: .75rem auto; height: 2.25rem; width: 2px; }
  .sf .sf-vline { position: absolute; inset: 0; border-radius: 2px; background: #4a3f94; transform-origin: top; transform: scaleY(var(--e)); }
  .sf .sf-vdot { position: absolute; left: -3px; top: 0; height: 8px; width: 8px; border-radius: 9999px; background: #6549dd; box-shadow: 0 0 10px #8b73e6; opacity: var(--e); animation: sfDrop 1.3s linear infinite; }
  @keyframes sfDrop { from { transform: translateY(-4px); } to { transform: translateY(calc(2.25rem - 4px)); } }

  .sf .sf-rail { display: none; }

  /* Dark diagram. The SVG keeps its light colours as attributes for the
     static version on the persona pages; these classes override them. */
  .sf .sf-dark { background: linear-gradient(180deg, #17133a, #0c0a22); }
  .sf .sf-node { fill: #1b1740; stroke: #342e66; }
  .sf .sf-t1 { fill: #f4f4f5; }
  .sf .sf-t2 { fill: #8f8bb0; }
  .sf .sf-accent { fill: #b0a1ef; }
  .sf .sf-rule { stroke: #342e66; }
  .sf .flow-stream { stroke: #7c66e0; }
  .sf .flow-hub-ring { stroke: #8b73e6; }
  .sf .sf-hubmark path { stroke: #a58ff5; }
  .sf .sf-hubmark circle[fill="#6549dd"] { fill: #a58ff5; }
  /* TikTok's black glyph becomes white, as on its own dark-mode mark. */
  .sf path[fill="#010101"] { fill: #fff; }

  /* Background: ink, a grid that slides with scroll, drifting glows (the
     middle one brightens as the pipeline completes) and faint data streaks. */
  .sf-bg { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .sf-grid {
    position: absolute; inset: -80px 0;
    background-image: linear-gradient(rgba(255,255,255,.055) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.055) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 45%, #000 15%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 60% at 50% 45%, #000 15%, transparent 75%);
    transform: translate3d(0, calc(var(--p) * -56px), 0);
  }
  .sf-glow { position: absolute; border-radius: 9999px; will-change: transform; }
  .sf-glow-a {
    width: 64vmax; height: 64vmax; left: -18vmax; top: -24vmax;
    background: radial-gradient(closest-side, rgba(101, 73, 221, .5), transparent);
    transform: translate3d(0, calc(var(--p) * 60px), 0);
    animation: sfDriftA 22s ease-in-out infinite alternate;
  }
  .sf-glow-b {
    width: 54vmax; height: 54vmax; right: -16vmax; bottom: -26vmax;
    background: radial-gradient(closest-side, rgba(103, 232, 249, .16), transparent);
    transform: translate3d(0, calc(var(--p) * -80px), 0);
    animation: sfDriftB 26s ease-in-out infinite alternate;
  }
  .sf-glow-c {
    width: 48vmax; height: 36vmax; left: 50%; top: 55%; margin: -18vmax 0 0 -24vmax;
    background: radial-gradient(closest-side, rgba(139, 115, 230, .32), transparent);
    opacity: calc(.2 + .8 * var(--p));
  }
  @keyframes sfDriftA { to { translate: 14vmax 10vmax; } }
  @keyframes sfDriftB { to { translate: -12vmax -8vmax; } }
  .sf-streak {
    position: absolute; left: -35%; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(176, 161, 239, .55), transparent);
    animation: sfStreak 8s linear infinite;
  }
  @keyframes sfStreak { to { transform: translateX(calc(100vw + 100%)); } }

  /* Pinned on desktops tall enough to hold the whole diagram. */
  @media (min-width: 1024px) and (min-height: 700px) {
    .sf-live .sf-track { height: 260vh; }
    .sf-live .sf-stick {
      position: sticky; top: 0; height: 100vh;
      display: flex; flex-direction: column; justify-content: center;
      padding-top: 5rem; padding-bottom: 2rem;
    }
    .sf-live .sf-svg { max-height: calc(100vh - 17rem); }
    .sf-live .sf-rail {
      display: block; margin: 1.5rem auto 0; height: 3px; width: 12rem; overflow: hidden;
      border-radius: 9999px; background: rgba(255, 255, 255, .1);
    }
    .sf-live .sf-rail span {
      display: block; height: 100%; transform-origin: left; transform: scaleX(var(--p));
      background: linear-gradient(90deg, #8b73e6, #67e8f9);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-stream, .flow-hub-ring, .flow-bar, .flow-check, .sf-glow, .sf-vdot { animation: none !important; }
    .sf-streak { display: none; }
  }
</style>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Reduced motion: freeze the SVG particles (SMIL isn't paused by CSS).
  if (reduced) {
    document.querySelectorAll("svg.flow-svg").forEach((svg) => {
      if (typeof (svg as SVGSVGElement).pauseAnimations === "function") {
        (svg as SVGSVGElement).pauseAnimations();
      }
    });
  }

  // Scroll version: writes --p. Pinned, progress runs from the section
  // reaching mid-screen to the end of the pin. Unpinned (phones, short
  // screens), it runs from the diagram entering the screen to its bottom
  // edge passing two thirds of the way up. The value eases toward the target
  // each frame so the motion stays smooth on jumpy wheels and flicks.
  const PIN = window.matchMedia("(min-width: 1024px) and (min-height: 700px)");
  document.querySelectorAll<HTMLElement>("[data-sf]").forEach((root) => {
    if (reduced) return;
    root.classList.add("sf-live");
    const track = root.querySelector<HTMLElement>(".sf-track")!;
    const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-sf-card]"));
    let target = 0;
    let current = 0;
    let frame = 0;

    const measure = () => {
      const vh = window.innerHeight;
      let p: number;
      if (PIN.matches) {
        const r = track.getBoundingClientRect();
        p = (vh * 0.5 - r.top) / (r.height - vh * 0.5);
      } else {
        const card = cards.find((c) => c.offsetParent !== null) ?? cards[0];
        const r = card.getBoundingClientRect();
        p = (vh * 0.92 - r.top) / (r.height + vh * 0.26);
      }
      target = Math.min(1, Math.max(0, p));
    };
    const write = (v: number) => root.style.setProperty("--p", v.toFixed(4));
    const tick = () => {
      current += (target - current) * 0.16;
      if (Math.abs(target - current) < 0.001) current = target;
      write(current);
      frame = current === target ? 0 : requestAnimationFrame(tick);
    };
    const onScroll = () => {
      measure();
      if (!frame) frame = requestAnimationFrame(tick);
    };

    measure();
    current = target;
    write(current);
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
  });
</script>
