---
// Markup for /features and /ar/features. All copy lives in each page's
// frontmatter and arrives here as `copy`, so the two pages stay one screen of
// strings each and share one layout.
//
// Look: deliberately plain. The page promises a list with no extra design, so
// it is a list: a heading per group on the left, one line per feature on the
// right, and small chips naming the platforms or plans a line is limited to.
// It borrows the integrations page's grammar and nothing else.

const APP_URL = "https://app.adfunnl.com";

export interface Feature {
  name: string;
  body: string;
  /** Limits, e.g. "Meta · Snapchat" or "Solo and up". Omit when it has none. */
  chips?: string[];
  /** A page on this site that covers the feature in full. */
  href?: string;
}
export interface Group {
  id: string;
  heading: string;
  intro?: string;
  rows: Feature[];
  /** Not open yet: drawn greyed and tagged with `copy.soon`. */
  soon?: boolean;
}
export interface Copy {
  hero: { heading: string; body: string; cta: string; jump: string };
  groups: Group[];
  soon: string;
  more: string;
  closing: { heading: string; body: string; cta: string };
}

interface Props {
  copy: Copy;
  locale?: "en" | "ar";
}
const { copy, locale = "en" } = Astro.props;
const ar = locale === "ar";
const L = (href: string) => (ar ? `/ar${href}` : href);
---

<!-- ================================ HERO ================================ -->
<section class="bg-white px-6 pt-16 pb-10 sm:pt-20">
  <div class="mx-auto max-w-5xl">
    <h1 class="max-w-3xl font-display text-4xl font-bold tracking-tight text-zinc-950 sm:text-5xl">{copy.hero.heading}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-zinc-500">{copy.hero.body}</p>
    <a href={`${APP_URL}/signup`}
       class="mt-8 inline-block w-full rounded-xl bg-brand-600 px-7 py-3.5 text-center text-base font-semibold text-white shadow-lg shadow-brand-200 transition hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 sm:w-auto">
      {copy.hero.cta}
    </a>

    <!-- Contents: every group, one tap away -->
    <nav aria-label={copy.hero.jump} class="mt-12">
      <p class="text-xs font-semibold text-zinc-500">{copy.hero.jump}</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {copy.groups.map((g) => (
          <li>
            <a href={`#${g.id}`}
               class:list={[
                 "inline-block rounded-lg border px-3 py-1.5 text-sm transition hover:border-brand-300 hover:text-brand-700",
                 g.soon ? "border-dashed border-zinc-300 text-zinc-400" : "border-zinc-200 text-zinc-600",
               ]}>{g.heading}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</section>

<!-- =============================== GROUPS =============================== -->
<div class="bg-white px-6 pb-8">
  {copy.groups.map((g) => (
    <section id={g.id} class="mx-auto grid max-w-5xl scroll-mt-24 gap-6 border-t border-zinc-200 py-12 md:grid-cols-[14rem_1fr] md:gap-12">
      <div>
        <h2 class:list={["font-display text-2xl font-bold tracking-tight", g.soon ? "text-zinc-400" : "text-zinc-950"]}>{g.heading}</h2>
        {g.intro && <p class="mt-2 text-sm leading-relaxed text-zinc-500">{g.intro}</p>}
      </div>
      <ul class="divide-y divide-zinc-100">
        {g.rows.map((r) => (
          <li class="py-4 first:pt-0 sm:flex sm:items-start sm:gap-6">
            <div class="min-w-0 flex-1">
              <p class:list={["font-semibold", g.soon ? "text-zinc-500" : "text-zinc-900"]}>{r.name}</p>
              <p class:list={["mt-1 text-sm leading-relaxed", g.soon ? "text-zinc-400" : "text-zinc-500"]}>
                {r.body}
                {r.href && (
                  <>
                    {" "}<a href={L(r.href)} class="font-semibold text-brand-700 underline-offset-4 hover:underline focus-visible:underline">{copy.more}</a>
                  </>
                )}
              </p>
            </div>
            {(g.soon || r.chips?.length) && (
              <p class="mt-2 flex shrink-0 flex-wrap gap-1.5 sm:mt-0.5 sm:max-w-[13rem] sm:justify-end">
                {(g.soon ? [copy.soon] : r.chips ?? []).map((c) => (
                  <span class:list={[
                    "rounded-md px-2 py-0.5 text-xs font-medium",
                    g.soon ? "bg-zinc-100 text-zinc-400" : "bg-brand-50 text-brand-700",
                  ]}>{c}</span>
                ))}
              </p>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<!-- ================================ CTA ================================ -->
<section class="px-6 py-24">
  <div class="mx-auto max-w-5xl rounded-3xl bg-ink px-6 py-16 text-center sm:py-20">
    <div class="mx-auto max-w-2xl">
      <h2 class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">{copy.closing.heading}</h2>
      <p class="mt-4 text-lg text-zinc-400">{copy.closing.body}</p>
      <a href={`${APP_URL}/signup`}
         class="mt-9 inline-block w-full rounded-xl bg-brand-600 px-8 py-3.5 text-center text-base font-semibold text-white transition hover:bg-brand-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:w-auto">
        {copy.closing.cta}
      </a>
    </div>
  </div>
</section>
