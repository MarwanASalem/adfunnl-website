---
import { existsSync } from "node:fs";
import { join } from "node:path";
import PlatformIcon from "./PlatformIcon.astro";

// Markup for one ad platform's page, /integrations/<platform> and its Arabic
// twin. All copy lives in each page's frontmatter and arrives as `copy`.
//
// Screenshots are real app screens from the demo workspace (voice.md R3).
// A shot whose file is not in public/ yet is skipped at build time, so a page
// can ship before its screenshots and pick them up when they land.

const APP_URL = "https://app.adfunnl.com";

export interface Shot {
  /** Path under public/, e.g. "/screens/ads-manager.png". */
  src: string;
  alt: string;
}
export interface Section {
  heading: string;
  body: string;
  points?: string[];
  /** Small status after the heading, e.g. "Live" or "Beta". */
  tag?: string;
  shot?: Shot;
  link?: { label: string; href: string };
}
export interface Copy {
  platform: string;
  hero: { heading: string; body: string; cta: string; shot?: Shot };
  pain: { heading: string; body: string };
  comesIn: { heading: string; items: string[] };
  sections: Section[];
  compare: { heading: string; cols: [string, string, string]; rows: [string, string, string][] };
  faq: { heading: string; items: { q: string; a: string }[] };
  others: { heading: string; links: { label: string; href: string; icon?: string }[] };
  closing: { heading: string; body: string; cta: string };
}

interface Props {
  copy: Copy;
  locale?: "en" | "ar";
}
const { copy, locale = "en" } = Astro.props;
const ar = locale === "ar";
const L = (href: string) => (ar ? `/ar${href}` : href);
const has = (s?: Shot) => !!s && existsSync(join(process.cwd(), "public", s.src));
const heroShot = has(copy.hero.shot) ? copy.hero.shot : undefined;
---

<!-- ================================ HERO ================================ -->
<section class="relative overflow-hidden bg-white px-6 pt-16 pb-14 sm:pt-20">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_70%_55%_at_50%_-15%,#e6e1fb,transparent)]"></div>
  <div class="mx-auto max-w-5xl">
    <span class="flex h-14 w-14 items-center justify-center rounded-2xl border border-zinc-200 bg-white shadow-sm">
      <PlatformIcon platform={copy.platform} class="h-8 w-8" />
    </span>
    <h1 class="mt-6 max-w-3xl font-display text-4xl font-bold tracking-tight text-zinc-950 sm:text-5xl">{copy.hero.heading}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-zinc-500">{copy.hero.body}</p>
    <a href={`${APP_URL}/signup`}
       class="mt-8 inline-block w-full rounded-xl bg-brand-600 px-7 py-3.5 text-center text-base font-semibold text-white shadow-lg shadow-brand-200 transition hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 sm:w-auto">
      {copy.hero.cta}
    </a>
    {heroShot && (
      <img src={heroShot.src} alt={heroShot.alt} loading="eager" decoding="async"
           class="mt-14 w-full rounded-2xl border border-zinc-200 bg-white shadow-[0_18px_34px_-20px_rgba(43,29,97,.28)]" />
    )}
  </div>
</section>

<!-- ======================= PAIN + WHAT COMES IN ======================== -->
<section class="bg-zinc-50/70 px-6 py-16 sm:py-20">
  <div class="mx-auto grid max-w-5xl gap-12 md:grid-cols-2">
    <div>
      <h2 class="font-display text-3xl font-bold tracking-tight text-zinc-950">{copy.pain.heading}</h2>
      <p class="mt-4 text-base leading-relaxed text-zinc-600">{copy.pain.body}</p>
    </div>
    <div class="rounded-3xl border border-white bg-[linear-gradient(165deg,#ffffff,#f7f5fe_55%,#eae5fc)] p-7 shadow-[0_18px_34px_-20px_rgba(43,29,97,.28)] ring-1 ring-[rgba(87,56,201,.06)]">
      <h2 class="text-lg font-bold tracking-tight text-[#1e1b4b]">{copy.comesIn.heading}</h2>
      <ul class="mt-4 space-y-2.5">
        {copy.comesIn.items.map((i) => (
          <li class="flex gap-2.5 text-sm leading-relaxed text-zinc-600">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-600" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 10.5l3 3 7-7"/></svg>
            {i}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- ============================= SECTIONS ============================== -->
<div class="bg-white px-6">
  {copy.sections.map((s) => {
    const shot = has(s.shot) ? s.shot : undefined;
    return (
      <section class:list={["mx-auto max-w-5xl border-t border-zinc-100 py-16 first:border-t-0", shot && "grid items-center gap-10 lg:grid-cols-[1fr_1.15fr]"]}>
        <div class="max-w-2xl">
          <h2 class="flex flex-wrap items-center gap-3 font-display text-3xl font-bold tracking-tight text-zinc-950">
            {s.heading}
            {s.tag && <span class="rounded-md bg-brand-50 px-2 py-0.5 font-sans text-xs font-bold text-brand-700">{s.tag}</span>}
          </h2>
          <p class="mt-4 text-base leading-relaxed text-zinc-600">{s.body}</p>
          {s.points && (
            <ul class="mt-5 space-y-2">
              {s.points.map((p) => (
                <li class="flex gap-2.5 text-sm leading-relaxed text-zinc-600">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500" aria-hidden="true"></span>
                  {p}
                </li>
              ))}
            </ul>
          )}
          {s.link && (
            <a href={L(s.link.href)} class="mt-5 inline-block text-sm font-semibold text-brand-700 underline-offset-4 hover:underline focus-visible:underline">{s.link.label}</a>
          )}
        </div>
        {shot && (
          <img src={shot.src} alt={shot.alt} loading="lazy" decoding="async"
               class="w-full rounded-2xl border border-zinc-200 bg-white shadow-[0_18px_34px_-20px_rgba(43,29,97,.28)]" />
        )}
      </section>
    );
  })}
</div>

<!-- ============================== COMPARE ============================== -->
<section class="bg-zinc-50/70 px-6 py-16 sm:py-20">
  <div class="mx-auto max-w-5xl">
    <h2 class="font-display text-3xl font-bold tracking-tight text-zinc-950">{copy.compare.heading}</h2>
    <div class="mt-8 overflow-x-auto rounded-2xl border border-zinc-200 bg-white">
      <table class="w-full min-w-[36rem] text-start text-sm">
        <thead>
          <tr class="border-b border-zinc-200 bg-zinc-50 text-zinc-500">
            {copy.compare.cols.map((c, i) => (
              <th scope="col" class:list={["px-5 py-3 text-start font-semibold", i === 2 && "text-brand-700"]}>{c}</th>
            ))}
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-100">
          {copy.compare.rows.map(([job, them, us]) => (
            <tr>
              <th scope="row" class="px-5 py-4 text-start font-semibold text-zinc-900">{job}</th>
              <td class="px-5 py-4 text-zinc-500">{them}</td>
              <td class="px-5 py-4 text-zinc-800">{us}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- ================================ FAQ ================================ -->
<section class="bg-white px-6 py-16 sm:py-20">
  <div class="mx-auto max-w-3xl">
    <h2 class="font-display text-3xl font-bold tracking-tight text-zinc-950">{copy.faq.heading}</h2>
    <div class="mt-8 divide-y divide-zinc-100 border-y border-zinc-100">
      {copy.faq.items.map((f) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-semibold text-zinc-900 [&::-webkit-details-marker]:hidden">
            {f.q}
            <svg class="mt-1 h-4 w-4 shrink-0 text-zinc-400 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8l4 4 4-4"/></svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-zinc-600">{f.a}</p>
        </details>
      ))}
    </div>

    <p class="mt-12 text-sm font-semibold text-zinc-500">{copy.others.heading}</p>
    <ul class="mt-3 flex flex-wrap gap-2.5">
      {copy.others.links.map((o) => (
        <li>
          <a href={L(o.href)} class="flex items-center gap-2 rounded-xl border border-zinc-200 px-3.5 py-2 text-sm font-medium text-zinc-700 transition hover:border-brand-300 hover:text-brand-700">
            {o.icon && <PlatformIcon platform={o.icon} class="h-4 w-4" />}
            {o.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ================================ CTA ================================ -->
<section class="px-6 pb-24">
  <div class="mx-auto max-w-5xl rounded-3xl bg-ink px-6 py-16 text-center sm:py-20">
    <div class="mx-auto max-w-2xl">
      <h2 class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">{copy.closing.heading}</h2>
      <p class="mt-4 text-lg text-zinc-400">{copy.closing.body}</p>
      <a href={`${APP_URL}/signup`}
         class="mt-9 inline-block w-full rounded-xl bg-brand-600 px-8 py-3.5 text-center text-base font-semibold text-white transition hover:bg-brand-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:w-auto">
        {copy.closing.cta}
      </a>
    </div>
  </div>
</section>
