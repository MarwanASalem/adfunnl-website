---
import PlatformIcon from "./PlatformIcon.astro";

// Markup for /integrations and /ar/integrations. All copy lives in each
// page's frontmatter and arrives here as `copy`, so the two pages stay one
// screen of strings each and share one layout.
//
// Look: the app's own Connections page. Sources that work today are drawn in
// colour, sources that are coming are drawn the way the app draws its
// "Coming soon" tiles, greyed out. Nothing else on the page is decorated.

const APP_URL = "https://app.adfunnl.com";

export interface Row {
  /** A PlatformIcon key, or one of the glyph keys below. */
  icon: string;
  name: string;
  body: string;
  /** Small pill after the name, e.g. Beta. */
  pill?: string;
  /** Right-hand status, e.g. "AI ad control · Live". */
  tag?: string;
}
export interface Group {
  /** Direction of the data: into AdFunnl or out of it. */
  direction: string;
  heading: string;
  intro: string;
  rows: Row[];
  link?: { label: string; href: string };
  /** Draw the icons greyed, for sources that are not open yet. */
  pending?: boolean;
}
export interface Copy {
  hero: { heading: string; body: string; cta: string; today: string; next: string };
  groups: Group[];
  sync: { heading: string; items: { term: string; detail: string }[] };
  closing: { heading: string; body: string; cta: string };
}

interface Props {
  copy: Copy;
  locale?: "en" | "ar";
}
const { copy, locale = "en" } = Astro.props;
const ar = locale === "ar";

// Destinations that are not ad platforms or stores get a plain line glyph,
// never a third party's logo.
const GLYPHS: Record<string, string> = {
  assistant: `<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/><path d="M9 11h.01M12 11h.01M15 11h.01"/>`,
  looker: `<path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/>`,
  share: `<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>`,
};

const today = copy.groups.filter((g) => !g.pending).flatMap((g) => g.rows).filter((r) => !GLYPHS[r.icon]);
const next = copy.groups.filter((g) => g.pending).flatMap((g) => g.rows);
const tagFont = ar ? "" : "font-mono";
---

<!-- ================================ HERO ================================ -->
<section class="bg-white px-6 pt-16 pb-14 sm:pt-20">
  <div class="mx-auto max-w-5xl">
    <h1 class="max-w-3xl font-display text-4xl font-bold tracking-tight text-zinc-950 sm:text-5xl">{copy.hero.heading}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-zinc-500">{copy.hero.body}</p>
    <a href={`${APP_URL}/signup`}
       class="mt-8 inline-block w-full rounded-xl bg-brand-600 px-7 py-3.5 text-center text-base font-semibold text-white shadow-lg shadow-brand-200 transition hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 sm:w-auto">
      {copy.hero.cta}
    </a>

    <!-- Every source at a glance: today in colour, next greyed, as in the app -->
    <div class="mt-14 flex flex-wrap items-start gap-x-10 gap-y-8">
      <figure>
        <ul class="flex flex-wrap gap-2.5">
          {today.map((r) => (
            <li class="flex h-12 w-12 items-center justify-center rounded-xl border border-zinc-200 bg-white" title={r.name}>
              <PlatformIcon platform={r.icon} class="h-7 w-7" />
              <span class="sr-only">{r.name}</span>
            </li>
          ))}
        </ul>
        <figcaption class="mt-3 text-xs font-semibold text-zinc-500">{copy.hero.today}</figcaption>
      </figure>
      <figure class="border-zinc-200 sm:border-s sm:ps-10">
        <ul class="flex flex-wrap gap-2.5">
          {next.map((r) => (
            <li class="flex h-12 w-12 items-center justify-center rounded-xl border border-dashed border-zinc-300 bg-zinc-50" title={r.name}>
              <PlatformIcon platform={r.icon} class="h-7 w-7 opacity-50 grayscale" />
              <span class="sr-only">{r.name}</span>
            </li>
          ))}
        </ul>
        <figcaption class="mt-3 text-xs font-semibold text-zinc-400">{copy.hero.next}</figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- =============================== GROUPS =============================== -->
<div class="bg-white px-6 pb-8">
  {copy.groups.map((g) => (
    <section class="mx-auto grid max-w-5xl gap-6 border-t border-zinc-200 py-12 md:grid-cols-[14rem_1fr] md:gap-12">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-brand-700">{g.direction}</p>
        <h2 class="mt-2 font-display text-2xl font-bold tracking-tight text-zinc-950">{g.heading}</h2>
        <p class="mt-2 text-sm leading-relaxed text-zinc-500">{g.intro}</p>
      </div>
      <div>
        <ul class="divide-y divide-zinc-100">
          {g.rows.map((r) => (
            <li class="flex gap-4 py-5 first:pt-0 sm:items-start">
              <span class:list={[
                "flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border",
                g.pending ? "border-dashed border-zinc-300 bg-zinc-50" : "border-zinc-200 bg-white",
              ]}>
                {GLYPHS[r.icon]
                  ? <svg viewBox="0 0 24 24" class="h-5 w-5 text-brand-600" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={GLYPHS[r.icon]} />
                  : <PlatformIcon platform={r.icon} class={g.pending ? "h-6 w-6 opacity-50 grayscale" : "h-6 w-6"} />}
              </span>
              <div class="min-w-0 flex-1 sm:flex sm:gap-6">
                <div class="min-w-0 flex-1">
                  <p class="flex flex-wrap items-center gap-2 font-semibold text-zinc-900">
                    {r.name}
                    {r.pill && <span class="rounded bg-brand-50 px-1.5 py-px text-[11px] font-bold text-brand-700">{r.pill}</span>}
                  </p>
                  <p class="mt-1 text-sm leading-relaxed text-zinc-500">{r.body}</p>
                </div>
                {r.tag && (
                  <p class:list={[
                    "mt-2 shrink-0 text-xs text-zinc-500 sm:mt-1 sm:text-end",
                    tagFont,
                  ]}>{r.tag}</p>
                )}
              </div>
            </li>
          ))}
        </ul>
        {g.link && (
          <a href={g.link.href} class="mt-2 inline-block text-sm font-semibold text-brand-700 underline-offset-4 hover:underline focus-visible:underline">{g.link.label}</a>
        )}
      </div>
    </section>
  ))}
</div>

<!-- ================================ SYNC ================================ -->
<section class="bg-zinc-50 px-6 py-20">
  <div class="mx-auto max-w-5xl">
    <h2 class="font-display text-3xl font-bold tracking-tight text-zinc-950">{copy.sync.heading}</h2>
    <dl class="mt-10 grid gap-x-12 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {copy.sync.items.map((s) => (
        <div class="border-t border-zinc-300 pt-4">
          <dt class="text-sm font-semibold text-zinc-900">{s.term}</dt>
          <dd class="mt-1.5 text-sm leading-relaxed text-zinc-500">{s.detail}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<!-- ================================ CTA ================================ -->
<section class="px-6 py-24">
  <div class="mx-auto max-w-5xl rounded-3xl bg-ink px-6 py-16 text-center sm:py-20">
    <div class="mx-auto max-w-2xl">
      <h2 class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">{copy.closing.heading}</h2>
      <p class="mt-4 text-lg text-zinc-400">{copy.closing.body}</p>
      <a href={`${APP_URL}/signup`}
         class="mt-9 inline-block w-full rounded-xl bg-brand-600 px-8 py-3.5 text-center text-base font-semibold text-white transition hover:bg-brand-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:w-auto">
        {copy.closing.cta}
      </a>
    </div>
  </div>
</section>
