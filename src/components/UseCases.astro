---
// Five jobs that eat a media buyer's week, and how AdFunnl helps.
//
// One compact row of overlapping cards, fanned slightly. Pointing at (or
// focusing) a card straightens it, lifts it forward, nudges its neighbours
// aside and shows one or two small chips from the app. The lifted card also
// tilts a little toward the pointer, and its object drifts on its own layer.
//
// Under lg the fan becomes a swipeable carousel of straight cards, chips
// always showing, so the section costs one card of height on a phone.
//
// The objects are hand-built SVG in one material, frosted lavender glass: a
// white-to-lavender body, a purple depth wash toward the bottom, a thin rim
// light and one soft specular highlight, over a faint glow. One material and
// one hue across all five is what keeps them quiet next to each other.
//
// Capability notes (docs/what-ships.md): blended ROAS and one reporting
// currency (Connect, Visualize); Best Creatives weights ROAS, cost per purchase
// and outbound CTR (Visualize); Pulse verdicts Scale, Hold, Cut (Visualize);
// live view-only links, PDF and client logo (Share); ad changes from Claude or
// ChatGPT are two-phase and only apply after approval (Ask).

interface Props {
  sectionId?: string;
  locale?: "en" | "ar";
}

const { sectionId, locale = "en" } = Astro.props;

const COPY = {
  en: {
    heading: "Five jobs that eat a media buyer's week, and how AdFunnl helps",
    cards: [
      { title: "Comparing platforms", body: "Meta, TikTok, Snapchat and Google side by side in one reporting currency, with blended ROAS on top.", chips: ["Blended ROAS 3.3×", "One reporting currency"] },
      { title: "Finding the winning ad", body: "Best Creatives ranks ads on ROAS, cost per purchase and outbound CTR, with the creative in the row.", chips: ["Best: IG Post · Leakproof test"] },
      { title: "Deciding what to scale", body: "Pulse checks each account against your rules and flags it Scale, Hold or Cut.", chips: [] },
      { title: "Sending the report", body: "A live, view-only link that is current whenever your client opens it, or a PDF with their logo.", chips: ["Live link · view-only", "PDF with their logo"] },
      { title: "Changing ads", body: "Ask Claude or ChatGPT to pause ads or move budget. You see the plan first, and nothing runs until you approve.", chips: ["Pause 2 ads"] },
    ],
    scale: "Scale", hold: "Hold", cut: "Cut",
    approve: "Approve",
    applied: "Applied",
  },
  ar: {
    heading: "خمس مهام تلتهم أسبوع الـ Media Buyer، وكيف يساعد AdFunnl",
    cards: [
      { title: "مقارنة المنصات", body: "Meta وTikTok وSnapchat وGoogle جنبًا إلى جنب بعملة تقارير واحدة، وفوقها blended ROAS.", chips: ["Blended ROAS ‏3.3×", "عملة تقارير واحدة"] },
      { title: "إيجاد الإعلان الرابح", body: "يرتّب Best Creatives الإعلانات حسب ROAS وتكلفة الشراء وOutbound CTR، والـ Creative أمامك في الصف نفسه.", chips: ["الأفضل: IG Post · Leakproof test"] },
      { title: "تحديد ما يستحق الـ Scale", body: "يفحص Pulse كل حساب وفق قواعدك ويصنّفه Scale أو Hold أو Cut.", chips: [] },
      { title: "إرسال التقرير", body: "رابط مباشر للعرض فقط يبقى محدَّثًا كلما فتحه عميلك، أو ملف PDF بشعاره.", chips: ["رابط مباشر · للعرض فقط", "PDF بشعار العميل"] },
      { title: "تعديل الإعلانات", body: "اطلب من Claude أو ChatGPT إيقاف الإعلانات أو نقل الميزانية. ترى الخطة أولًا، ولا يُنفَّذ شيء قبل موافقتك.", chips: ["إيقاف إعلانين"] },
    ],
    scale: "Scale", hold: "Hold", cut: "Cut",
    approve: "وافق",
    applied: "تم التطبيق",
  },
};
const T = COPY[locale];

// ── Frosted glass objects ──
// Every drawing is 120 x 120 and built from the same four layers per shape:
// the glass body, a purple depth wash, a rim light, then a soft highlight.
// Ids carry the card index so five drawings on one page never share defs.
const defs = (i: number) => `<defs>
  <linearGradient id="gl${i}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".97"/><stop offset=".5" stop-color="#ece7fd" stop-opacity=".9"/><stop offset="1" stop-color="#a796ef" stop-opacity=".85"/></linearGradient>
  <linearGradient id="dp${i}" x1="0" y1="0" x2="0" y2="1"><stop offset=".3" stop-color="#6549dd" stop-opacity="0"/><stop offset="1" stop-color="#5738c9" stop-opacity=".42"/></linearGradient>
  <linearGradient id="rm${i}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff"/><stop offset=".55" stop-color="#fff" stop-opacity=".18"/><stop offset="1" stop-color="#fff" stop-opacity=".75"/></linearGradient>
  <radialGradient id="gw${i}"><stop offset="0" stop-color="#9b86f0" stop-opacity=".42"/><stop offset="1" stop-color="#9b86f0" stop-opacity="0"/></radialGradient>
  <radialGradient id="kb${i}" cx=".35" cy=".3" r=".85"><stop offset="0" stop-color="#fff"/><stop offset="1" stop-color="#ddd5fb"/></radialGradient>
  <filter id="bl${i}" x="-60%" y="-200%" width="220%" height="500%"><feGaussianBlur stdDeviation="3.5"/></filter>
  <filter id="sp${i}" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="1.3"/></filter>
</defs>`;

// `shape` is one SVG element with "__" where the paint goes.
const glass = (i: number, shape: string) =>
  shape.replace("__", `fill="url(#gl${i})"`)
  + shape.replace("__", `fill="url(#dp${i})"`)
  + shape.replace("__", `fill="none" stroke="url(#rm${i})" stroke-width="1"`);
const spec = (i: number, cx: number, cy: number, rx: number, ry: number, rot = 0) =>
  `<ellipse cx="${cx}" cy="${cy}" rx="${rx}" ry="${ry}" transform="rotate(${rot} ${cx} ${cy})" fill="#fff" opacity=".85" filter="url(#sp${i})"/>`;
const ground = (i: number, rx = 34) =>
  `<circle cx="60" cy="60" r="50" fill="url(#gw${i})"/><ellipse class="art-shadow" cx="60" cy="107" rx="${rx}" ry="4.5" fill="#4b32b5" opacity=".2" filter="url(#bl${i})"/>`;
const glint = (x: number, y: number, r: number) =>
  `<path d="M${x},${y - r} Q${x},${y} ${x + r},${y} Q${x},${y} ${x},${y + r} Q${x},${y} ${x - r},${y} Q${x},${y} ${x},${y - r}Z" fill="#fff" opacity=".9"/>`;

const art: string[] = [
  // Comparing platforms: three glass bars on a frosted disc.
  defs(0) + ground(0, 40)
    + `<g class="art-body">${glass(0, `<ellipse cx="60" cy="97" rx="42" ry="9" __/>`)}`
    + [[29, 30], [51, 48], [73, 66]].map(([x, h]) =>
        glass(0, `<rect x="${x}" y="${95 - h}" width="18" height="${h}" rx="6" __/>`)
        + `<rect x="${x + 3}" y="${99 - h}" width="3.2" height="${h - 12}" rx="1.6" fill="#fff" opacity=".7"/>`).join("")
    + `</g><g class="art-float">${glint(98, 24, 6)}</g>`,

  // Finding the winning ad: three creatives fanned, the front one picked.
  defs(1) + ground(1, 36)
    + `<g class="art-body">`
    + `<g opacity=".7" transform="rotate(-16 60 92)">${glass(1, `<rect x="26" y="32" width="40" height="54" rx="7" __/>`)}</g>`
    + `<g opacity=".7" transform="rotate(16 60 92)">${glass(1, `<rect x="54" y="32" width="40" height="54" rx="7" __/>`)}</g>`
    + glass(1, `<rect x="39" y="28" width="42" height="58" rx="8" __/>`)
    + `<rect x="45" y="34" width="30" height="24" rx="5" fill="#b4a4f4" opacity=".55"/>`
    + `<rect x="45" y="64" width="22" height="3.5" rx="1.75" fill="#fff" opacity=".9"/><rect x="45" y="71" width="15" height="3.5" rx="1.75" fill="#fff" opacity=".7"/>`
    + spec(1, 50, 36, 8, 2.5, -20)
    + `</g><g class="art-float">${glint(90, 24, 7)}</g>`,

  // Deciding what to scale: one glass arrow rising.
  defs(2) + ground(2, 34)
    + `<g class="art-body">${glass(2, `<path d="M18 94 C 42 92 62 80 72 58 L 62 53 L 100 20 L 98 64 L 88 58 C 76 88 50 105 18 105 Z" stroke-linejoin="round" __/>`)}`
    + spec(2, 84, 34, 9, 2.4, -42) + spec(2, 36, 96, 10, 1.8, -6)
    + `</g><g class="art-float">${glint(32, 34, 6)}</g>`,

  // Sending the report: a glass paper plane.
  defs(3) + ground(3, 30)
    + `<g class="art-body" stroke-linejoin="round">`
    + glass(3, `<polygon points="106,18 12,58 52,70" __/>`)
    + `<g opacity=".85">${glass(3, `<polygon points="106,18 52,70 72,76" __/>`)}</g>`
    + glass(3, `<polygon points="106,18 72,76 62,100" __/>`)
    + `<polyline points="12,58 106,18 62,100" fill="none" stroke="#fff" stroke-opacity=".7" stroke-width=".8"/>`
    + spec(3, 66, 40, 14, 2.2, -23)
    + `</g><g class="art-float"><path d="M14 102 C 26 108 34 96 46 100" fill="none" stroke="#b9a8f5" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="0.5 6"/></g>`,

  // Changing ads: a glass switch, turned on.
  defs(4) + ground(4, 38)
    + `<g class="art-body">${glass(4, `<rect x="16" y="42" width="88" height="42" rx="21" __/>`)}`
    + spec(4, 40, 48, 14, 2.4)
    + `<g class="art-knob"><circle cx="82" cy="63" r="16" fill="url(#kb4)"/><circle cx="82" cy="63" r="16" fill="none" stroke="#fff" stroke-width="1.2"/>`
    + `<path d="M75.5 63.5 l4.5 4.5 l8 -9" fill="none" stroke="#8b73e6" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></g>`
    + `</g><g class="art-float">${glint(26, 30, 6)}</g>`,
];
---

<section id={sectionId} class="overflow-hidden border-y border-zinc-100 bg-zinc-50/60 px-6 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="reveal mx-auto max-w-2xl text-center">
      <h2 class="font-display text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">{T.heading}</h2>
    </div>

    <div class="reveal fan mt-10 lg:mt-14" data-fan>
      {T.cards.map((c, i) => (
        <article class="fcard" tabindex="0" data-fcard style={`--r:${[-5, -2.5, 0, 2.5, 5][i]}deg;--dy:${[22, 7, 0, 7, 22][i]}px`}>
          <svg class="fcard-art" viewBox="0 0 120 120" aria-hidden="true" set:html={art[i]} />
          <h3 class="fcard-title">{c.title}</h3>
          <p class="fcard-body">{c.body}</p>

          <div class="fcard-chips" aria-hidden="true">
            {i === 2 ? (
              <div class="flex flex-wrap gap-1.5">
                <span class="fchip text-emerald-700">{T.scale}</span>
                <span class="fchip text-amber-700">{T.hold}</span>
                <span class="fchip text-rose-700">{T.cut}</span>
              </div>
            ) : (
              c.chips.map((t) => (
                <span class="fchip">
                  <svg class="h-3.5 w-3.5 shrink-0 text-brand-500" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 Q12 12 22 12 Q12 12 12 22 Q12 12 2 12 Q12 12 12 2Z"/></svg>
                  <bdi class="truncate">{t}</bdi>
                </span>
              ))
            )}
            {i === 4 && (
              <span class="fchip fchip-approve">
                <span class="fa-a">{T.approve}</span>
                <span class="fa-b">{T.applied}</span>
              </span>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global>
  /* ── Fan of cards ── */
  .fan { display: flex; gap: .875rem; overflow-x: auto; scroll-snap-type: x mandatory; padding: .5rem 1.5rem 1.5rem; margin-inline: -1.5rem; scrollbar-width: none; }
  .fan::-webkit-scrollbar { display: none; }
  .fcard {
    --rx: 0deg; --ry: 0deg; --tx: 0px; --ty: 0px; --shift: 0px; --sc: 1; --rot: 0deg; --lift: 0px;
    position: relative; flex: 0 0 78%; scroll-snap-align: center; outline: none;
    display: flex; flex-direction: column; border-radius: 1.75rem; padding: 1.25rem 1.375rem 1.375rem;
    background: linear-gradient(165deg, #ffffff 0%, #f7f5fe 55%, #eae5fc 100%);
    border: 1px solid rgba(255, 255, 255, .9);
    box-shadow: 0 1px 0 #fff inset, 0 0 0 1px rgba(87, 56, 201, .06), 0 18px 34px -20px rgba(43, 29, 97, .28);
    transform: translate(var(--shift), var(--lift)) rotate(var(--rot)) perspective(900px) rotateX(var(--rx)) rotateY(var(--ry)) scale(var(--sc));
    transition: transform .45s cubic-bezier(.2,.8,.2,1), box-shadow .45s ease;
  }
  .fcard:focus-visible { box-shadow: 0 0 0 3px #b0a1ef, 0 18px 34px -20px rgba(43, 29, 97, .28); }
  .fcard-art { display: block; height: 7.25rem; width: 7.25rem; margin-inline-start: auto; margin-top: -.5rem; overflow: visible; pointer-events: none; }
  .fcard-title { margin-top: .5rem; font-size: 1.3rem; font-weight: 700; line-height: 1.15; letter-spacing: -.02em; color: #1e1b4b; }
  .fcard-body { margin-top: .6rem; font-size: .875rem; line-height: 1.5; color: #71717a; }
  .fcard-chips { margin-top: auto; padding-top: 1rem; display: flex; flex-direction: column; align-items: flex-start; gap: .4rem; }
  .fchip {
    display: inline-flex; max-width: 100%; align-items: center; gap: .4rem; border-radius: 9999px;
    background: rgba(255, 255, 255, .92); padding: .3rem .7rem; font-size: .75rem; font-weight: 600; color: #3f3f46;
    box-shadow: 0 0 0 1px rgba(87, 56, 201, .1), 0 4px 10px -6px rgba(43, 29, 97, .25);
  }
  .fchip-approve { position: relative; color: #fff; background: #18181b; }
  .fa-b { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; opacity: 0; }

  /* layers inside the drawing */
  .art-body, .art-float, .art-shadow { transition: translate .35s ease-out; }
  .art-body { translate: var(--tx) var(--ty); }
  .art-float { translate: calc(var(--tx) * 2.2) calc(var(--ty) * 2.2); }
  .art-shadow { translate: calc(var(--tx) * -.5) 0; }
  .art-knob { transition: translate .55s cubic-bezier(.34,1.56,.64,1); }

  @keyframes faA { 0%,40% { opacity: 1; } 50%,92% { opacity: 0; } 100% { opacity: 1; } }
  @keyframes faB { 0%,40% { opacity: 0; } 50%,92% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes faBg { 0%,40% { background: #18181b; } 50%,92% { background: #059669; } 100% { background: #18181b; } }
  .fchip-approve { animation: faBg 5s ease-in-out 1s infinite; }
  .fchip-approve .fa-a { animation: faA 5s ease-in-out 1s infinite; }
  .fchip-approve .fa-b { animation: faB 5s ease-in-out 1s infinite; }

  /* ── Desktop: an overlapping fan ── */
  @media (min-width: 1024px) {
    .fan { overflow: visible; justify-content: center; gap: 0; padding: 0 0 1.75rem; margin-inline: 0; }
    .fcard { --rot: var(--r); --lift: var(--dy); flex: 0 0 15.25rem; min-height: 22rem; cursor: default; }
    .fcard + .fcard { margin-inline-start: -1.25rem; }
    [dir="rtl"] .fcard { --rot: calc(var(--r) * -1); }

    .fcard-chips { opacity: 0; transform: translateY(6px); transition: opacity .25s ease, transform .35s ease; }
    .fchip-approve, .fchip-approve .fa-a, .fchip-approve .fa-b { animation-play-state: paused; }

    .fcard:is(:hover, :focus-visible) {
      --rot: 0deg; --lift: -16px; --sc: 1.06; z-index: 10;
      box-shadow: 0 1px 0 #fff inset, 0 0 0 1px rgba(87, 56, 201, .1), 0 40px 60px -28px rgba(43, 29, 97, .45);
    }
    .fcard:is(:hover, :focus-visible) .fcard-chips { opacity: 1; transform: none; transition-delay: .08s; }
    .fcard:is(:hover, :focus-visible) .art-knob { translate: 0 0; }
    .fcard:is(:hover, :focus-visible) :is(.fchip-approve, .fa-a, .fa-b) { animation-play-state: running; }
    .fcard .art-knob { translate: -34px 0; }

    /* neighbours make room */
    .fcard:is(:hover, :focus-visible) ~ .fcard { --shift: 26px; }
    .fcard:has(~ .fcard:is(:hover, :focus-visible)) { --shift: -26px; }
    [dir="rtl"] .fcard:is(:hover, :focus-visible) ~ .fcard { --shift: -26px; }
    [dir="rtl"] .fcard:has(~ .fcard:is(:hover, :focus-visible)) { --shift: 26px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fcard, .fcard-chips, .art-body, .art-float, .art-shadow, .art-knob { transition: none !important; }
    .fchip-approve, .fa-a, .fa-b { animation: none !important; }
  }
</style>

<script>
  // The lifted card leans toward the pointer and its drawing drifts on its own
  // layer. Mouse only, and off when motion is reduced.
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLElement>("[data-fcard]").forEach((card) => {
      card.addEventListener("pointermove", (e) => {
        if (e.pointerType !== "mouse" || window.innerWidth < 1024) return;
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        card.style.setProperty("--ry", `${(x * 9).toFixed(2)}deg`);
        card.style.setProperty("--rx", `${(-y * 7).toFixed(2)}deg`);
        card.style.setProperty("--tx", `${(x * 5).toFixed(2)}px`);
        card.style.setProperty("--ty", `${(y * 4).toFixed(2)}px`);
      });
      card.addEventListener("pointerleave", () => {
        ["--rx", "--ry", "--tx", "--ty"].forEach((p) => card.style.removeProperty(p));
      });
    });
  }
</script>
