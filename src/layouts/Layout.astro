---
// Type system, shared with the app. See src/styles/global.css.
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Keep a page out of search results. For legal pages that exist to be
      linked to directly, not found. */
  noindex?: boolean;
  /** "ar" renders the page right-to-left and localizes the nav and footer.
      Arabic pages live under src/pages/ar/, one twin per English page. */
  locale?: "en" | "ar";
}

const {
  title,
  description,
  ogImage = "/logo-1024.png",
  noindex = false,
  locale = "en",
} = Astro.props;

const APP_URL = "https://app.adfunnl.com";
const SITE = "https://www.adfunnl.com";
const ar = locale === "ar";

// ── Paths ──────────────────────────────────────────────────────────────
// Every Arabic page is its English twin's path with /ar in front. `basePath`
// is the English path for both, so the active states and the language
// switch work the same way on either side.
const path = (Astro.url.pathname.replace(/\/+$/, "") || "/");
const basePath = path.replace(/^\/ar(?=\/|$)/, "") || "/";
const toAr = (href: string) =>
  href === "/" ? "/ar" : href.startsWith("/#") ? `/ar${href.slice(1)}` : `/ar${href}`;
/** Internal link in the current locale. */
const L = (href: string) => (ar ? toAr(href) : href);
const enHref = basePath;
const arHref = toAr(basePath);

// ── Nav and footer copy ────────────────────────────────────────────────
// Arabic keeps media-buying terms and the persona names in English, see the
// Arabic section in docs/voice.md.
const COPY = {
  en: {
    description: "AdFunnl: Every ad platform. Every store. One source of truth. Meta, TikTok, Snapchat and Google, plus Shopify and Salla revenue, in one always-fresh workspace.",
    forMenu: "AdFunnl For",
    menuEyebrow: "Built around the job you actually do",
    youreHere: "You're here",
    moreRoles: "More roles coming soon: agency founders and in-house marketing managers.",
    integrations: "Integrations",
    pricing: "Pricing",
    signIn: "Sign in",
    startFree: "Start free",
    toggleMenu: "Toggle menu",
    slogan: "Connect. Visualize. Share.",
    footerLine: "Every ad platform. Every store. One source of truth, shared live with your clients.",
    product: "Product",
    dashboards: "Dashboards",
    features: "Features",
    company: "Company",
    about: "About",
    privacy: "Privacy",
    terms: "Terms",
    security: "Security",
    forPersona: (s: string) => `For ${s}`,
    onSocial: (s: string) => `AdFunnl on ${s}`,
    rights: "AdFunnl. All rights reserved.",
    powered: "Powered by Funnl Suite",
    blurbs: {
      am: "Answer client questions with a link, not an evening's work.",
      tl: "Know an account is slipping before the client tells you.",
      mb: "Take on twice the clients without any of them getting less of you.",
    },
  },
  ar: {
    description: "AdFunnl يجمع Meta وTikTok وSnapchat وGoogle مع إيرادات Shopify وسلة في مساحة عمل واحدة محدَّثة دائمًا.",
    forMenu: "حسب دورك",
    menuEyebrow: "مبني حول العمل الذي تقوم به فعلًا",
    youreHere: "أنت هنا",
    moreRoles: "أدوار أخرى قريبًا: مؤسسو الوكالات ومديرو التسويق داخل الشركات.",
    integrations: "التكاملات",
    pricing: "الأسعار",
    signIn: "تسجيل الدخول",
    startFree: "ابدأ مجانًا",
    toggleMenu: "فتح القائمة",
    slogan: "اربط. اعرض. شارك.",
    footerLine: "كل منصاتك الإعلانية ومتاجرك في مصدر أرقام واحد، تشاركه مع عملائك مباشرةً.",
    product: "المنتج",
    dashboards: "لوحات المعلومات",
    features: "المزايا",
    company: "الشركة",
    about: "من نحن",
    privacy: "الخصوصية",
    terms: "الشروط",
    security: "الأمان",
    forPersona: (s: string) => `لـ ${s}`,
    onSocial: (s: string) => `AdFunnl على ${s}`,
    rights: "AdFunnl. جميع الحقوق محفوظة.",
    powered: "من تطوير Funnl Suite",
    blurbs: {
      am: "أجب عن أسئلة العميل برابط واحد، بدل أمسية كاملة من العمل.",
      tl: "اعرف أن حسابًا يتراجع قبل أن يخبرك العميل.",
      mb: "استلم ضعف عدد العملاء دون أن يقلّ نصيب أيٍّ منهم من وقتك.",
    },
  },
};
const T = COPY[locale];
const pageDescription = description ?? T.description;

// ── "AdFunnl For" persona menu ────────────────────────────────────────
// Adding a persona page is a one-line change here: the desktop mega-menu,
// the mobile menu and the active states all read from this array. The
// persona names are fixed terms and stay in English in both locales.
const personas = [
  {
    label: "Account Managers",
    short: "Account Managers",
    blurb: T.blurbs.am,
    href: "/for/account-managers",
    icon: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
  },
  {
    label: "Team Leads",
    short: "Team Leads",
    blurb: T.blurbs.tl,
    href: "/for/team-leads",
    icon: `<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>`,
  },
  {
    label: "Media Buyers",
    short: "Media Buyers",
    blurb: T.blurbs.mb,
    href: "/for/media-buyers",
    icon: `<path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/>`,
  },
];

// ── Social profiles (footer) ──────────────────────────────────────────
// Platform names stay in English in both locales. `stroke` marks an outline
// glyph, the rest are filled.
const socials = [
  {
    name: "Instagram",
    href: "https://www.instagram.com/adfunnl/",
    stroke: true,
    icon: `<rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/>`,
  },
  {
    name: "TikTok",
    href: "https://www.tiktok.com/@adfunnl",
    icon: `<path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>`,
  },
  {
    name: "Facebook",
    href: "https://www.facebook.com/profile.php?id=61591248635135",
    icon: `<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>`,
  },
  {
    name: "LinkedIn",
    href: "https://www.linkedin.com/company/adfunnl/",
    icon: `<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>`,
  },
];

const isCurrent = (href: string) => basePath === href.replace(/\/+$/, "");
const forSectionActive = basePath === "/for" || basePath.startsWith("/for/");
---

<!DOCTYPE html>
<html lang={locale} dir={ar ? "rtl" : "ltr"}>
  <head>
    <!-- Google Tag Manager. The container is shared with the app, so the
         site tags itself "web" before GTM loads. Events: src/scripts/analytics.ts -->
    <script is:inline>window.dataLayer=window.dataLayer||[];window.dataLayer.push({site_section:'web'});</script>
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WL3FT97F');</script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="alternate" hreflang="en" href={`${SITE}${enHref === "/" ? "/" : enHref}`} />
    <link rel="alternate" hreflang="ar" href={`${SITE}${arHref}`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE}${enHref === "/" ? "/" : enHref}`} />

    <meta property="og:title"       content={`${title} · AdFunnl`} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:type"        content="website" />
    <meta property="og:locale"      content={ar ? "ar_AR" : "en_US"} />

    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={`${title} · AdFunnl`} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image"       content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{title} · AdFunnl</title>
    <script>import "../scripts/analytics.ts";</script>
  </head>
  <body class="bg-white text-zinc-900 antialiased font-sans">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WL3FT97F"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!-- Nav -->
    <header class="sticky top-0 z-50 border-b border-zinc-100 bg-white/85 backdrop-blur-md">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
        <a href={L("/")} class="shrink-0">
          <img src="/logo.png" alt="AdFunnl" class="h-6 w-auto" />
        </a>

        <!-- Desktop nav -->
        <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-zinc-600">
          <!-- AdFunnl For: persona mega-menu (data-driven, see `personas`) -->
          <div class="relative group">
            <button
              type="button"
              class:list={["flex items-center gap-1 py-2 transition hover:text-zinc-900 group-focus-within:text-zinc-900", forSectionActive && "text-zinc-900"]}
              aria-haspopup="true"
            >
              {T.forMenu}
              <svg class="h-4 w-4 text-zinc-400 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8l4 4 4-4"/></svg>
            </button>

            <!-- Panel (pt-3 keeps a hover bridge). left-1/2 plus the negative
                 translate centres it physically, so it stays put in RTL. -->
            <div class="invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 transition-all duration-200 absolute left-1/2 -translate-x-1/2 top-full pt-3 w-[27rem]">
              <div class="rounded-2xl border border-zinc-100 bg-white p-2 shadow-xl shadow-zinc-900/[0.08] ring-1 ring-zinc-900/[0.02]">
                <p class="px-3.5 pb-1 pt-2 text-[10px] font-semibold uppercase tracking-widest text-zinc-400">
                  {T.menuEyebrow}
                </p>
                {personas.map((p) => (
                  <a
                    href={L(p.href)}
                    aria-current={isCurrent(p.href) ? "page" : undefined}
                    class:list={["group/item flex gap-3.5 rounded-xl p-3.5 transition hover:bg-brand-50/70", isCurrent(p.href) && "bg-brand-50/70"]}
                  >
                    <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-600 text-white">
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />
                    </span>
                    <span class="min-w-0">
                      <span class="flex items-start gap-2">
                        <span class="min-w-0 flex-1 text-sm font-semibold text-zinc-900">{p.label}</span>
                        {isCurrent(p.href) && (
                          <span class="mt-0.5 shrink-0 whitespace-nowrap rounded-full bg-brand-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-brand-700">{T.youreHere}</span>
                        )}
                      </span>
                      <span class="mt-1 block text-xs leading-relaxed text-zinc-500">{p.blurb}</span>
                    </span>
                  </a>
                ))}
                <div class="mx-3.5 mt-1 border-t border-zinc-100 pt-3 pb-2">
                  <!-- Keep this list in sync with `personas`: a role listed here
                       and shipped above reads as a mistake. -->
                  <p class="text-xs text-zinc-400">{T.moreRoles}</p>
                </div>
              </div>
            </div>
          </div>

          <a href={L("/#integrations")} class="hover:text-zinc-900 transition">{T.integrations}</a>
          <a href={L("/pricing")} class="hover:text-zinc-900 transition">{T.pricing}</a>
        </nav>

        <div class="flex items-center gap-3">
          <!-- Language switch, same EN / ع pair as the app's toggle. It links to
               this page's twin in the other language. -->
          <div dir="ltr" class="flex overflow-hidden rounded-lg border border-zinc-200 text-xs font-medium">
            <a href={enHref} hreflang="en" lang="en" aria-current={ar ? undefined : "true"}
               class:list={["px-2.5 py-1 transition", ar ? "text-zinc-500 hover:bg-zinc-50" : "bg-brand-600 text-white"]}>EN</a>
            <a href={arHref} hreflang="ar" lang="ar" aria-label="العربية" aria-current={ar ? "true" : undefined}
               class:list={["border-s border-zinc-200 px-2.5 py-1 transition", ar ? "bg-brand-600 text-white" : "text-zinc-500 hover:bg-zinc-50"]}>ع</a>
          </div>

          <a href={`${APP_URL}/login`}
             class="hidden sm:inline-block text-sm font-medium text-zinc-600 hover:text-zinc-900 transition">
            {T.signIn}
          </a>
          <a href={`${APP_URL}/signup`}
             class="hidden sm:inline-block rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700 transition">
            {T.startFree}
          </a>

          <!-- Mobile toggle -->
          <input type="checkbox" id="nav-toggle" class="peer hidden" aria-label={T.toggleMenu} />
          <label for="nav-toggle" class="md:hidden inline-flex h-9 w-9 items-center justify-center rounded-lg border border-zinc-200 text-zinc-700 cursor-pointer select-none">
            <svg class="h-5 w-5 peer-checked:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </label>

          <!-- Mobile menu -->
          <div class="hidden peer-checked:block md:!hidden absolute inset-x-0 top-full border-b border-zinc-100 bg-white shadow-lg">
            <nav class="mx-auto max-w-6xl px-6 py-4 flex flex-col gap-1 text-sm font-medium text-zinc-700">
              <p class="px-3 pb-1 pt-1 text-[10px] font-semibold uppercase tracking-widest text-zinc-400">{T.forMenu}</p>
              {personas.map((p) => (
                <a
                  href={L(p.href)}
                  aria-current={isCurrent(p.href) ? "page" : undefined}
                  class:list={["flex items-start gap-3 rounded-lg px-3 py-3 hover:bg-zinc-50", isCurrent(p.href) && "bg-brand-50/70"]}
                >
                  <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand-600 text-white">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />
                  </span>
                  <span class="min-w-0">
                    <span class="flex flex-wrap items-center gap-2">
                      <span class={isCurrent(p.href) ? "text-brand-700" : ""}>{p.label}</span>
                      {isCurrent(p.href) && (
                        <span class="shrink-0 whitespace-nowrap rounded-full bg-brand-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-brand-700">{T.youreHere}</span>
                      )}
                    </span>
                    <span class="mt-0.5 block text-xs font-normal leading-relaxed text-zinc-500">{p.blurb}</span>
                  </span>
                </a>
              ))}
              <div class="my-1 border-t border-zinc-100"></div>
              <a href={L("/#integrations")} class="rounded-lg px-3 py-3 hover:bg-zinc-50">{T.integrations}</a>
              <a href={L("/pricing")}       class="rounded-lg px-3 py-3 hover:bg-zinc-50">{T.pricing}</a>
              <div class="mt-2 grid grid-cols-2 gap-3 border-t border-zinc-100 pt-4">
                <a href={`${APP_URL}/login`}  class="rounded-lg border border-zinc-200 px-4 py-2.5 text-center hover:bg-zinc-50">{T.signIn}</a>
                <a href={`${APP_URL}/signup`} class="rounded-lg bg-brand-600 px-4 py-2.5 text-center font-semibold text-white hover:bg-brand-700">{T.startFree}</a>
              </div>
            </nav>
          </div>
        </div>
      </div>
    </header>

    <slot />

    <!-- Footer -->
    <footer class="border-t border-zinc-100 bg-zinc-50">
      <div class="mx-auto max-w-6xl px-6 py-14">
        <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr]">
          <div>
            <img src="/logo.png" alt="AdFunnl" class="h-5 w-auto mb-3" />
            <!-- The slogan. This is its home: brand line first, then the plain
                 description of what the product is. Do not repeat it elsewhere
                 on the page. -->
            <p class="font-display text-base font-bold tracking-tight text-brand-700">{T.slogan}</p>
            <p class="mt-2 max-w-xs text-sm leading-relaxed text-zinc-500">{T.footerLine}</p>
            <div class="mt-5 flex items-center gap-2">
              {socials.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={T.onSocial(s.name)}
                  title={s.name}
                  class="flex h-9 w-9 items-center justify-center rounded-full border border-zinc-200 bg-white text-zinc-500 transition hover:border-brand-200 hover:text-brand-700"
                >
                  <svg
                    viewBox="0 0 24 24"
                    class="h-4 w-4"
                    fill={s.stroke ? "none" : "currentColor"}
                    stroke={s.stroke ? "currentColor" : "none"}
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={s.icon}
                  />
                </a>
              ))}
            </div>
          </div>
          <div>
            <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-zinc-400">{T.product}</p>
            <nav class="flex flex-col gap-2.5 text-sm text-zinc-500">
              <a href={L("/features/dashboard")} class="hover:text-zinc-900 transition">{T.dashboards}</a>
              <a href={L("/#features")}          class="hover:text-zinc-900 transition">{T.features}</a>
              <a href={L("/#integrations")}      class="hover:text-zinc-900 transition">{T.integrations}</a>
              <a href={L("/pricing")}            class="hover:text-zinc-900 transition">{T.pricing}</a>
              {personas.map((p) => (
                <a href={L(p.href)} class="hover:text-zinc-900 transition">{T.forPersona(p.short)}</a>
              ))}
            </nav>
          </div>
          <div>
            <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-zinc-400">{T.company}</p>
            <nav class="flex flex-col gap-2.5 text-sm text-zinc-500">
              <a href={`${APP_URL}/signup`} class="hover:text-zinc-900 transition">{T.startFree}</a>
              <a href={L("/about")}    class="hover:text-zinc-900 transition">{T.about}</a>
              <a href={L("/security")} class="hover:text-zinc-900 transition">{T.security}</a>
              <a href={L("/privacy")}  class="hover:text-zinc-900 transition">{T.privacy}</a>
              <a href={L("/terms")}    class="hover:text-zinc-900 transition">{T.terms}</a>
            </nav>
          </div>
        </div>
        <div class="mt-10 flex flex-col gap-1.5 border-t border-zinc-200 pt-6 text-xs text-zinc-400 sm:flex-row sm:items-center sm:justify-between">
          <span>© {new Date().getFullYear()} {T.rights}</span>
          <span>{T.powered}</span>
        </div>
      </div>
    </footer>

  </body>
</html>
