---
import Layout from "../layouts/Layout.astro";

const SUPPORT_EMAIL = "support@adfunnl.com";

// ── About ─────────────────────────────────────────────────────────────────
// Trust/credibility page: who operates AdFunnl and how to reach them. Written
// plainly on purpose (see docs/voice.md section 4, "page brief") rather than
// as persona copy: this page has one job, proving AdFunnl is a real business
// behind a real product, not converting a reader.
const SECTIONS = [
  {
    title: "What AdFunnl does",
    body: "AdFunnl is a marketing analytics platform. Agencies and in-house teams connect their ad accounts (Meta, TikTok, Snapchat and Google) and their store data (Shopify, Salla and other platforms) so their performance shows up in one dashboard instead of a separate tab per platform. Clients see the same numbers through a live link or a PDF built from that dashboard.",
  },
  {
    title: "Who operates AdFunnl",
    body: "AdFunnl is a product of Funnl Suite LLC, based in Alexandria, Egypt.",
  },
  {
    title: "Contact",
    body: null,
  },
];
---

<Layout
  title="About"
  description="AdFunnl is a marketing analytics platform, operated by Funnl Suite LLC in Alexandria, Egypt."
>
  <main class="mx-auto max-w-3xl px-6 py-16 md:py-20">
    <h1 class="font-display text-3xl font-bold tracking-tight text-zinc-900">About AdFunnl</h1>

    <div class="mt-12 space-y-10">
      {SECTIONS.map((section) => (
        <section>
          <h2 class="text-lg font-semibold text-zinc-900">{section.title}</h2>
          {section.body && <p class="mt-2 text-[15px] leading-relaxed text-zinc-600">{section.body}</p>}
          {section.title === "Contact" && (
            <p class="mt-2 text-[15px] leading-relaxed text-zinc-600">
              For any question about the service or your data, contact us at{" "}
              <a href={`mailto:${SUPPORT_EMAIL}`} class="text-brand-700 underline">{SUPPORT_EMAIL}</a>.
            </p>
          )}
        </section>
      ))}
    </div>
  </main>
</Layout>
