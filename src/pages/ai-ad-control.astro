---
import Layout from "../layouts/Layout.astro";
import PlatformIcon from "../components/PlatformIcon.astro";
import AdControlSafety from "../components/AdControlSafety.astro";

const APP_URL = "https://app.adfunnl.com";

// ── The brief ─────────────────────────────────────────────────────────
//   Who     A media buyer or performance marketer who already works in Claude
//           or ChatGPT and spots the problem in AdFunnl, then loses the time
//           fixing it platform by platform.
//   Promise Ask your AI to make the change, and nothing happens until you
//           approve it.
//   Action  Start free.
//
// Objections this page answers (R13):
//   - "I am not letting an AI touch live budgets." Plan first, approval in the
//     chat, new things start paused, every change in the Change Log, and a
//     read-only option.
//   - "Does it work on my platform?" The table, platform by platform.
//   - "Is it on my plan?" The FAQ and the closing line.
//
// CAPABILITY WARNINGS for anyone editing this page (docs/what-ships.md, ad
// control, checked 14 October 2026):
//   - Labels are the owner's: TikTok and Snapchat Live, Meta and Google Beta.
//   - Google (since 15 October 2026): everything in the table, budgets on
//     campaigns only (Google keeps budgets there). New campaigns are Search,
//     Shopping, Display, Demand Gen and Performance Max (checked 21 October
//     2026); videos must already be on YouTube. Audiences on Google are
//     website-visitor lists only.
//   - On Meta, new campaigns, new ads and existing posts as ads are plain ticks
//     since 25 October 2026 (Meta approved pages_manage_ads).
//   - Platform order is fixed: Meta, TikTok, Snapchat and Google.
//   - Nobody has measured how long connecting takes. No "about a minute".

const hero = {
  heading: "Run your ads from the AI you already use",
  body: "Ask Claude or ChatGPT to pause the ads that waste money or move budget to the ones that work. AdFunnl prepares the change as a plan, and nothing happens until you approve it in the chat.",
  chat: {
    ask: "Raise the budget of my best-ROAS TikTok campaign by 20%.",
    tool: "set_ad_budget",
    cardTitle: "Change 1 budget",
    item: "Website sales · Tiffin Co.",
    from: "EGP 1,500",
    to: "EGP 1,800",
    perDay: "a day",
    approve: "Approve",
    connected: "AdFunnl connected",
  },
};

// ── Us versus them (R12) ──────────────────────────────────────────────
// Rows are jobs, not features. Every "now" line is checked: rises over 50%
// are held back, duplicates and new items start switched off, Drive is the
// source for new campaigns.
const compare = {
  heading: "You found the problem in a minute. Fixing it still takes a tab per platform",
  body: "Pausing two ads on two platforms means two logins and two sets of menus, with a chance each time of switching off the wrong row. Ask instead, and the change comes back as one list for you to check.",
  oldLabel: "The usual way",
  nowLabel: "From Claude or ChatGPT",
  rows: [
    {
      job: "Pausing the ads that waste money",
      old: "Open each platform, find each ad, switch it off one at a time.",
      now: "Ask once. Every ad it would pause comes back in one list to approve.",
    },
    {
      job: "Moving budget to a winner",
      old: "Work out the new number, then type it into each campaign.",
      now: "Say how much. A rise of more than 50% is held back unless you asked for it.",
    },
    {
      job: "Testing a new audience",
      old: "Duplicate the ad set, edit the targeting, then check it did not go live.",
      now: "Ask for it inside the running campaign. The new ad set starts paused.",
    },
    {
      job: "Launching from new videos",
      old: "Download them from Drive, upload them to the platform, build the campaign by hand.",
      now: "Point it at the Drive folder. The campaign is built switched off, ready to review.",
    },
  ],
};

// ── What it can change, per platform ──────────────────────────────────
// Columns in the fixed order. Cell values: true = yes, false = no,
// Any string = a qualified yes.
type Cell = boolean | string;
const platforms = [
  { name: "Meta", key: "meta", status: "Beta" },
  { name: "TikTok", key: "tiktok", status: "Live" },
  { name: "Snapchat", key: "snapchat", status: "Live" },
  { name: "Google", key: "google_ads", status: "Beta" },
];
const table = {
  heading: "What it can change on each platform",
  body: "Live means it is finished. Beta means it works today and is still gaining actions.",
  live: "Live",
  rows: [
    { label: "Pause and turn on campaigns, ad sets and ads", cells: [true, true, true, true] },
    { label: "Change budgets", cells: [true, true, true, "Campaigns only"] },
    { label: "Duplicate, rename and delete", cells: [true, true, true, true] },
    { label: "Edit audiences", cells: [true, true, true, "Locations and languages"] },
    { label: "Edit ad text and URL tracking tags", cells: [true, true, true, true] },
    { label: "Launch new campaigns from Google Drive", cells: [true, true, true, "Search, Shopping, Display, Demand Gen and Performance Max"] },
    { label: "Add new ads to running campaigns", cells: [true, true, true, true] },
    { label: "Keywords, negative keywords and search terms", cells: [false, false, false, true] },
    { label: "Turn existing posts into ads", cells: [true, true, false, false] },
    { label: "Catalog ads and call ads", cells: [false, false, true, false] },
    { label: "Automated rules and budget schedules", cells: [true, false, false, false] },
    { label: "Create audiences", cells: [true, true, true, "Website visitors"] },
  ] as { label: string; cells: Cell[] }[],
  yes: "Yes",
  no: "No",
};

// ── Things you can ask ────────────────────────────────────────────────
// Requests, not results: the numbers are what a reader would type.
const examples = {
  heading: "Things you can ask",
  items: [
    "Pause every ad that spent over 1,000 this week without a single purchase.",
    "Raise the budget of my best-ROAS TikTok campaign by 20%.",
    "Create a Snapchat sales campaign from the videos in this Drive folder, 500 a day, and leave it paused.",
    "Duplicate my best ad into the three retargeting ad sets.",
    "Test a new 25 to 34 audience in my running TikTok campaign.",
    "Add UTM tags to every ad in this account.",
  ],
};

const steps = {
  heading: "How it works",
  items: [
    { title: "Connect once", body: "Add AdFunnl to Claude or ChatGPT and sign in with your AdFunnl account. Keep \"Also allow it to make changes\" ticked on the approval screen." },
    { title: "Ask in plain words", body: "Your assistant reads the live numbers in AdFunnl and prepares the change as a plan." },
    { title: "Approve it", body: "You see exactly what will change. Approve it in the chat and it goes live, and into the brand's Change Log." },
  ],
};

const faqs = {
  heading: "Questions",
  items: [
    { q: "Can it change my ads without asking me?", a: "No. Every change comes back as a plan first, and only happens once you approve it in the chat." },
    { q: "What does Beta mean for Meta and Google?", a: "It works today, on real accounts. On Google it covers everything in the table, with Search, Shopping, Display, Demand Gen and Performance Max campaigns; videos for Google must already be on YouTube. Both are still gaining actions." },
    { q: "Which assistants does it work with?", a: "Claude, ChatGPT, and any other AI assistant that can connect to an MCP server." },
    { q: "Can I connect it read-only?", a: "Yes. Untick \"Also allow it to make changes\" on the approval screen, and it can only read your numbers." },
    { q: "Can my team see what it changed?", a: "Yes. Every change it makes is written to the brand's Change Log, with what changed and when." },
    { q: "Which plans include it?", a: "Growth and Agency include it. On Solo it is an add-on at EGP 500 or $10 a month, on its own, with no AI add-on needed (the AI add-on at EGP 390 or $8 is only for the AI assistant). It is not part of the free trial." },
  ],
};

const closing = {
  heading: "Start with one account",
  body: "Ad control comes with Growth and Agency. On Solo, add it for EGP 500 / $10 a month, on its own.",
  pricing: "See pricing",
};
---

<Layout
  title="AI ad control"
  seoTitle="Run your ads from Claude or ChatGPT · AdFunnl"
  description="Connect AdFunnl to Claude or ChatGPT and ask it to pause ads, move budget or launch campaigns. Every change waits for your approval."
>

  <!-- ============================== HERO ============================== -->
  <section class="relative overflow-hidden bg-white px-6 pt-14 pb-16 sm:pt-16">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_60%_50%_at_50%_-10%,#e6e1fb,transparent)]"></div>
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[1fr_1fr]">
      <div>
        <h1 class="font-display text-4xl font-bold tracking-tight text-zinc-950 sm:text-5xl">{hero.heading}</h1>
        <p class="mt-5 text-lg leading-relaxed text-zinc-500">{hero.body}</p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {platforms.map((p) => (
            <li class="inline-flex items-center gap-1.5 rounded-full border border-zinc-200 bg-white px-3 py-1 text-xs font-semibold text-zinc-700">
              <PlatformIcon platform={p.key} class="h-3.5 w-3.5" />{p.name}
              {p.status !== table.live && <span class="rounded bg-brand-50 px-1.5 py-px text-[10px] font-bold text-brand-700">{p.status}</span>}
            </li>
          ))}
        </ul>
        <a href={`${APP_URL}/signup`}
           class="mt-8 inline-block w-full rounded-xl bg-brand-600 px-7 py-3.5 text-center text-base font-semibold text-white shadow-lg shadow-brand-200 transition hover:bg-brand-700 sm:w-auto">
          Start free
        </a>
      </div>

      <!-- A request, the plan it comes back with, and the approval -->
      <div class="rounded-2xl border border-zinc-200 bg-white shadow-2xl shadow-brand-900/10">
        <div class="flex items-center gap-2 border-b border-zinc-100 bg-zinc-50 px-4 py-2.5 text-[11px] font-medium text-zinc-500">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>{hero.chat.connected}
        </div>
        <div class="space-y-4 p-5">
          <p class="ms-auto w-fit max-w-[85%] rounded-2xl bg-zinc-100 px-3.5 py-2.5 text-sm leading-relaxed text-zinc-800">{hero.chat.ask}</p>
          <div class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-zinc-50 px-2.5 py-1.5 text-xs font-medium text-zinc-500">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 17l6-6-6-6M12 19h8"/></svg>
            <span dir="ltr">AdFunnl · {hero.chat.tool}</span>
          </div>
          <div class="rounded-xl border border-zinc-200 p-4">
            <p class="text-sm font-semibold text-zinc-900">{hero.chat.cardTitle}</p>
            <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
              <PlatformIcon platform="tiktok" class="h-4 w-4 shrink-0" />
              <span class="text-zinc-700" dir="ltr">{hero.chat.item}</span>
              <span class="tabular-nums lining-nums text-zinc-500" dir="ltr">{hero.chat.from} → <strong class="font-semibold text-zinc-900">{hero.chat.to}</strong></span>
              <span class="text-zinc-500">{hero.chat.perDay}</span>
            </div>
            <span class="mt-4 inline-block rounded-md bg-zinc-900 px-3 py-1.5 text-xs font-semibold text-white">{hero.chat.approve}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ COMPARISON ============================ -->
  <section class="bg-zinc-50 px-6 py-16 sm:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">{compare.heading}</h2>
        <p class="mt-4 text-lg leading-relaxed text-zinc-500">{compare.body}</p>
      </div>
      <div class="mt-12 overflow-hidden rounded-2xl border border-zinc-200 bg-white">
        <div class="hidden grid-cols-[1fr_1.2fr_1.2fr] gap-6 border-b border-zinc-200 bg-zinc-50 px-6 py-3 text-xs font-semibold uppercase tracking-wider text-zinc-400 md:grid">
          <span></span><span>{compare.oldLabel}</span><span class="text-brand-700">{compare.nowLabel}</span>
        </div>
        {compare.rows.map((r) => (
          <div class="grid gap-2 border-b border-zinc-100 px-6 py-5 last:border-b-0 md:grid-cols-[1fr_1.2fr_1.2fr] md:gap-6">
            <p class="font-semibold text-zinc-900">{r.job}</p>
            <p class="text-sm leading-relaxed text-zinc-500"><span class="me-1 font-semibold text-zinc-400 md:hidden">{compare.oldLabel}:</span>{r.old}</p>
            <p class="text-sm leading-relaxed text-zinc-800"><span class="me-1 font-semibold text-brand-700 md:hidden">{compare.nowLabel}:</span>{r.now}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================= PER-PLATFORM TABLE ========================= -->
  <section class="bg-white px-6 py-16 sm:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">{table.heading}</h2>
        <p class="mt-4 text-lg leading-relaxed text-zinc-500">{table.body}</p>
      </div>
      <div class="mt-12 overflow-x-auto rounded-2xl border border-zinc-200">
        <table class="w-full min-w-[640px] text-sm">
          <thead class="bg-zinc-50">
            <tr>
              <th class="px-4 py-3 text-start font-semibold text-zinc-500"></th>
              {platforms.map((p) => (
                <th class="px-3 py-3 text-center font-semibold text-zinc-900">
                  <span class="inline-flex items-center gap-1.5"><PlatformIcon platform={p.key} class="h-4 w-4" />{p.name}</span>
                  <span class:list={[
                    "mt-1 block text-[11px] font-bold",
                    p.status === table.live ? "text-emerald-600" : "text-brand-700",
                  ]}>{p.status}</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {table.rows.map((r) => (
              <tr class="border-t border-zinc-100">
                <th scope="row" class="px-4 py-3 text-start font-medium text-zinc-700">{r.label}</th>
                {r.cells.map((c) => (
                  <td class="px-3 py-3 text-center">
                    {c === true && <span class="text-base font-bold text-emerald-600" aria-label={table.yes}>✓</span>}
                    {c === false && <span class="text-zinc-300" aria-label={table.no}>·</span>}
                    {typeof c === "string" && <span class="text-xs font-semibold text-emerald-700">{c}</span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============================= EXAMPLES ============================= -->
  <section class="bg-zinc-50 px-6 py-16 sm:py-24">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-center font-display text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">{examples.heading}</h2>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 m-snap">
        {examples.items.map((e) => (
          <li class="rounded-2xl rounded-ee-sm bg-brand-600 px-5 py-4 text-sm leading-relaxed text-white shadow-sm">{e}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============================ HOW IT WORKS ============================ -->
  <section class="bg-white px-6 py-16 sm:py-24">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-center font-display text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">{steps.heading}</h2>
      <ol class="mt-12 grid gap-5 md:grid-cols-3 m-snap">
        {steps.items.map((s, i) => (
          <li class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-100 font-display text-sm font-bold text-brand-700">{i + 1}</span>
            <p class="mt-4 font-display text-lg font-bold text-zinc-950">{s.title}</p>
            <p class="mt-2 text-sm leading-relaxed text-zinc-500">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- =============================== SAFETY =============================== -->
  <section class="bg-zinc-50 px-6 py-16 sm:py-24">
    <AdControlSafety as="h2" class="mx-auto max-w-5xl" />
  </section>

  <!-- ================================ FAQ ================================ -->
  <section class="bg-white px-6 py-16 sm:py-24">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-center font-display text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">{faqs.heading}</h2>
      <div class="mt-12 space-y-4">
        {faqs.items.map((f) => (
          <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
            <h3 class="font-display text-lg font-bold text-zinc-950">{f.q}</h3>
            <p class="mt-3 leading-relaxed text-zinc-600">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================================ CTA ================================ -->
  <section class="px-6 py-16 sm:py-24">
    <div class="mx-auto max-w-5xl rounded-3xl bg-ink px-6 py-16 text-center sm:py-20">
      <div class="mx-auto max-w-2xl">
        <h2 class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">{closing.heading}</h2>
        <p class="mt-4 text-lg text-zinc-400">{closing.body}</p>
        <div class="mt-9 flex flex-col items-center justify-center gap-5 sm:flex-row">
          <a href={`${APP_URL}/signup`}
             class="w-full rounded-xl bg-brand-600 px-8 py-3.5 text-center text-base font-semibold text-white transition hover:bg-brand-500 sm:w-auto">
            Start free
          </a>
          <a href="/pricing" class="text-sm font-semibold text-zinc-300 underline-offset-4 hover:text-white hover:underline">{closing.pricing}</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
