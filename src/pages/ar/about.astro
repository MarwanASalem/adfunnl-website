---
// Arabic twin of src/pages/about.astro. Keep the two in step: a change to one
// page's copy or markup belongs in the other. Media-buying and technical
// terms stay in English, see the Arabic section of docs/voice.md.
//
import Layout from "../../layouts/Layout.astro";

const SUPPORT_EMAIL = "support@adfunnl.com";

// ── About ─────────────────────────────────────────────────────────────────
// Trust/credibility page: who operates AdFunnl and how to reach them. Written
// plainly on purpose (see docs/voice.md section 4, "page brief") rather than
// as persona copy: this page has one job, proving AdFunnl is a real business
// behind a real product, not converting a reader.
const SECTIONS = [
  {
    title: "ماذا يقدّم AdFunnl",
    body: "AdFunnl منصة لتحليلات التسويق. تربط الوكالات والفرق الداخلية حساباتها الإعلانية (Meta وTikTok وSnapchat وGoogle) وبيانات متاجرها (Shopify وسلة ومنصات أخرى)، فيظهر أداؤها في لوحة واحدة بدل تبويب منفصل لكل منصة. ويرى العملاء الأرقام نفسها عبر رابط مباشر أو ملف PDF من تلك اللوحة.",
  },
  {
    title: "من يدير AdFunnl",
    body: "AdFunnl منتج تابع لشركة Funnl Suite LLC، ومقرها الإسكندرية، مصر.",
  },
  {
    title: "التواصل",
    body: null,
  },
];
---

<Layout
  locale="ar"
  title="من نحن"
  description="AdFunnl منصة لتحليلات التسويق تديرها شركة Funnl Suite LLC في الإسكندرية، مصر."
>
  <main class="mx-auto max-w-3xl px-6 py-16 md:py-20">
    <h1 class="font-display text-3xl font-bold tracking-tight text-zinc-900">عن AdFunnl</h1>

    <div class="mt-12 space-y-10">
      {SECTIONS.map((section) => (
        <section>
          <h2 class="text-lg font-semibold text-zinc-900">{section.title}</h2>
          {section.body && <p class="mt-2 text-[15px] leading-relaxed text-zinc-600">{section.body}</p>}
          {section.title === "التواصل" && (
            <p class="mt-2 text-[15px] leading-relaxed text-zinc-600">
              لأي سؤال عن الخدمة أو بياناتك، تواصل معنا على{" "}
              <a href={`mailto:${SUPPORT_EMAIL}`} class="text-brand-700 underline">{SUPPORT_EMAIL}</a>.
            </p>
          )}
        </section>
      ))}
    </div>
  </main>
</Layout>
