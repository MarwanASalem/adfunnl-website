    ],
  },
  counts: {
    heading: "ما الذي يُحتسب",
    body: "الحسابات الجديدة التي تُنشأ عبر رابطك. لا يُحتسب فريقك ولا مساحات العمل التي يعمل فيها فريقك بالفعل، والدفعة المستردة تُخصم عمولتها.",
    termsLink: "اقرأ شروط برنامج الشركاء",
  },
  faq: {
    heading: "أسئلة تسألها الوكالات أولًا",
    items: [
      { q: "هل يحصل البراند الذي أجلبه على خصم؟", a: "لا. يدفع السعر المعتاد، وعمولتك لا تُخصم من فاتورته." },
      { q: "أستخدم AdFunnl بالفعل. هل أستطيع الانضمام؟", a: "نعم. سجّل الدخول بحسابك وقدّم طلبك من هناك." },
      { q: "من يمكنه التقديم؟", a: "مالك مساحة العمل على AdFunnl أو أحد مسؤوليها. تنضم الوكالة كلها، لا شخص واحد." },
      { q: "كيف أستلم أرباحي؟", a: "بتحويل بنكي أو عبر InstaPay، بالجنيه المصري. تضيف بياناتك في صفحة الشريك داخل التطبيق." },
    ],
  },
  closing: {
    heading: "اجلب براندًا واربح لمدة عام",
    body: "التقديم يأخذ دقائق. نراجع كل طلب ونراسلك بالبريد عند قبولك.",
    cta: "قدّم على البرنامج",
  },
};
---

<Layout
  locale="ar"
  title="برنامج الشركاء"
  seoTitle="برنامج شركاء AdFunnl"
  description="تربح الوكالات وMedia Buyers نسبة 10% مما يدفعه كل عميل جديد يجلبونه داخل التطبيق لمدة 12 شهرًا، بتحويل بنكي أو عبر InstaPay."
  schema={[faqPage(copy.faq.items)]}
>
  <AffiliatePage copy={copy} termsHref="/ar/terms#affiliates" />
</Layout>
