---
// Arabic twin of src/pages/affiliates.astro. Keep the two in step: a change to
// one page's copy or markup belongs in the other. The brief and the rules for
// this page live in the English page.
import Layout from "../../layouts/Layout.astro";
import AffiliatePage from "../../components/AffiliatePage.astro";
import type { Copy } from "../../components/AffiliatePage.astro";
import { faqPage } from "../../data/plans";

const copy: Copy = {
  hero: {
    heading: "اربح 10% مما يدفعه كل براند تجلبه",
    body: "للوكالات وMedia Buyers. شارك رابطك، واربح 10% مما يدفعه كل عميل جديد داخل التطبيق، بالبطاقة أو المحفظة، خلال أول 12 شهرًا، تصلك على حسابك البنكي أو InstaPay.",
    cta: "قدّم على البرنامج",
  },
  steps: {
    heading: "كيف يعمل البرنامج",
    items: [
      { title: "قدّم طلبك", body: "سجّل الدخول أو أنشئ حسابًا مجانيًا، وأخبرنا عن وكالتك. نقرأ كل طلب.", chip: "تم إرسال الطلب" },
      { title: "شارك رابطك", body: "بعد قبولك تحصل على رابط خاص بك. أي براند ينشئ حسابًا جديدًا على AdFunnl من خلاله يُحتسب لك.", chip: "app.adfunnl.com/signup?aff=" },
