---
import Layout from "../../layouts/Layout.astro";
import PlatformIcon from "../../components/PlatformIcon.astro";
import AdControlSafety from "../../components/AdControlSafety.astro";

const APP_URL = "https://app.adfunnl.com";

// Arabic twin of /ai-ad-control. The brief, the objections and the capability
// warnings live in the English page's frontmatter and apply here unchanged.
// Media-buying terms stay in English (docs/voice.md section 7). The approval
// screen in the app is English only, so its checkbox is quoted in English.
// Percentages are written out in words, so no symbol jumps sides in RTL.

const hero = {
  heading: "أدِر إعلاناتك من الذكاء الاصطناعي الذي تستخدمه بالفعل",
  body: "اطلب من Claude أو ChatGPT إيقاف الإعلانات التي تهدر المال، أو نقل الميزانية إلى الإعلانات الناجحة. يجهّز AdFunnl التغيير كخطة، ولا يحدث شيء قبل أن توافق عليه في المحادثة.",
  chat: {
    ask: "زِد ميزانية حملة TikTok الأعلى في ROAS بنسبة 20 في المئة.",
    tool: "set_ad_budget",
    cardTitle: "تغيير ميزانية واحدة",
    item: "Website sales · Tiffin Co.",
    from: "EGP 1,500",
    to: "EGP 1,800",
    perDay: "يوميًا",
    approve: "موافقة",
    connected: "AdFunnl متصل",
  },
};

// ── Us versus them (R12) ──────────────────────────────────────────────
const compare = {
  heading: "وجدت المشكلة في دقيقة، لكن إصلاحها ما زال يحتاج تبويبًا لكل منصة",
  body: "إيقاف إعلانين على منصتين يعني تسجيل الدخول مرتين والتنقل بين قائمتين مختلفتين، مع احتمال في كل مرة أن توقف الصف الخطأ. اطلب ذلك من مساعدك بدلًا من هذا، فيعود إليك التغيير في قائمة واحدة لتراجعها.",
  oldLabel: "الطريقة المعتادة",
  nowLabel: "من Claude أو ChatGPT",
  rows: [
    {
      job: "إيقاف الإعلانات التي تهدر المال",
      old: "تفتح كل منصة، وتبحث عن كل إعلان، وتوقفه واحدًا تلو الآخر.",
      now: "تطلب مرة واحدة، فتعود إليك كل الإعلانات التي سيوقفها في قائمة واحدة لتوافق عليها.",
    },
    {
      job: "نقل الميزانية إلى إعلان ناجح",
      old: "تحسب الرقم الجديد، ثم تكتبه في كل حملة.",
      now: "تحدد المقدار، وأي زيادة تتجاوز 50 في المئة تُعلَّق ما لم تطلبها صراحةً.",
    },
    {
      job: "اختبار جمهور جديد",
      old: "تنسخ المجموعة الإعلانية، وتعدّل الاستهداف، ثم تتأكد أنها لم تبدأ العمل.",
      now: "تطلبه داخل الحملة الجارية، والمجموعة الإعلانية الجديدة تبدأ متوقفة.",
    },
    {
      job: "الإطلاق من فيديوهات جديدة",
      old: "تنزّلها من Drive، وترفعها إلى المنصة، وتبني الحملة يدويًا.",
      now: "تشير إلى مجلد Drive، فتُبنى الحملة متوقفة وجاهزة لمراجعتك.",
    },
  ],
};

// ── What it can change, per platform ──────────────────────────────────
type Cell = boolean | string;
const platforms = [
  { name: "Meta", key: "meta", status: "تجريبي" },
  { name: "TikTok", key: "tiktok", status: "متاح" },
  { name: "Snapchat", key: "snapchat", status: "متاح" },
  { name: "Google", key: "google_ads", status: "تجريبي" },
];
const table = {
  heading: "ما الذي يمكنه تغييره على كل منصة",
  body: "متاح يعني أنها مكتملة. تجريبي يعني أنها تعمل اليوم وما زالت تُضاف إليها إجراءات جديدة.",
  live: "متاح",
  rows: [
    { label: "إيقاف وتشغيل الحملات والمجموعات الإعلانية والإعلانات", cells: [true, true, true, "الحملات فقط"] },
    { label: "تعديل الميزانيات", cells: [true, true, true, "الحملات فقط"] },
    { label: "النسخ وإعادة التسمية والحذف", cells: [true, true, true, false] },
    { label: "تعديل الجمهور المستهدف", cells: [true, true, true, false] },
    { label: "تعديل نصوص الإعلانات ووسوم تتبع الروابط", cells: [true, true, true, false] },
    { label: "إطلاق حملات جديدة من Google Drive", cells: ["early", true, true, false] },
    { label: "إضافة إعلانات جديدة إلى حملات جارية", cells: ["early", true, true, false] },
    { label: "تحويل المنشورات الحالية إلى إعلانات", cells: ["early", true, false, false] },
    { label: "إعلانات الكتالوج وإعلانات الاتصال", cells: [false, false, true, false] },
    { label: "القواعد التلقائية وجدولة الميزانيات والجماهير", cells: [true, false, false, false] },
  ] as { label: string; cells: Cell[] }[],
  yes: "نعم",
  no: "لا",
  early: "وصول مبكر",
  footnote: "وصول مبكر على Meta: متاح لبعض الحسابات بينما تراجع Meta صلاحية تحتاجها هذه الإجراءات.",
};

// ── Things you can ask ────────────────────────────────────────────────
const examples = {
  heading: "أمثلة لما يمكنك طلبه",
  items: [
    "أوقف كل إعلان صرف أكثر من 1,000 هذا الأسبوع دون أي عملية شراء.",
    "زِد ميزانية حملة TikTok الأعلى في ROAS بنسبة 20 في المئة.",
    "أنشئ حملة مبيعات على Snapchat من الفيديوهات في مجلد Drive هذا، بميزانية 500 يوميًا، واتركها متوقفة.",
    "انسخ أفضل إعلان لديّ إلى المجموعات الإعلانية الثلاث الخاصة بالـ retargeting.",
    "اختبر جمهورًا جديدًا من 25 إلى 34 عامًا داخل حملة TikTok الجارية.",
    "أضف وسوم UTM لكل الإعلانات في هذا الحساب.",
  ],
};

const steps = {
  heading: "كيف يعمل",
  items: [
    { title: "اربط مرة واحدة", body: "أضِف AdFunnl إلى Claude أو ChatGPT وسجّل الدخول بحسابك في AdFunnl. أبقِ خانة \"Also allow it to make changes\" محددة في شاشة الموافقة." },
    { title: "اطلب بكلماتك", body: "يقرأ مساعدك الأرقام المباشرة في AdFunnl ويجهّز التغيير كخطة." },
    { title: "وافق عليه", body: "ترى بالضبط ما سيتغير. وافق في المحادثة فيُنفَّذ التغيير ويُسجَّل في سجل التغييرات الخاص بالعلامة التجارية." },
  ],
};

const faqs = {
  heading: "أسئلة شائعة",
  items: [
    { q: "هل يمكنه تغيير إعلاناتي دون أن يسألني؟", a: "لا. يعود إليك كل تغيير كخطة أولًا، ولا يُنفَّذ إلا بعد موافقتك في المحادثة." },
    { q: "ماذا يعني تجريبي بالنسبة لـ Meta وGoogle؟", a: "أنها تعمل اليوم على حسابات حقيقية. على Google تشمل الإيقاف والتشغيل والميزانيات على مستوى الحملات. وعلى Meta بعض الإجراءات في مرحلة الوصول المبكر، وهي موضحة في الجدول أعلاه. وما زالت إجراءات جديدة تُضاف إلى المنصتين." },
    { q: "ما المساعدات التي يعمل معها؟", a: "Claude وChatGPT، وأي مساعد ذكاء اصطناعي آخر يمكنه الاتصال بخادم MCP." },
    { q: "هل يمكنني ربطه للقراءة فقط؟", a: "نعم. ألغِ تحديد خانة \"Also allow it to make changes\" في شاشة الموافقة، وسيكتفي بقراءة أرقامك." },
    { q: "هل يرى فريقي ما الذي غيّره؟", a: "نعم. يُسجَّل كل تغيير يجريه في سجل التغييرات الخاص بالعلامة التجارية، مع ما تغيّر ومتى." },
    { q: "ما الباقات التي تشمله؟", a: "تشمله باقتا Growth وAgency. وفي باقة Solo هو إضافة بسعر 500 جنيه أو 10 دولارات شهريًا، فوق إضافة AI بسعر 390 جنيهًا أو 8 دولارات. وهو غير متاح خلال الفترة التجريبية المجانية." },
  ],
};

const closing = {
  heading: "ابدأ بحساب واحد",
  body: "التحكم في الإعلانات متاح في Growth وAgency. وفي Solo يمكنك إضافته مقابل 500 جنيه أو 10 دولارات شهريًا فوق إضافة AI.",
  pricing: "اطّلع على الأسعار",
};
---

<Layout
  locale="ar"
  title="التحكم في الإعلانات بالـ AI"
  seoTitle="أدِر إعلاناتك من Claude أو ChatGPT · AdFunnl"
  description="اربط AdFunnl بـ Claude أو ChatGPT واطلب منه إيقاف الإعلانات أو نقل الميزانية أو إطلاق حملات. كل تغيير ينتظر موافقتك."
>

  <!-- ============================== HERO ============================== -->
  <section class="relative overflow-hidden bg-white px-6 pt-14 pb-16 sm:pt-16">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_60%_50%_at_50%_-10%,#e6e1fb,transparent)]"></div>
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[1fr_1fr]">
      <div>
        <h1 class="font-display text-4xl font-bold tracking-tight text-zinc-950 sm:text-5xl">{hero.heading}</h1>
        <p class="mt-5 text-lg leading-relaxed text-zinc-500">{hero.body}</p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {platforms.map((p) => (
            <li class="inline-flex items-center gap-1.5 rounded-full border border-zinc-200 bg-white px-3 py-1 text-xs font-semibold text-zinc-700">
              <PlatformIcon platform={p.key} class="h-3.5 w-3.5" />{p.name}
              {p.status !== table.live && <span class="rounded bg-brand-50 px-1.5 py-px text-[10px] font-bold text-brand-700">{p.status}</span>}
            </li>
          ))}
        </ul>
        <a href={`${APP_URL}/signup`}
           class="mt-8 inline-block w-full rounded-xl bg-brand-600 px-7 py-3.5 text-center text-base font-semibold text-white shadow-lg shadow-brand-200 transition hover:bg-brand-700 sm:w-auto">
          ابدأ مجانًا
        </a>
      </div>

      <!-- A request, the plan it comes back with, and the approval -->
      <div class="rounded-2xl border border-zinc-200 bg-white shadow-2xl shadow-brand-900/10">
        <div class="flex items-center gap-2 border-b border-zinc-100 bg-zinc-50 px-4 py-2.5 text-[11px] font-medium text-zinc-500">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>{hero.chat.connected}
        </div>
        <div class="space-y-4 p-5">
          <p class="ms-auto w-fit max-w-[85%] rounded-2xl bg-zinc-100 px-3.5 py-2.5 text-sm leading-relaxed text-zinc-800">{hero.chat.ask}</p>
          <div class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-zinc-50 px-2.5 py-1.5 text-xs font-medium text-zinc-500">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 17l6-6-6-6M12 19h8"/></svg>
            <span dir="ltr">AdFunnl · {hero.chat.tool}</span>
          </div>
          <div class="rounded-xl border border-zinc-200 p-4">
            <p class="text-sm font-semibold text-zinc-900">{hero.chat.cardTitle}</p>
            <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
              <PlatformIcon platform="tiktok" class="h-4 w-4 shrink-0" />
              <span class="text-zinc-700" dir="ltr">{hero.chat.item}</span>
              <span class="tabular-nums lining-nums text-zinc-500" dir="ltr">{hero.chat.from} → <strong class="font-semibold text-zinc-900">{hero.chat.to}</strong></span>
              <span class="text-zinc-500">{hero.chat.perDay}</span>
            </div>
            <span class="mt-4 inline-block rounded-md bg-zinc-900 px-3 py-1.5 text-xs font-semibold text-white">{hero.chat.approve}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ COMPARISON ============================ -->
  <section class="bg-zinc-50 px-6 py-24">
    <div class="mx-auto max-w-5xl">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">{compare.heading}</h2>
        <p class="mt-4 text-lg leading-relaxed text-zinc-500">{compare.body}</p>
      </div>
      <div class="mt-12 overflow-hidden rounded-2xl border border-zinc-200 bg-white">
        <div class="hidden grid-cols-[1fr_1.2fr_1.2fr] gap-6 border-b border-zinc-200 bg-zinc-50 px-6 py-3 text-xs font-semibold uppercase tracking-wider text-zinc-400 md:grid">
          <span></span><span>{compare.oldLabel}</span><span class="text-brand-700">{compare.nowLabel}</span>
        </div>
        {compare.rows.map((r) => (
          <div class="grid gap-2 border-b border-zinc-100 px-6 py-5 last:border-b-0 md:grid-cols-[1fr_1.2fr_1.2fr] md:gap-6">
            <p class="font-semibold text-zinc-900">{r.job}</p>
            <p class="text-sm leading-relaxed text-zinc-500"><span class="me-1 font-semibold text-zinc-400 md:hidden">{compare.oldLabel}:</span>{r.old}</p>
            <p class="text-sm leading-relaxed text-zinc-800"><span class="me-1 font-semibold text-brand-700 md:hidden">{compare.nowLabel}:</span>{r.now}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================= PER-PLATFORM TABLE ========================= -->
  <section class="bg-white px-6 py-24">
    <div class="mx-auto max-w-5xl">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">{table.heading}</h2>
        <p class="mt-4 text-lg leading-relaxed text-zinc-500">{table.body}</p>
      </div>
      <div class="mt-12 overflow-x-auto rounded-2xl border border-zinc-200">
        <table class="w-full min-w-[640px] text-sm">
          <thead class="bg-zinc-50">
            <tr>
              <th class="px-4 py-3 text-start font-semibold text-zinc-500"></th>
              {platforms.map((p) => (
                <th class="px-3 py-3 text-center font-semibold text-zinc-900">
                  <span class="inline-flex items-center gap-1.5"><PlatformIcon platform={p.key} class="h-4 w-4" />{p.name}</span>
                  <span class:list={[
                    "mt-1 block text-[11px] font-bold",
                    p.status === table.live ? "text-emerald-600" : "text-brand-700",
                  ]}>{p.status}</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {table.rows.map((r) => (
              <tr class="border-t border-zinc-100">
                <th scope="row" class="px-4 py-3 text-start font-medium text-zinc-700">{r.label}</th>
                {r.cells.map((c) => (
                  <td class="px-3 py-3 text-center">
                    {c === true && <span class="text-base font-bold text-emerald-600" aria-label={table.yes}>✓</span>}
                    {c === false && <span class="text-zinc-300" aria-label={table.no}>·</span>}
                    {c === "early" && <span class="text-base font-bold text-amber-600" aria-label={table.early}>✓<sup>*</sup></span>}
                    {typeof c === "string" && c !== "early" && <span class="text-xs font-semibold text-emerald-700">{c}</span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm text-zinc-500"><sup>*</sup> {table.footnote}</p>
    </div>
  </section>

  <!-- ============================= EXAMPLES ============================= -->
  <section class="bg-zinc-50 px-6 py-24">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-center font-display text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">{examples.heading}</h2>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {examples.items.map((e) => (
          <li class="rounded-2xl rounded-ee-sm bg-brand-600 px-5 py-4 text-sm leading-relaxed text-white shadow-sm">{e}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============================ HOW IT WORKS ============================ -->
  <section class="bg-white px-6 py-24">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-center font-display text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">{steps.heading}</h2>
      <ol class="mt-12 grid gap-5 md:grid-cols-3">
        {steps.items.map((s, i) => (
          <li class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-100 font-display text-sm font-bold text-brand-700">{i + 1}</span>
            <p class="mt-4 font-display text-lg font-bold text-zinc-950">{s.title}</p>
            <p class="mt-2 text-sm leading-relaxed text-zinc-500">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- =============================== SAFETY =============================== -->
  <section class="bg-zinc-50 px-6 py-24">
    <AdControlSafety locale="ar" as="h2" class="mx-auto max-w-5xl" />
  </section>

  <!-- ================================ FAQ ================================ -->
  <section class="bg-white px-6 py-24">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-center font-display text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">{faqs.heading}</h2>
      <div class="mt-12 space-y-4">
        {faqs.items.map((f) => (
          <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
            <h3 class="font-display text-lg font-bold text-zinc-950">{f.q}</h3>
            <p class="mt-3 leading-relaxed text-zinc-600">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================================ CTA ================================ -->
  <section class="px-6 py-24">
    <div class="mx-auto max-w-5xl rounded-3xl bg-ink px-6 py-16 text-center sm:py-20">
      <div class="mx-auto max-w-2xl">
        <h2 class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">{closing.heading}</h2>
        <p class="mt-4 text-lg text-zinc-400">{closing.body}</p>
        <div class="mt-9 flex flex-col items-center justify-center gap-5 sm:flex-row">
          <a href={`${APP_URL}/signup`}
             class="w-full rounded-xl bg-brand-600 px-8 py-3.5 text-base font-semibold text-white transition hover:bg-brand-500 sm:w-auto">
            ابدأ مجانًا
          </a>
          <a href="/ar/pricing" class="text-sm font-semibold text-zinc-300 underline-offset-4 hover:text-white hover:underline">{closing.pricing}</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
