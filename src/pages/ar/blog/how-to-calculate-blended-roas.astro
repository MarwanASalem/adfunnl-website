---
import BlogArticle from "../../../components/BlogArticle.astro";
import type { Post } from "../../../data/blog";

// ── Blended ROAS guide (Arabic twin) ──────────────────────────────────────
// Twin of src/pages/blog/how-to-calculate-blended-roas.astro: same brief, same
// sections, same figures. A change to one belongs in the other.
// [[...]] keeps a sum, rate or percentage left to right inside Arabic text.
// Persona names carry a no-break space (Media Buyers), see docs/voice.md 7.
const POST: Post = {
  slug: "how-to-calculate-blended-roas",
  published: "2026-10-15",
  title: "كيف تحسب blended ROAS عبر كل منصاتك الإعلانية",
  seoTitle: "blended ROAS: طريقة حسابه عبر المنصات والعملات",
  description:
    "طريقة حساب blended ROAS عبر Meta وTikTok وSnapchat وGoogle دون أن تُحسب عملية البيع مرتين ودون خلط العملات، مع مثال محلول.",
  lead:
    "المعادلة سطر واحد. الصعب هو المبيعات التي تُحسب مرتين والحسابات التي تنفق بعملات مختلفة، وهذا الدليل يتناول الاثنين.",

  sections: [
    {
      id: "formula",
      heading: "ما هو blended ROAS، وما معادلته",
      blocks: [
        { type: "p", text: "blended ROAS هو الإيرادات التي جلبتها إعلاناتك من كل المنصات، مقسومةً على كل ما أنفقته على تلك المنصات، للفترة نفسها وبعملة واحدة." },
        { type: "formula", text: "blended ROAS = إجمالي الإيرادات ÷ إجمالي الإنفاق الإعلاني" },
        { type: "p", text: "إذا أنفقت 140,000 على Meta وTikTok وSnapchat وGoogle وجلبت 350,000 من الإيرادات، فإن blended ROAS هو 2.50x. الـ ROAS الخاص بكل منصة يخبرك بأداء تلك المنصة وفق حسابها هي، أما blended ROAS فيخبرك بأداء الميزانية كلها." },
      ],
    },
    {
      id: "wrong-number",
      heading: "لماذا يعطيك جمع ROAS كل منصة رقمًا خاطئًا",
      blocks: [
        { type: "p", text: "هناك طريقتان مختصرتان تبدوان صحيحتين، وهما ليستا كذلك." },
        { type: "p", text: "الأولى أن تأخذ متوسط ROAS المنصات. المتوسط يعامل منصة أنفقت عليها 2,000 كما يعامل منصة أنفقت عليها 200,000. يجب أن يكون blended ROAS مرجّحًا بالإنفاق، لذلك تجمع الإنفاق والإيرادات أولًا ثم تقسم مرة واحدة في النهاية." },
        { type: "p", text: "الثانية أصعب في الملاحظة: جمع الإيرادات التي تعلنها كل منصة يحسب بعض المبيعات مرتين. كل منصة تنسب لنفسها أي عملية بيع لمستها ضمن الـ attribution window الخاصة بها. العميل الذي شاهد فيديو على TikTok يوم الأحد ثم ضغط على إعلان في Meta يوم الثلاثاء قبل أن يشتري قد يظهر كعملية شراء في Ads Manager وفي TikTok معًا. اجمع الرقمين وستُحسب تلك الطلبية مرتين. وكلما زاد عدد المنصات التي تعمل عليها، اتسع المجال للتداخل." },
      ],
    },
    {
      id: "platform-or-store",
      heading: "إيرادات المنصات أم إيرادات المتجر: على أيهما تقسم؟",
      blocks: [
        { type: "p", text: "يمكنك ملء الجزء العلوي من المعادلة بطريقتين، وكل منهما تجيب عن سؤال مختلف." },
        { type: "p", text: "**إيرادات المنصات** هي مجموع ما تعلنه كل منصة إعلانية. تجدها لكل حساب وتنقسم حسب المنصة والحملة، لكنها تبالغ كلما تقاسمت المنصات الفضل في عملية البيع نفسها." },
        { type: "p", text: "**إيرادات المتجر** هي ما حصّله متجرك على Shopify أو سلة أو Zid فعلًا خلال الفترة نفسها. كل طلبية تُحسب مرة واحدة، فلا يوجد حساب مزدوج. لكنها تبالغ في الاتجاه الآخر، لأنها تشمل مبيعات لم يلمسها أي إعلان: العملاء العائدون، والبريد الإلكتروني، والبحث الطبيعي." },
        { type: "p", text: "استخدم إيرادات المنصات لمقارنة المنصات والحملات ببعضها، واستخدم إيرادات المتجر لتعرف هل تغطي الميزانية كلها نفسها. وحين يظهر الرقمان على الشاشة نفسها، راقب الفجوة بينهما: إذا ارتفعت إيرادات المنصات ولم ترتفع إيرادات المتجر، فالمنصات تنسب لنفسها المزيد من المبيعات ذاتها." },
      ],
    },
    {
      id: "worked-example",
      heading: "مثال محلول بثلاث عملات",
      blocks: [
        { type: "p", text: "لنفترض أن علامة تجارية تشغّل Meta بالجنيه المصري، وTikTok بالريال السعودي، وGoogle بالدولار الأمريكي، وترفع تقاريرها للعميل بالدولار. في هذا المثال، اعتبر أن [[1 USD = 50 EGP]] و[[1 USD = 3.75 SAR]]." },
        {
          type: "table",
          head: ["المنصة", "العملة", "الإنفاق", "الإيرادات", "ROAS", "الإنفاق بالدولار", "الإيرادات بالدولار"],
          rows: [
            ["Meta", "EGP", "250,000", "1,000,000", "4.00x", "5,000", "20,000"],
            ["TikTok", "SAR", "15,000", "45,000", "3.00x", "4,000", "12,000"],
            ["Google", "USD", "10,000", "15,000", "1.50x", "10,000", "15,000"],
          ],
          foot: ["الإجمالي", "USD", "", "", "", "19,000", "47,000"],
        },
        { type: "p", text: "blended ROAS هنا هو **[[47,000 ÷ 19,000 = 2.47x]]**." },
        { type: "p", text: "والطريقتان المختصرتان تعطيان نتيجتين مختلفتين من الأرقام نفسها:" },
        {
          type: "list",
          items: [
            { lead: "متوسط أرقام ROAS الثلاثة يعطي 2.83x.", text: "رقم Google الضعيف، 1.50x، يُحسب كثلث النتيجة، بينما يحمل Google أكثر من نصف الإنفاق." },
            { lead: "جمع الأرقام الخام دون تحويل يعطي [[1,060,000 ÷ 275,000 = 3.85x]].", text: "الجنيهات المصرية تطغى على كل شيء آخر. هذا هو الخطأ الذي يسهل أن يفوتك، لأن الناتج يبدو معقولًا." },
          ],
        },
        { type: "p", text: "إذا حصّل المتجر 38,000 دولار خلال الفترة نفسها، فإن store ROAS هو **[[38,000 ÷ 19,000 = 2.00x]]**. المنصات مجتمعةً تنسب لنفسها 9,000 أكثر مما حصّله المتجر، أي أن بعض المبيعات نفسها تُنسب لأكثر من منصة." },
      ],
    },
    {
      id: "exchange-rate",
      heading: "أي سعر صرف تستخدم، ومتى",
      blocks: [
        { type: "p", text: "داخل الحساب الواحد، سعر الصرف لا يغيّر ROAS: الإنفاق والإيرادات يُحوَّلان بالرقم نفسه. ما يغيّره السعر هو الوزن الذي يحمله كل حساب داخل blended ROAS. في المثال، ضعف الجنيه يقلّص حصة Meta من الإنفاق بالدولار ويسحب blended ROAS نحو TikTok وGoogle." },
        { type: "p", text: "خياراتك:" },
        {
          type: "list",
          items: [
            { lead: "سعر يوم الإنفاق نفسه.", text: "الأدق، والأصعب في المتابعة يدويًا." },
            { lead: "سعر واحد للفترة كلها،", text: "مثل متوسط الشهر. سهل الشرح للعميل." },
            { lead: "سعر ثابت متفق عليه مسبقًا،", text: "وغالبًا هو السعر الذي خُططت عليه الميزانية. يُبقي المقارنة بين الشهور مستقرة حين تتحرك العملة بقوة." },
            { lead: "سعر اليوم.", text: "الأبسط، لكن أرقام الشهور الماضية تتغير كلما تحركت العملة." },
          ],
        },
        { type: "p", text: "أيًّا كان اختيارك، حوّل الإنفاق والإيرادات بالسعر نفسه، وحافظ على الطريقة نفسها من تقرير إلى الذي يليه. يحوّل AdFunnl بسعر السوق الحالي الذي يُحدَّث كل بضع ساعات، ويتيح لك تحديد سعرك الخاص لكل عملة من إعدادات لوحة المعلومات. واللقطات الثابتة للتقارير تحفظ ما أرسلته كما هو، فلا يتغير رقم الشهر الماضي بعد أن يراه العميل." },
      ],
    },
    {
      id: "limits",
      heading: "ما لا يخبرك به blended ROAS",
      blocks: [
        {
          type: "list",
          items: [
            { lead: "أي منصة تعمل فعلًا.", text: "رقم مجمّع جيد قد يخفي منصة تخسر خلف أخرى تحقق أداءً جيدًا. اقرأه بجانب أرقام كل منصة." },
            { lead: "هل الإعلانات هي سبب المبيعات.", text: "لا تقيس أيٌّ من الطريقتين ما كان سيُباع دون إعلانات أصلًا. هذا يحتاج إلى اختبار holdout." },
            { lead: "هل حققت ربحًا.", text: "ROAS رقم إيرادات، قبل تكلفة المنتج والشحن والمرتجعات. الـ ROAS عند نقطة التعادل هو 1 مقسومًا على هامش الربح الإجمالي: بهامش [[40%]] تحتاج إلى 2.50x فقط لتغطية الإنفاق الإعلاني." },
          ],
        },
      ],
    },
  ],

  faq: {
    id: "faq",
    heading: "أسئلة يطرحها الـ Media Buyers عن blended ROAS",
    items: [
      { q: "ما هو blended ROAS الجيد؟", a: "يعتمد على هامش ربحك. احسب نقطة التعادل أولًا، 1 مقسومًا على الهامش الإجمالي، وقِس كل شيء عليها. رقم 2.00x يخسر عند هامش [[30%]] ويربح عند [[60%]]." },
      { q: "هل blended ROAS هو نفسه MER؟", a: "قريب منه. MER، أي marketing efficiency ratio، هو عادةً إجمالي إيرادات المتجر مقسومًا على إجمالي الإنفاق التسويقي. أي أنه نسخة blended ROAS المبنية على إيرادات المتجر، مع احتساب كل تكاليف التسويق وليس الإعلانات وحدها." },
      { q: "لماذا يستمر blended ROAS لأمس في التغير؟", a: "تواصل المنصات إضافة التحويلات لأيام بعد النقرة، مع وصول مشتريات متأخرة ضمن الـ attribution window. تعامل مع أرقام آخر بضعة أيام على أنها مبدئية. ولهذا السبب يعيد AdFunnl جلب آخر ثلاثة أيام في كل مزامنة." },
      { q: "كيف أحسب blended ROAS لحملات العملاء المحتملين؟", a: "دون رقم للإيرادات لا يمكنك ذلك. استخدم بدلًا منه blended CPL: إجمالي الإنفاق الإعلاني مقسومًا على إجمالي العملاء المحتملين، بقواعد العملة نفسها." },
    ],
  },

  close: {
    id: "close",
    heading: "blended ROAS في لوحة واحدة",
    body: "يربط AdFunnl منصات Meta وTikTok وSnapchat وGoogle بمتجرك على Shopify أو سلة أو Zid، ويحوّل كل الحسابات إلى عملة تقارير واحدة، ويعرض blended ROAS وstore ROAS بجانب أرقام كل منصة. ابدأ بحساب واحد، ثم أضف البقية.",
  },
};
---

<BlogArticle post={POST} locale="ar" />
