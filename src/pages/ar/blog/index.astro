---
import Layout from "../../../layouts/Layout.astro";
import { POSTS } from "../../../data/blog";

// ── Blog index (Arabic twin) ──────────────────────────────────────────────
// Twin of src/pages/blog/index.astro. Lists every post in src/data/blog.ts.
const page = {
  heading: "المدونة",
  intro: "أدلة للـ Media Buyers ومسوّقي الأداء عن قياس الإعلانات وكتابة تقاريرها عبر Meta وTikTok وSnapchat وGoogle.",
  readLabel: "اقرأ الدليل",
};

const SITE = "https://www.adfunnl.com";
const fmtDate = (iso: string) =>
  new Intl.DateTimeFormat("ar-EG-u-nu-latn", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })
    .format(new Date(`${iso}T00:00:00Z`));

const schema = [
  {
    "@type": "Blog",
    "@id": `${SITE}/ar/blog#blog`,
    name: "مدونة AdFunnl",
    url: `${SITE}/ar/blog`,
    inLanguage: "ar",
    publisher: { "@id": `${SITE}/#organization` },
    blogPost: POSTS.map((p) => ({ "@id": `${SITE}/ar/blog/${p.slug}#article` })),
  },
];
---

<Layout
  locale="ar"
  title="المدونة"
  seoTitle="مدونة AdFunnl: أدلة للـ Media Buyers ومسوّقي الأداء"
  description="أدلة للـ Media Buyers ومسوّقي الأداء عن قياس الإعلانات وكتابة تقاريرها عبر Meta وTikTok وSnapchat وGoogle."
  schema={schema}
>
  <main class="mx-auto max-w-3xl px-6 pt-12 pb-20 sm:pt-16">
    <h1 class="font-display text-4xl font-bold tracking-tight text-zinc-950 sm:text-5xl">{page.heading}</h1>
    <p class="mt-5 text-lg leading-relaxed text-zinc-500">{page.intro}</p>

    <ul class="mt-12 divide-y divide-zinc-100 border-y border-zinc-100">
      {POSTS.map((p) => (
        <li class="py-8">
          <time datetime={p.published} class="text-sm text-zinc-400">{fmtDate(p.published)}</time>
          <h2 class="mt-2 font-display text-2xl font-bold tracking-tight text-zinc-950">
            <a href={`/ar/blog/${p.slug}`} class="hover:text-brand-700 transition">{p.ar.title}</a>
          </h2>
          <p class="mt-3 text-[17px] leading-relaxed text-zinc-600">{p.ar.description}</p>
          <a href={`/ar/blog/${p.slug}`} class="mt-4 inline-block text-sm font-semibold text-brand-700 hover:underline">{page.readLabel}</a>
        </li>
      ))}
    </ul>
  </main>
</Layout>
