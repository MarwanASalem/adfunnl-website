---
import BlogArticle from "../../../components/BlogArticle.astro";
import type { Post } from "../../../data/blog";

// ── Campaign copy guide (Arabic twin) ─────────────────────────────────────
// Twin of src/pages/blog/launch-one-campaign-on-meta-tiktok-and-snapchat.astro:
// same brief, same sections, same facts. A change to one belongs in the other.
const POST: Post = {
  slug: "launch-one-campaign-on-meta-tiktok-and-snapchat",
  published: "2026-11-25",
  title: "كيف تطلق حملة واحدة على Meta وTikTok وSnapchat بموافقة واحدة",
  seoTitle: "أطلق حملة واحدة على Meta وTikTok وSnapchat بموافقة واحدة",
  description:
    "ابنِ الحملة مرة واحدة، ثم انسخها إلى Meta وTikTok وSnapchat من Claude أو ChatGPT. ما الذي يتغير على كل منصة، والخطوات، وما لا يُنسخ.",
  lead:
    "ابنِ الحملة مرة واحدة على منصة واحدة، ثم اطلب من Claude أو ChatGPT نسخها إلى المنصات الأخرى. يكيّفها AdFunnl لكل منصة، ويعرض عليك خطة واحدة، وينشئ كل النسخ متوقفة بعد موافقة واحدة.",

  sections: [
    {
      id: "rebuild",
      heading: "لماذا تكلّفك إعادة بناء الحملة على كل منصة صباحًا كاملًا",
      blocks: [
        { type: "p", text: "تشغيل العرض نفسه على Meta وTikTok وSnapchat يعني بناءه ثلاث مرات. لكل منصة أسماؤها الخاصة للأهداف، وطريقتها في استهداف الأعمار، ومستوى مختلف للميزانية، فكل إعادة بناء قوائم جديدة وفرصة جديدة لخطأ في أحد الإعدادات." },
        { type: "p", text: "قرار ما يجب أن تكونه الحملة اتخذته مرة واحدة. الساعات تذهب في ترجمة هذا القرار إلى إعدادات كل منصة يدويًا." },
      ],
    },
    {
      id: "changes",
      heading: "ما الذي يتغير عندما تنتقل الحملة بين المنصات",
      blocks: [
        { type: "p", text: "تحتفظ النسخة بالهدف والجمهور والميزانية ونصوص الإعلانات والملفات والرابط، ثم تكيّف كل واحد منها للمنصة التي تنتقل إليها. هذه الحالات التي تحتاج إلى تكييف:" },
        {
          type: "list",
          items: [
            { lead: "العمر.", text: "يستهدف TikTok شرائح عمرية ثابتة، فيُكيَّف النطاق العمري إلى أقرب الشرائح. ولكل منصة أيضًا حد أقصى لعمر البداية، والنطاق الذي يبدأ فوقه يُنزَل ليناسبه." },
            { lead: "الميزانية.", text: "يضع Snapchat الميزانيات على المجموعات الإعلانية لا على الحملة، فتُقسَّم ميزانية الحملة على المجموعات الإعلانية." },
            { lead: "أشكال الإعلانات.", text: "لا يوجد في TikTok إعلان بصورة واحدة، فلا ينتقل إعلان الصورة إلى TikTok. أما الفيديوهات والـ carousel من الصور فتنتقل." },
            { lead: "الأهداف.", text: "المبيعات والزيارات والعملاء المحتملون عبر موقع إلكتروني تنتقل بين المنصات الثلاث. أما الرسائل على WhatsApp أو Messenger فتنتقل بين Meta وTikTok فقط." },
            { lead: "الصفحة والحساب والـ pixel.", text: "لا تُنسخ أبدًا. كل نسخة تستخدم حسابات العلامة التجارية الخاصة على تلك المنصة." },
          ],
        },
        { type: "p", text: "قبل إنشاء أي شيء، تعرض الخطة ما انتقل كما هو، وما تغيّر ليناسب ولماذا، وما تُرك." },
      ],
    },
    {
      id: "steps",
      heading: "خطوة بخطوة، من Claude أو ChatGPT",
      blocks: [
        {
          type: "list",
          items: [
            { lead: "أنشئ الحملة الأولى عبر AdFunnl.", text: "اطلب من مساعدك بناءها على Meta أو TikTok أو Snapchat من ملفاتك على Google Drive. تُنشأ متوقفة." },
            { lead: "اطلب النسخ.", text: "مثلًا: **انسخ هذه الحملة إلى TikTok وSnapchat.** يعرف AdFunnl مسبقًا أي حسابات إعلانية تتبع العلامة التجارية على كل منصة." },
            { lead: "اقرأ الخطة الواحدة.", text: "تعود نسخة كل منصة في رسالة واحدة: الحساب، والميزانية، وكل مجموعة إعلانية بجمهورها، وكل إعلان بملفاته ونصوصه، ومجموع الميزانية اليومية." },
            { lead: "وافق مرة واحدة.", text: "موافقة واحدة تنشئ كل النسخ، كلها متوقفة وجاهزة لتراجعها وتشغّلها. وتُسجَّل كل نسخة في سجل التغييرات الخاص بالعلامة التجارية." },
          ],
        },
        { type: "p", text: "والمساعد داخل AdFunnl يفعل الشيء نفسه، دون أي إعداد لـ Claude أو ChatGPT." },
      ],
    },
    {
      id: "limits",
      heading: "ما لا يُنسخ بعد",
      blocks: [
        {
          type: "list",
          items: [
            { lead: "Google.", text: "النسخ بين Meta وTikTok وSnapchat. حملات Google تُبنى وحدها." },
            { lead: "الحملات المنشأة خارج AdFunnl.", text: "تبدأ النسخة مما وافقت عليه عند إنشاء الحملة عبر AdFunnl، فلا يمكن نسخ حملة بُنيت مباشرة في مدير إعلانات المنصة بهذه الطريقة، ولا حملة أُنشئت عبر AdFunnl قبل 23 نوفمبر 2026." },
            { lead: "المنشورات والـ Creatives التي تعيش على منصة واحدة.", text: "الإعلان المبني من منشور موجود أو من Creative إعلان آخر يبقى مكانه، والخطة تذكر ذلك." },
          ],
        },
      ],
    },
  ],

  faq: {
    id: "faq",
    heading: "أسئلة عن نسخ الحملات بين المنصات",
    items: [
      { q: "هل تبدأ النسخة العمل فورًا؟", a: "لا. لا يُنشأ شيء قبل موافقتك على الخطة، وكل نسخة تُنشأ متوقفة." },
      { q: "هل يمكنني تعديل نسخة قبل الموافقة؟", a: "نعم. اطلب التعديل، مثل ميزانية مختلفة على Snapchat أو استبعاد منصة، فتعود إليك خطة جديدة." },
      { q: "ماذا لو كانت حساباتي الإعلانية بعملات مختلفة؟", a: "تطلب منك الخطة كل ميزانية بعملة الحساب نفسه، فلا يُحوَّل شيء دون علمك." },
      { q: "ما الباقات التي تشمله؟", a: "كل باقة مدفوعة، Solo وGrowth وAgency، والفترة التجريبية المجانية لكل منها، ضمن التحكم في الإعلانات بالـ AI." },
    ],
  },

  close: {
    id: "close",
    heading: "أطلق على كل المنصات من محادثة واحدة",
    body: "اربط AdFunnl بـ Claude أو ChatGPT، أو استخدم المساعد داخل AdFunnl، وابنِ الحملة مرة واحدة. ابدأ بحساب واحد، ثم أضِف الباقي.",
  },
};
---

<BlogArticle post={POST} locale="ar" />
