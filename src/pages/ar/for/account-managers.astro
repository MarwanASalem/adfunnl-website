---
// Arabic twin of src/pages/for/account-managers.astro. Keep the two in step: a change to one
// page's copy or markup belongs in the other. Media-buying and technical
// terms stay in English, see the Arabic section of docs/voice.md.
//
import Layout from "../../../layouts/Layout.astro";
import DataFlow from "../../../components/DataFlow.astro";

const APP_URL = "https://app.adfunnl.com";

// ── The stakeholder pressure map ──────────────────────────────────────
// Four people, four different asks, four different places they arrive from.
// `channel` carries the vernacular of the job, and it does most of the
// recognition work, so keep it concrete when adding to this list.
const stakeholders = [
  {
    role: "العميل",
    channel: "WhatsApp · 11:04 مساءً",
    wants: "أن يعرف كيف تسير أمواله. الآن، لا في أول الشهر.",
    costs: "كل سؤال يتحول إلى أمسيتك.",
    icon: `<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>`,
  },
  {
    role: "المؤسس",
    channel: "يمر على مكتبك · بعد الظهر",
    wants: "الصورة الكاملة لكل الحسابات مباشرةً، دون أن يطلب من أحد تجميعها.",
    costs: "حين يسأل، يترك أحدهم ما في يده.",
    icon: `<path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/>`,
  },
  {
    role: "الـ Team Lead",
    channel: "اجتماع المتابعة · الإثنين",
    wants: "أن تُكتشف المشاكل قبل أن يكتشفها العميل.",
    costs: "اجتماعات لا هدف لها إلا كشف ما كان يجب أن تُظهره شاشة.",
    icon: `<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>`,
  },
  {
    role: "الـ Media Buyer",
    channel: "Slack · «ممكن بسرعة…»",
    wants: "أن يُترك ليركّز على تحسين الحملات.",
    costs: "إعادة بناء العروض نفسها والإجابة عن الأسئلة نفسها مرتين.",
    icon: `<path d="M12 20V10M18 20V4M6 20v-4"/>`,
  },
];

// ── Pain points ───────────────────────────────────────────────────────
// `when` is the recognition hook: a moment, not a category.
const moments = [
  {
    when: "الأسبوع الأول من الشهر",
    body: "العرض التقديمي يأخذ منك معظم الأسبوع. يتصفحه العميل في أربع دقائق ويسأل سؤالًا واحدًا لا يجيب عنه.",
  },
  {
    when: "الثلاثاء، بين تقريرين",
    body: "يصل سؤال لا يغطيه أي تقرير مجدول. بعد ثلاثة تبويبات وملفين مصدَّرين وساعة كاملة، تصل إلى رقم لست متأكدًا منه تمامًا.",
  },
  {
    when: "11:47 مساءً",
    body: "ترسل لقطة شاشة على WhatsApp، لأن إرسالها كان أسرع فعلًا من إرسال التقرير الحقيقي.",
  },
  {
    when: "مكانان وإجابتان",
    body: "المقياس نفسه يظهر بقيمة في العرض التقديمي وبقيمة أخرى في المنصة. لا يلاحظ أحد غيرك، وأنت من سيشرح الفرق.",
  },
  {
    when: "منذ صباح أمس",
    body: "حملة تستنزف الميزانية منذ يوم ونصف. تكتشفها بعد ظهر اليوم، ويصبح الحديث عن سبب تأخرك في اكتشافها.",
  },
  {
    when: "أسبوع استقبال العميل",
    body: "يوقّع عميل جديد، ولا تصبح التقارير حقيقية قبل أسبوعين. أول انطباع يأخذه عنك رسالة «نعمل على الأمر».",
  },
];

// ── What changes ──────────────────────────────────────────────────────
// Every claim here maps to a shipped capability. Do not add one that doesn't.
const changes = [
  {
    title: "رابط واحد بدل أمسية كاملة",
    body: "لوحات مباشرة للعميل للعرض فقط. دون تسجيل دخول أو وصول إلى حساباتك الإعلانية، وأنت تختار بالضبط العناصر الظاهرة فيها.",
    answers: "إجابة للعميل",
    icon: `<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>`,
  },
  {
    title: "تقارير تبني نفسها",
    body: "ابنِ القالب مرة واحدة، ويمتلئ تلقائيًا من البيانات المباشرة كل شهر. صدّره PDF حين يصر العميل على ملف، لكن الملف نتيجة جانبية وليس هو العمل.",
    answers: "بديل العرض التقديمي",
    icon: `<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>`,
  },
  {
    title: "مساحة واحدة لكل المنصات",
    body: "Meta وTikTok وSnapchat وGoogle مع الإجماليات المدمجة. المقارنة التي يريدها العملاء فعلًا لم تعد مهمة جداول.",
    answers: "إجابة للمؤسس",
    icon: `<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/>`,
  },
  {
    title: "نسخة واحدة من الأرقام",
    body: "يرى العميل الأرقام نفسها التي يراها الـ Media Buyer. لا تعارض بين نسخ عليك حله، ولا اجتماع لتحديد أي ملف كان صحيحًا.",
    answers: "إجابة للـ Media Buyer",
    icon: `<path d="M20 6L9 17l-5-5"/>`,
  },
  {
    title: "إشارات مبكرة عن الـ Creatives",
    body: "أفضل الإعلانات أداءً، ونسب Hook & Hold، ورصد الـ fatigue الذي ينبّهك إلى إعلان ناجح يتراجع قبل أن تتراجع النتائج.",
    answers: "إجابة للـ Team Lead",
    icon: `<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>`,
  },
  {
    title: "عربي كما يجب",
    body: "تعريب كامل من اليمين إلى اليسار، والرسوم البيانية معه. لا تسميات مترجمة فوق تصميم يُقرأ من اليسار.",
    answers: "إجابة للمنطقة",
    icon: `<path d="M2 5h12"/><path d="M7 2h1"/><path d="m4 14 6-6 2-3"/><path d="M5 8c0 3 2.5 6 7 8"/><path d="m22 22-5-10-5 10"/><path d="M14 18h6"/>`,
  },
];

// ── The internal argument ─────────────────────────────────────────────
const argument = [
  {
    who: "الـ Media Buyer",
    gets: "يتوقف عن إعادة بناء العروض نفسها وعن الإجابة عن السؤال نفسه مرتين. التقارير لم تعد مشكلته.",
  },
  {
    who: "الـ Team Lead",
    gets: "يرى كل الحسابات على شاشة واحدة، فيتحول اجتماع المتابعة من جمع للبيانات إلى اتخاذ قرار.",
  },
  {
    who: "المؤسس",
    gets: "يتابع كل الحسابات مباشرةً، دون أن يسحب أحدًا من عمله ليجمعها.",
  },
];

// ── Roadmap: campaign status & budget control from inside the dashboard ─
const control = [
  { platform: "Meta",     status: "Live" },
  { platform: "TikTok",   status: "Live" },
  { platform: "Snapchat", status: "In progress" },
  { platform: "Google",   status: "In progress" },
];
---

<Layout
  locale="ar"
  title="لـ Account Managers"
  description="أنت من يقف في المنتصف. AdFunnl يمنح الـ Account Managers لوحات مباشرة للعملاء، وتقارير تبني نفسها، ونسخة واحدة من الأرقام عبر Meta وTikTok وSnapchat وGoogle."
>

  <!-- ============================== HERO ============================== -->
  <section class="relative overflow-hidden bg-white px-6 pt-14 pb-16 sm:pt-16">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_70%_55%_at_50%_-15%,#e6e1fb,transparent)]"></div>

    <div class="mx-auto max-w-6xl">
      <nav class="mb-8 flex items-center gap-2 text-sm text-zinc-400">
        <a href="/ar" class="hover:text-zinc-700 transition">الرئيسية</a>
        <span>/</span>
        <span class="text-zinc-400">حسب دورك</span>
        <span>/</span>
        <span class="font-medium text-zinc-700">Account Managers</span>
      </nav>

      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          AdFunnl لـ Account Managers
        </span>

        <h1 class="mt-5 font-display text-4xl font-bold tracking-tight text-zinc-950 sm:text-6xl">
          أنت من يقف<br class="hidden sm:block" /> في المنتصف.
        </h1>

        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-zinc-500">
          كل طرف يريد إجابة مختلفة من الأرقام نفسها، وأنت من عليه أن يقدّمها.
        </p>

        <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href={`${APP_URL}/signup`}
             class="w-full rounded-xl bg-brand-600 px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand-200 transition hover:bg-brand-700 sm:w-auto">
            جرّبه الآن
          </a>
          <a href="#what-changes"
             class="w-full rounded-xl border border-zinc-200 bg-white px-8 py-3.5 text-base font-semibold text-zinc-700 transition hover:bg-zinc-50 sm:w-auto">
            شاهد ما الذي يتغير
          </a>
        </div>
      </div>

      <!-- Hero video -->
      <figure class="hero-video relative mt-14">
        <div class="group relative overflow-hidden rounded-2xl border border-zinc-200/80 bg-ink shadow-2xl shadow-brand-900/20 ring-1 ring-zinc-900/[0.04] sm:rounded-3xl">
          <video
            id="hero-video"
            class="block w-full"
            poster="/video/demo-explainer-poster.jpg"
            preload="metadata"
            autoplay
            muted
            loop
            playsinline
            aria-label="جولة في AdFunnl: ربط المنصات الإعلانية، وبناء لوحة، ومشاركة رابط مباشر مع العميل."
          >
            <source src="/video/demo-explainer.mp4" type="video/mp4" />
            متصفحك لا يدعم تشغيل الفيديو.
            <a href="/video/demo-explainer.mp4" class="underline">شاهد الجولة</a> بدلًا من ذلك.
          </video>

          <!-- Sound toggle: the walkthrough is narrated, so make audio reachable
               without breaking muted autoplay. -->
          <button
            type="button"
            id="hero-video-sound"
            class="absolute bottom-3 end-3 inline-flex items-center gap-2 rounded-lg bg-black/55 px-3 py-2 text-xs font-semibold text-white backdrop-blur-sm transition hover:bg-black/75 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:bottom-4 sm:end-4"
            aria-pressed="false"
          >
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 5L6 9H2v6h4l5 4V5z"/>
              <g data-sound-off><path d="M22 9l-6 6M16 9l6 6"/></g>
              <g data-sound-on class="hidden"><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M18.5 5.5a9 9 0 0 1 0 13"/></g>
            </svg>
            <span data-sound-label>تشغيل الصوت</span>
          </button>
        </div>
      </figure>
    </div>
  </section>

  <!-- ================== THE STAKEHOLDERS (pressure map) ================== -->
  <!-- The emotional core. Four asks branch off a single spine and converge,
       literally, on the person reading the page. -->
  <section class="relative overflow-hidden bg-ink px-6 py-24 sm:py-28">
    <div class="pointer-events-none absolute inset-0 -z-0 bg-[radial-gradient(ellipse_55%_45%_at_50%_0%,rgba(101,73,221,0.28),transparent)]"></div>

    <div class="relative mx-auto max-w-6xl">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-brand-300">أربعة أشخاص، وأنت واحد</p>
        <h2 class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
          كلٌّ يحتاج إجابة مختلفة من الأرقام نفسها
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-zinc-400">
          ليس جمهورًا واحدًا بسؤال واحد، بل أربعة أشخاص يأتون من أماكن مختلفة ويتوقعون أشياء مختلفة، وكلهم يصلون إليك.
        </p>
      </div>

      <!-- The spine -->
      <div class="relative mt-16 sm:mt-20">
        <!-- vertical line + travelling pulses -->
        <div class="pointer-events-none absolute inset-y-0 start-[1.125rem] w-px overflow-hidden lg:start-1/2 lg:-translate-x-1/2" aria-hidden="true">
          <div class="h-full w-full bg-gradient-to-b from-brand-500/10 via-brand-400/50 to-brand-400"></div>
          <span class="spine-pulse"></span>
          <span class="spine-pulse" style="animation-delay:1.6s"></span>
          <span class="spine-pulse" style="animation-delay:3.2s"></span>
        </div>

        <ol class="space-y-8 sm:space-y-10">
          {stakeholders.map((s, i) => (
            <li class="reveal relative ps-12 lg:grid lg:grid-cols-2 lg:gap-x-20 lg:ps-0">
              <!-- node on the spine -->
              <span
                class="absolute start-[1.125rem] top-7 z-10 flex h-[1.375rem] w-[1.375rem] -translate-x-1/2 rtl:translate-x-1/2 items-center justify-center rounded-full border-2 border-brand-400 bg-ink lg:start-1/2"
                aria-hidden="true"
              >
                <span class="h-1.5 w-1.5 rounded-full bg-brand-300"></span>
              </span>

              <div class={i % 2 === 0 ? "lg:col-start-1" : "lg:col-start-2 lg:row-start-auto"}>
                <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-6 backdrop-blur-sm transition hover:border-brand-400/40 hover:bg-white/[0.07] sm:p-7">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-600 text-white">
                      <svg class="h-4.5 w-4.5" style="width:1.125rem;height:1.125rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
                    </span>
                    <h3 class="font-display text-xl font-bold tracking-tight text-white">{s.role}</h3>
                    <span class="rounded-md border border-white/10 bg-white/5 px-2 py-0.5 text-[11px] font-medium text-zinc-400">{s.channel}</span>
                  </div>

                  <p class="mt-4 text-lg leading-relaxed text-zinc-200">{s.wants}</p>

                  <div class="mt-5 flex items-start gap-2.5 border-t border-white/10 pt-4">
                    <span class="mt-0.5 shrink-0 text-[10px] font-semibold uppercase tracking-widest text-brand-300">الثمن عليك</span>
                    <p class="text-sm leading-relaxed text-zinc-400">{s.costs}</p>
                  </div>
                </div>
              </div>
            </li>
          ))}

          <!-- The convergence: you. On lg the card is centred on the spine, so
               the node needs headroom above it rather than sitting on top of it. -->
          <li class="reveal relative ps-12 lg:ps-0 lg:pt-20">
            <span
              class="absolute start-[1.125rem] top-7 z-10 flex h-8 w-8 -translate-x-1/2 rtl:translate-x-1/2 items-center justify-center rounded-full bg-brand-600 ring-4 ring-brand-500/25 lg:start-1/2 lg:top-4"
              aria-hidden="true"
            >
              <svg class="h-4 w-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
            </span>

            <div class="mx-auto max-w-3xl rounded-2xl border border-brand-400/40 bg-brand-600 p-7 shadow-2xl shadow-brand-900/40 sm:p-9">
              <h3 class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">وأنت</h3>
              <p class="mt-4 text-lg leading-relaxed text-brand-50">
                تترجم بين الأربعة، من أماكن مختلفة وبصيغ مختلفة، وأنت من يحمل النسخة التي يجب أن تكون صحيحة.
              </p>
            </div>
          </li>
        </ol>
      </div>

      <p class="reveal mx-auto mt-14 max-w-2xl text-center font-display text-xl font-bold leading-snug tracking-tight text-white sm:text-2xl">
        لا أحد غيرك في الوكالة يحملهم جميعًا في وقت واحد.<br class="hidden sm:block" />
        <span class="text-brand-300">هذه الصفحة لك.</span>
      </p>
    </div>
  </section>

  <!-- ============================ PAIN POINTS ============================ -->
  <section class="border-b border-zinc-200/70 bg-cream px-6 py-24">
    <div class="mx-auto max-w-6xl">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-brand-600">تعرف هذه اللحظات جيدًا</p>
        <h2 class="font-display text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">
          ست لحظات من شهر عادي
        </h2>
        <p class="mt-4 text-lg text-zinc-600">
          ليست مشاكل نظرية في سير العمل، بل أيام محددة عشتها.
        </p>
      </div>

      <div class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-zinc-300/50 bg-zinc-300/50 sm:grid-cols-2">
        {moments.map((m) => (
          <div class="reveal bg-cream p-7 transition hover:bg-white sm:p-8">
            <p class="text-[11px] font-semibold uppercase tracking-widest text-brand-600">{m.when}</p>
            <p class="mt-3 leading-relaxed text-zinc-800">{m.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================== WHAT CHANGES =========================== -->
  <section id="what-changes" class="scroll-mt-20 bg-white px-6 py-24">
    <div class="mx-auto max-w-6xl">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-brand-600">ما الذي يتغير</p>
        <h2 class="font-display text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">
          إجابة واحدة تُرضي الأربعة
        </h2>
        <p class="mt-4 text-lg text-zinc-500">
          ليست طريقة أسرع لتجميع الأرقام نفسها، بل إعداد لم يعد فيه التجميع من مهامك.
        </p>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {changes.map((c) => (
          <div class="reveal flex flex-col rounded-2xl border border-zinc-100 bg-zinc-50/60 p-7 transition hover:border-brand-200 hover:bg-brand-50/40">
            <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-brand-600 text-white">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} />
            </div>
            <h3 class="font-display text-lg font-bold text-zinc-950">{c.title}</h3>
            <p class="mt-2.5 flex-1 text-sm leading-relaxed text-zinc-500">{c.body}</p>
            <p class="mt-5 text-[11px] font-semibold uppercase tracking-widest text-brand-600">{c.answers}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== DATA FLOW (animated) =====================
       Same diagram as the homepage; the framing and the terminal node are
       rewritten for this persona: the payoff is that the client self-serves
       rather than that a report gets delivered. -->
  <DataFlow locale="ar"
    sectionClass="relative overflow-hidden border-y border-zinc-100 bg-zinc-50/60 px-6 py-24"
    heading="كل منصاتك تدخل، ورابط واحد يخرج للعميل"
    body="تتدفق بيانات منصاتك الإعلانية ومتجرك باستمرار. AdFunnl يوحّدها ويعايرها، ويُبقي لوحة مباشرة واحدة محدَّثة، ويفتحها عميلك متى شاء. لم تعد خطوة في هذا المسار."
    outLabel="عميلك"
    outSub="يفتحها متى شاء"
    alt="تتدفق البيانات من Meta وGoogle Ads وShopify وTikTok وSnapchat وبوسطة إلى AdFunnl، الذي يوحّدها ويعرضها في لوحة مباشرة واحدة يفتحها العميل بنفسه."
  />

  <!-- ======================= THE INTERNAL ARGUMENT ======================= -->
  <section class="bg-white px-6 pb-24">
    <div class="mx-auto max-w-6xl rounded-3xl border border-zinc-100 bg-zinc-50/70 p-8 sm:p-12">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-brand-600">الإقناع داخل الوكالة</p>
        <h2 class="font-display text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">
          تستفيد من اليوم الأول، وهذا ما يقنع بقية الفريق.
        </h2>
        <p class="mt-4 text-lg text-zinc-500">
          لن تتخذ القرار وحدك، فهذه الحجة لكل شخص ستحتاج إلى موافقته.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {argument.map((a) => (
          <div class="reveal rounded-2xl border border-zinc-200/70 bg-white p-7">
            <p class="font-display text-lg font-bold text-zinc-950">{a.who}</p>
            <p class="mt-2.5 text-sm leading-relaxed text-zinc-500">{a.gets}</p>
          </div>
