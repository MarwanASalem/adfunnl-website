    </div>
  </section>

  <!-- ============================ CLOSING CTA ============================ -->
  <section class="px-6 pb-24">
    <div class="mx-auto max-w-5xl overflow-hidden rounded-3xl bg-ink px-6 py-16 text-center sm:py-20">
      <div class="mx-auto max-w-2xl">
        <h2 class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
          ابدأ بعميل واحد
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-zinc-400">
          اربط منصاته الإعلانية وابنِ اللوحة التي كنت سترسلها له. إن صارت التقارير أسرع والعميل أكثر رضا خلال أسبوعين، أضف البقية. وإن لم يحدث، فقد خسرت بعد ظهر يوم واحد.
        </p>
        <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href={`${APP_URL}/signup`}
             class="w-full rounded-xl bg-brand-600 px-8 py-3.5 text-base font-semibold text-white transition hover:bg-brand-500 sm:w-auto">
            ابدأ مجانًا
          </a>
        </div>
      </div>
    </div>
  </section>

  <style is:global>
    /* Scroll-reveal (only hidden when JS is present to reveal it) */
    .js .reveal { opacity: 0; transform: translateY(26px); transition: opacity .7s ease, transform .7s cubic-bezier(.2,.7,.2,1); }
    .js .reveal.in { opacity: 1; transform: none; }

    /* Hero entrance: CSS-only so above-the-fold content never depends on JS */
    @keyframes heroIn { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
    .hero-video { animation: heroIn .8s cubic-bezier(.2,.7,.2,1) both; animation-delay: .1s; }

    /* Stakeholder spine: pressure travelling down toward "you" */
    .spine-pulse {
      position: absolute;
      left: 0;
      top: 0;
      display: block;
      width: 100%;
      height: 22%;
      background: linear-gradient(to bottom, transparent, #b0a1ef, transparent);
      animation: spineTravel 4.8s cubic-bezier(.55,0,.45,1) infinite;
    }
    @keyframes spineTravel {
      0%        { transform: translateY(-120%); opacity: 0; }
      12%       { opacity: 1; }
      88%       { opacity: 1; }
      100%      { transform: translateY(560%); opacity: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
      .reveal, .hero-video, .spine-pulse { animation: none !important; transition: none !important; }
      .js .reveal { opacity: 1 !important; transform: none !important; }
      .spine-pulse { display: none; }
    }
  </style>

  <script>
    document.documentElement.classList.add("js");
    const rm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // ── Scroll reveal ──────────────────────────────────────────────
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
      }
    }, { threshold: 0.15 });
    document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

    // ── Hero video ─────────────────────────────────────────────────
    const video = document.getElementById("hero-video");
    const soundBtn = document.getElementById("hero-video-sound");

    if (video instanceof HTMLVideoElement) {
      // Reduced motion: don't loop a moving picture at someone unprompted.
      if (rm) {
        video.autoplay = false;
        video.loop = false;
        video.controls = true;
        video.pause();
      }

      if (soundBtn) {
        const label = soundBtn.querySelector("[data-sound-label]");
        const iconOn = soundBtn.querySelector("[data-sound-on]");
        const iconOff = soundBtn.querySelector("[data-sound-off]");

        const paint = () => {
          const on = !video.muted;
          soundBtn.setAttribute("aria-pressed", String(on));
          if (label) label.textContent = on ? "كتم الصوت" : "تشغيل الصوت";
          iconOn?.classList.toggle("hidden", !on);
          iconOff?.classList.toggle("hidden", on);
          // Native controls carry their own volume button, and ours would sit
          // on top of them, so it only exists while they're hidden.
          soundBtn.classList.toggle("hidden", video.controls);
        };

        soundBtn.addEventListener("click", () => {
          video.muted = !video.muted;
          if (!video.muted) {
            // Sound means they're watching it properly: stop looping,
            // hand over the real controls, and start from the top.
            video.loop = false;
            video.controls = true;
            video.currentTime = 0;
            video.play().catch(() => {});
          }
          paint();
        });

        paint();
      }
    }
  </script>

</Layout>
