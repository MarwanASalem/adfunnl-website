// Arabic twin of src/pages/for/media-buyers.astro. Keep the two in step: a change to one
// page's copy or markup belongs in the other. Media-buying and technical
// terms stay in English, see the Arabic section of docs/voice.md.
//
import Layout from "../../../layouts/Layout.astro";
import DataFlow from "../../../components/DataFlow.astro";

const APP_URL = "https://app.adfunnl.com";

// ── This page's pains and objections ──────────────────────────────────
// Kept here on purpose (R11 to R13 in docs/voice.md): the page is built from
// this list, so a later edit cannot quietly turn it back into a feature tour.
//
// The brief:
//   Who     A media buyer who is in the ad accounts all day. Not the account
//           manager fielding the client, not the lead running a roster.
//   Promise You can carry twice the clients without any of them getting less
//           of you, because the assembling is gone.
//   Action  ابدأ مجانًا.
//
// A media buyer's pains, in their order of size:
//   1. The morning goes into collecting, before a single decision gets made.
//   2. Each platform takes credit for the same sale, so true return is a guess.
//   3. The winning creative is buried somewhere in a thousand running ads.
//   4. Interruptions: every "how is it going" costs a rebuilt view.
//
// CAPABILITY WARNINGS for anyone editing this page:
//   - Ad-level creative data is Meta and Snapchat. Not every platform. Do not
//     write "all your creatives" without that qualifier nearby.
//   - Hook and hold is Meta only.
//   - Ad fatigue genuinely does cover every ad platform.
//   - Campaign control is Meta and TikTok. Snapchat and Google are in progress.
//   - There is no media buyer dimension in the app. Grouping is Workspace,
//     then Client, then Ad Account, and every member sees every client. Never
//     imply a per-person view.
//   - R14: never put a number on the platforms. No "four tabs", no "all four".

// ── Hero: the roster on one screen ────────────────────────────────────
// Anonymized demo data, same convention as the homepage and Team Leads mocks.
// ROAS is computed from the two figures beside it, so the arithmetic on screen
// cannot be caught out.
const roster = [
  { client: "عميل A", spend: 41280, revenue: 227040, synced: "قبل 9 دقائق" },
  { client: "عميل B", spend: 28715, revenue: 108117, synced: "قبل 9 دقائق" },
  { client: "عميل C", spend: 19460, revenue: 132328, synced: "قبل 24 دقيقة" },
  { client: "عميل D", spend: 15230, revenue: 51782, synced: "قبل 24 دقيقة" },
  { client: "عميل E", spend: 11905, revenue: 79363, synced: "قبل 41 دقيقة" },
  { client: "عميل F", spend: 7640, revenue: 22920, synced: "قبل 41 دقيقة" },
];

const fmt = (n: number) => n.toLocaleString("en-US");
const roas = (r: number, s: number) => (r / s).toFixed(2);

const rosterSpend = roster.reduce((a, c) => a + c.spend, 0);
const rosterRevenue = roster.reduce((a, c) => a + c.revenue, 0);

// ── Where the morning goes ────────────────────────────────────────────
// The recognisable pain (R8): a tab per platform, each with its own everything,
// then currency math in somebody's head. Never CSV exports.
const tabs = [
  { name: "Meta Ads Manager", quirk: "تسجيل دخول خاص وattribution window خاصة" },
  { name: "TikTok Ads", quirk: "المقياس نفسه تحت اسم عمود مختلف" },
  { name: "Snapchat Ads", quirk: "منتقي تاريخ آخر لضبط المدة نفسها" },
  { name: "Google Ads", quirk: "التحويلات محسوبة بطريقتها الخاصة مرة أخرى" },
  { name: "Shopify", quirk: "الإيرادات التي تحققت فعلًا، في أداة أخرى" },
  { name: "الجدول", quirk: "حيث تحوّل العملات وتتمنى أن تكون صحيحة" },
];

// ── Us versus them (R12) ──────────────────────────────────────────────
// Rows are jobs a media buyer does, not features. The old column has to read
// as a fair description of their day, because it is theirs.
const compare = [
  {
    job: "معرفة أين ذهبت الأموال فعلًا",
    old: "تبويب لكل منصة، ثم تجمع الأرقام في مكان آخر.",
    now: "كل المنصات في صف واحد، والإجماليات المدمجة تحتها.",
  },
  {
    job: "حساب ما حققته فعلًا",
    old: "كل منصة تنسب البيعة نفسها لنفسها.",
    now: "إيرادات المتجر بجانب الإنفاق الإعلاني، حتى مستوى المنتج والفئة.",
  },
  {
    job: "إدارة حسابات بأكثر من عملة",
    old: "تحويل في رأسك، إلى خلية لا يراجعها أحد.",
    now: "كل شيء موحّد بعملة تقاريرك وبالسعر الصحيح.",
  },
  {
    job: "اختيار الـ Creative الذي تعمل له Scale",
    old: "تتصفح كل منصة على حدة وتعتمد على ذاكرتك.",
    now: "كل إعلان يُقيَّم على ROAS وتكلفة الشراء وCTR معًا، ومرتّب في قائمة واحدة.",
  },
  {
    job: "التقاط إعلان وهو يتراجع",
    old: "تلاحظ حين تهبط النتائج، أي بعد أن يحدث الأمر.",
    now: "متابعة الـ fatigue على كل المنصات الإعلانية، مع تنبيه قبل أن تقوله النتائج.",
  },
  {
    job: "الرد على «كيف تسير الأمور؟»",
    old: "تترك ما في يدك، وتعيد بناء عرض، وتلتقط صورة له، وترسلها.",
    now: "يفتحون رابطًا مباشرًا، ولن تعرف حتى أنهم نظروا.",
  },
  {
    job: "استلام حساب جديد",
    old: "تبني العروض نفسها من الصفر، مرة أخرى.",
    now: "تنسخ القالب الذي صنعته بالفعل. التفكير حدث مرة واحدة.",
  },
];

// ── Best Creatives Calculator ─────────────────────────────────────────
// A recreation of the app's Creatives Analysis report, matching the real
// toolbar, the rank pills and the score badges. Anonymized ads.
//
// The score below is not decorative: `scoreCreatives` is the app's own
// formula from web/src/lib/creative-score.ts, so the ranking and every badge
// on this page are produced the way the product produces them. If the app's
// weights change, change them here too.
type DemoAd = {
  name: string;
  type: "Video" | "Static";
  spend: number;
  ctr: number;
  purchases: number;
  revenue: number;
};

// The ads that clear the minimum spend and get ranked. Deliberately shaped so
// no single ad wins all three metrics: that is the whole point of a composite
// score, and a demo where the same ad tops every column would not show it.
const rankedAds: DemoAd[] = [
  { name: "UGC unboxing, 9:16",    type: "Video",  spend: 7301, ctr: 1.31, purchases: 160, revenue: 51107 },
  { name: "Carousel, bestsellers", type: "Static", spend: 4789, ctr: 0.67, purchases: 88,  revenue: 19156 },
  { name: "Testimonial cutdown",   type: "Video",  spend: 3210, ctr: 0.88, purchases: 66,  revenue: 16050 },
  { name: "Founder to camera",     type: "Video",  spend: 2388, ctr: 0.94, purchases: 61,  revenue: 15522 },
  { name: "Studio product spin",   type: "Video",  spend: 2145, ctr: 0.61, purchases: 24,  revenue: 6435 },
  { name: "Ramadan bundle",        type: "Static", spend: 1830, ctr: 0.93, purchases: 33,  revenue: 8235 },
  { name: "Before and after",      type: "Video",  spend: 1174, ctr: 1.20, purchases: 27,  revenue: 7357 },
  { name: "Review screenshot",     type: "Static", spend: 1180, ctr: 0.55, purchases: 15,  revenue: 3186 },
];

// The tail. A real account is mostly low-spend ads, which is why the minimum
// spend threshold exists and why it defaults to the average: everything here
// is below it and drops out of the ranking. Only spend and type are used, so
// only spend and type are given.
const tailAds = [
  { type: "Static" as const, spend: 688 }, { type: "Video"  as const, spend: 640 },
  { type: "Static" as const, spend: 612 }, { type: "Static" as const, spend: 590 },
  { type: "Video"  as const, spend: 566 }, { type: "Static" as const, spend: 540 },
  { type: "Video"  as const, spend: 512 }, { type: "Static" as const, spend: 498 },
  { type: "Video"  as const, spend: 470 }, { type: "Static" as const, spend: 455 },
  { type: "Static" as const, spend: 430 }, { type: "Video"  as const, spend: 412 },
  { type: "Static" as const, spend: 395 }, { type: "Static" as const, spend: 370 },
  { type: "Video"  as const, spend: 348 }, { type: "Static" as const, spend: 330 },
  { type: "Static" as const, spend: 310 }, { type: "Video"  as const, spend: 288 },
  { type: "Static" as const, spend: 265 }, { type: "Static" as const, spend: 240 },
  { type: "Video"  as const, spend: 215 }, { type: "Static" as const, spend: 180 },
  { type: "Static" as const, spend: 145 },
];

const demoAds = rankedAds;
const allAdCount = rankedAds.length + tailAds.length;
const allAdSpend =
  rankedAds.reduce((s, a) => s + a.spend, 0) + tailAds.reduce((s, a) => s + a.spend, 0);

// The app standardizes each metric across the ads currently in view, then
// weights them. `invert` is for metrics where lower is better.
function standardize(values: number[], invert = false): number[] {
  const min = Math.min(...values);
  const max = Math.max(...values);
  if (max === min) return values.map(() => 0);
  return values.map((v) => {
    const std = (v - min) / (max - min);
    return invert ? 1 - std : std;
  });
}

// Minimum spend defaults to the average spend across the ads in view, so a
// lucky ad with almost no spend cannot take the top of the list.
const avgSpend = allAdSpend / allAdCount;
const inView = demoAds.filter((a) => a.spend >= avgSpend);

const cprs = inView.map((a) => a.spend / a.purchases);
const roases = inView.map((a) => a.revenue / a.spend);
const ctrs = inView.map((a) => a.ctr);

const stdCpr = standardize(cprs, true);
const stdRoas = standardize(roases);
const stdCtr = standardize(ctrs);

const scored = inView
  .map((ad, i) => ({
    ad,
    cpr: cprs[i],
    roas: roases[i],
    score: 0.4 * stdRoas[i] + 0.4 * stdCpr[i] + 0.2 * stdCtr[i],
  }))
  .sort((a, b) => b.score - a.score);

const videoCount =
  rankedAds.filter((a) => a.type === "Video").length +
  tailAds.filter((a) => a.type === "Video").length;
const staticCount = allAdCount - videoCount;

// Spend split, video against the total, for the summary strip's bar.
const videoSpendShare = Math.round(
  ((rankedAds.filter((a) => a.type === "Video").reduce((s, a) => s + a.spend, 0) +
    tailAds.filter((a) => a.type === "Video").reduce((s, a) => s + a.spend, 0)) /
    allAdSpend) * 100
);

// How the score is built. Weights verified 19 August 2026 against
// web/src/lib/creative-score.ts.
const scoreWeights = [
  { metric: "ROAS", weight: "40%", note: "ما جلبه الإعلان" },
  { metric: "تكلفة الشراء", weight: "40%", note: "كم كلّفك كل شراء" },
  { metric: "Outbound CTR", weight: "20%", note: "هل نجح الـ Creative" },
];

// The rest of Creatives Analysis. Platform coverage is checked and is not the
// same for all three: see the capability warnings at the top of this file.
const creativeReports = [
  {
    title: "Best Creatives Calculator",
    scope: "Meta وSnapchat",
    body: "كل إعلان فوق الحد الأدنى للإنفاق، مُقيَّم ومرتّب في قائمة واحدة، مع الـ Creative نفسه في الصفحة بدل رقم إعلان تبحث عنه. فلتر حسب المنصة أو الحملة أو الهدف، واقرأه كجدول أو كشبكة من الصور المصغّرة.",
    icon: `<path d="M12 2l2.4 6.9H22l-6.1 4.4 2.3 7-6.2-4.5L5.8 20l2.3-7L2 8.9h7.6z"/>`,
  },
  {
    title: "Hook & Hold Rates",
    scope: "Meta",
    body: "نسب احتفاظ الفيديو، لترى أين يغادر المشاهدون فعلًا. الـ Hook هو الثواني الأولى، والـ Hold هو كل ما بعدها، وتُرتّب لوحة المتصدرين فيديوهاتك على الاثنين.",
    icon: `<path d="M3 12h4l3-8 4 16 3-8h4"/>`,
  },
  {
    title: "Ad Fatigue",
    scope: "كل المنصات الإعلانية",
    body: "التقرير الوحيد الذي يغطيها كلها. الإعلان الرابح يتراجع قبل أن تعترف النتائج بذلك، وهنا يظهر ذلك أولًا، بينما إيقافه ما زال قرارًا لا عملية إنقاذ.",
    icon: `<path d="M12 2v6M12 22v-6"/><path d="M4.9 4.9l4.2 4.2M14.9 14.9l4.2 4.2"/><circle cx="12" cy="12" r="3"/>`,
  },
];

// ── The assistant (R9) ────────────────────────────────────────────────
// Keep these consistent with the `roster` board in the hero: a reader who
// checks one against the other has to find them agreeing.
const assistantAnswer = [
  "blended ROAS على حساباتك 5.00x هذا الأسبوع، مقابل 4.63x الأسبوع الماضي.",
  "عميل C هو الأكثر تغيّرًا: 6.80x بعد 5.24x، مع إنفاق أقل بنسبة 9%.",
  "عميل F هو الأضعف عند 3.00x، وإنفاقه ارتفع 14%.",
];

const assistantSources = ["Meta", "TikTok", "Snapchat", "Google", "Shopify"];

// ── Where the capacity comes from ─────────────────────────────────────
// The promise, made concrete. No invented measurement anywhere in here: the
// argument is about what work each new account adds, not about hours saved.
const capacity = [
  {
    step: "اربط الحساب",
    body: "تُربط المنصات والمتجر مرة واحدة، وتُسحب بيانات آخر 90 يومًا كاملة، فيكون للحساب سجل من يوم استلامه.",
  },
  {
    step: "انسخ القالب",
    body: "ابنِ حسابًا واحدًا بالطريقة التي تريد أن يُقرأ بها أي حساب، واحفظه، وكل حساب بعده يبدأ منه. لن تصمم لوحة من جديد.",
  },
  {
    step: "توقف عن التجميع",
    body: "المزامنة كل ساعة، وتُجلب بيانات آخر ثلاثة أيام من جديد في كل مرة لتصل التحويلات المتأخرة. الشاشة محدَّثة قبل أن تفتحها.",
  },
  {
    step: "أعطِ العميل رابطه الخاص",
    body: "رابط مباشر للعرض فقط عليه شعاره. الأسئلة التي كانت تقاطعك تجد إجاباتها دون أن تصل إليك.",
  },
];

// ── Objections (R13) ──────────────────────────────────────────────────
// What a media buyer says to talk themselves out of starting. Answer honestly
// or delete the row: a weak answer is worse than no section.
const objections = [
  {
    q: "أقضي يومي داخل Ads Manager وأثق به.",
    a: "احتفظ به. Ads Manager هو المكان الذي تبني فيه وتعدّل، ولا شيء هنا يطلب منك التوقف. ما لا يستطيع إخبارك به هو ما فعلته المنصات الأخرى والمتجر، وهو الرقم الذي تقوم عليه قرارات الـ Scale فعلًا.",
  },
  {
    q: "لوحة أخرى تعني شيئًا آخر أحتاج إلى صيانته.",
    a: "لا يوجد ما تصونه. الاتصالات تتزامن كل ساعة وحدها، وتُجلب بيانات آخر ثلاثة أيام من جديد في كل مزامنة، فتصل التحويلات المتأخرة إلى مكانها الصحيح.",
  },
  {
    q: "الأرقام لن تطابق المنصات.",
    a: "لكل مقياس صفحة منهجية منشورة توضّح طريقة حسابه. سجلات البيانات وعمليات المزامنة تُظهر آخر تحديث لكل حساب وهل نجح، واللقطة الثابتة تحفظ ما أرسلته كما هو فلا تتغير أرقام الشهر الماضي.",
  },
  {
    q: "التقارير ليست من عملي.",
    a: "صحيح، وهذا بالضبط سبب استخدامه. العميل يفتح رابطه المباشر، والـ Team Lead يقرأ الشاشة نفسها التي تقرؤها، فتتوقف الأسئلة عن مقاطعة يومك.",
  },
  {
    q: "إعداد هذا سيأخذ أسبوعًا لا أملكه.",
    a: "حساب واحد، مبني كما يجب، ومحفوظ كقالب. كل ما بعده ربط ونسخ.",
  },
];

// ── Roadmap: campaign status & budget control from inside the dashboard ─
const control = [
  { platform: "Meta", status: "Live" },
  { platform: "TikTok", status: "Live" },
  { platform: "Snapchat", status: "In progress" },
  { platform: "Google", status: "In progress" },
];
---

<Layout
  locale="ar"
  title="لـ Media Buyers"
  description="كل منصة إعلانية وكل متجر على شاشة واحدة، مع تقييم الـ Creatives وترتيبها، ليذهب يوم الـ Media Buyer إلى التحليل بدل جمع الأرقام."
>

  <!-- ============================== HERO ============================== -->
  <section class="relative overflow-hidden bg-ink px-6 pt-14 pb-20 sm:pt-16">
    <div class="pointer-events-none absolute inset-0 -z-0 bg-[radial-gradient(ellipse_65%_50%_at_50%_-10%,#422a96,transparent)]"></div>
    <div class="pointer-events-none absolute inset-0 -z-0 opacity-[0.06] [background-image:linear-gradient(#fff_1px,transparent_1px),linear-gradient(90deg,#fff_1px,transparent_1px)] [background-size:44px_44px]"></div>

    <div class="relative mx-auto max-w-6xl">
      <nav class="mb-8 flex items-center gap-2 text-sm text-white/40">
        <a href="/ar" class="transition hover:text-white/80">الرئيسية</a>
        <span>/</span>
        <span>حسب دورك</span>
        <span>/</span>
        <span class="font-medium text-white/80">Media Buyers</span>
      </nav>

      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs font-semibold text-brand-200">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V10M18 20V4M6 20v-4"/></svg>
          AdFunnl لـ Media Buyers
        </span>

        <h1 class="mt-5 font-display text-4xl font-bold tracking-tight text-white sm:text-6xl">
          ضعف عدد العملاء،<br class="hidden sm:block" /> دون أن يقل نصيب أيٍّ منهم منك.
        </h1>

        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-white/60">
          الساعات التي تذهب في تجميع الأرقام هي سبب عجزك عن استلام حساب إضافي. هذا العمل يكون منجزًا قبل أن تجلس إلى مكتبك.
        </p>

        <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href={`${APP_URL}/signup`}
             class="w-full rounded-xl bg-brand-600 px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand-900/40 transition hover:bg-brand-500 sm:w-auto">
            ابدأ مجانًا
          </a>
          <a href="#creatives"
             class="w-full rounded-xl border border-white/15 bg-white/5 px-8 py-3.5 text-base font-semibold text-white/90 transition hover:bg-white/10 sm:w-auto">
            شاهد ترتيب الـ Creatives
          </a>
        </div>
      </div>

      <!-- Roster board: every client already current -->
      <figure class="mt-14">
        <div class="overflow-hidden rounded-2xl border border-white/10 bg-white/[0.04] shadow-2xl shadow-black/40 backdrop-blur-sm sm:rounded-3xl">
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 px-5 py-4">
            <div class="flex items-center gap-2.5">
              <span class="flex h-2 w-2 rounded-full bg-emerald-400"></span>
              <span class="text-sm font-semibold text-white">حساباتك</span>
              <span class="rounded-full bg-white/10 px-2 py-0.5 text-[11px] font-medium text-white/60">مزامنة كل ساعة</span>
            </div>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-white/50">
              <span>الإنفاق <span class="font-semibold text-white/90">SAR {fmt(rosterSpend)}</span></span>
              <span>الإيرادات <span class="font-semibold text-white/90">SAR {fmt(rosterRevenue)}</span></span>
              <span>Blended ROAS <span class="font-semibold text-brand-200"><bdi dir="ltr">{roas(rosterRevenue, rosterSpend)}×</bdi></span></span>
            </div>
          </div>

          <div class="grid gap-px bg-white/[0.06] sm:grid-cols-2 lg:grid-cols-3">
            {roster.map((c) => (
              <div class="bg-ink/60 px-5 py-4">
                <div class="flex items-baseline justify-between">
                  <span class="text-sm font-semibold text-white">{c.client}</span>
                  <span class="font-display text-lg font-bold text-brand-200"><bdi dir="ltr">{roas(c.revenue, c.spend)}×</bdi></span>
                </div>
                <div class="mt-2 flex items-center justify-between text-[11px] text-white/40">
                  <span>إنفاق SAR {fmt(c.spend)}</span>
                  <span>آخر تحديث {c.synced}</span>
                </div>
                <div class="mt-2.5 h-1 overflow-hidden rounded-full bg-white/10">
                  <div class="h-full rounded-full bg-brand-400" style={`width:${Math.min(100, (c.revenue / c.spend) * 14)}%`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>
        <figcaption class="mt-4 text-center text-xs text-white/35">
