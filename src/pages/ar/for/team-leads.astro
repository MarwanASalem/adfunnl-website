  <!-- ===================== DATA FLOW (animated) =====================
       Placed after the objections on purpose: how it works only matters
       once the reader has accepted that the problem is worth solving (R11). -->
  <DataFlow locale="ar"
    sectionClass="relative overflow-hidden border-y border-zinc-100 bg-white px-6 py-24"
    heading="كل المنصات تدخل، وعرض مباشر واحد يخرج"
    body="تتدفق بيانات المنصات الإعلانية والمتجر لكل حساب باستمرار. AdFunnl يوحّدها ويعايرها بالطريقة نفسها في كل مرة، فيصبح حسابان يديرهما شخصان مختلفان قابلين للمقارنة فعلًا، ويقرأ الـ Media Buyer وأنت والعميل الشاشة نفسها."
    outLabel="شاشة واحدة"
    outSub="للفريق كله"
    alt="تتدفق البيانات من Meta وGoogle Ads وShopify وTikTok وSnapchat وبوسطة إلى AdFunnl، الذي يوحّدها ويعرضها على شاشة مباشرة واحدة يشاركها الفريق والعميل."
  />

  <!-- ========================== ROLLING IT OUT ========================== -->
  <section class="bg-white px-6 py-24">
    <div class="mx-auto max-w-6xl">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-brand-600">خطوات التطبيق</p>
