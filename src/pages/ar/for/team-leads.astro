              <p class="text-sm leading-relaxed text-zinc-500">{row.old}</p>
            </div>

            <div class="flex items-start gap-2.5">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
              <p class="text-sm font-medium leading-relaxed text-zinc-800">{row.now}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================= CREATIVE DECISIONS ========================= -->
  <section class="bg-white px-6 py-24">
    <div class="mx-auto max-w-6xl">
      <div class="reveal grid items-start gap-12 lg:grid-cols-2">
        <div>
          <h2 class="font-display text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">
