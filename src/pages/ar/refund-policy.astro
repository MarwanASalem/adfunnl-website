---
// Arabic twin of src/pages/refund-policy.astro. Keep the two in step: a change
// to one page's copy or markup belongs in the other. Media-buying and
// technical terms stay in English, see the Arabic section of docs/voice.md.
//
import Layout from "../../layouts/Layout.astro";

const SUPPORT_EMAIL = "support@adfunnl.com";

// ── سياسة الاسترداد ─────────────────────────────────────────────────
// See the English page for where this policy comes from and what to update
// with it.
const LAST_UPDATED = "آخر تحديث: أكتوبر 2026";

// City and country only, on purpose: the full street address isn't published.
const ADDRESS = "Funnl Suite LLC، الإسكندرية، مصر";

type Section = { title: string; body: string[] };

const SECTIONS: Section[] = [
  {
    title: "طريقة الدفع",
    body: [
      "تُدفع الباقات المدفوعة مقدمًا، شهريًا أو سنويًا. تتم مدفوعات البطاقات والمحافظ عبر مزوّد الدفع Paymob. تظهر الأسعار في صفحة الخطط قبل الدفع.",
    ],
  },
  {
    title: "استرداد أول دفعة",
    body: [
      "يمكن استرداد أول دفعة لمساحة العمل كاملةً خلال 7 أيام من الدفع. افتح صفحة الخطط في AdFunnl واختر «استرداد المبلغ»، أو راسلنا على support@adfunnl.com.",
      "تعود مساحة العمل إلى الباقة المجانية فور تأكيد الاسترداد، ويتوقف التجديد التلقائي. تبقى بياناتك ولوحات المعلومات كما هي.",
    ],
  },
  {
    title: "التجديدات والترقيات والدفعات اللاحقة",
    body: [
      "لا يمكن استرداد التجديدات والترقيات وأي دفعة بعد الأولى من التطبيق. إذا كنت تعتقد أن إحداها خُصمت بالخطأ، راسلنا على support@adfunnl.com وسنراجعها.",
    ],
  },
  {
    title: "الإلغاء",
    body: [
      "يمكنك إيقاف التجديد التلقائي أو إزالة بطاقتك المحفوظة في أي وقت من صفحة الخطط. تستمر باقتك بعدها حتى نهاية الفترة التي دفعت ثمنها، ولا يُخصم منك أي مبلغ آخر.",
    ],
  },
  {
    title: "متى يصلك المبلغ",
    body: [
      "يُعاد المبلغ إلى البطاقة أو المحفظة التي دفعت بها. تعتمد مدة ظهوره على البنك أو مزوّد المحفظة، وعادةً تستغرق بضعة أيام عمل.",
      "لا يمكن استرداد مدفوعات الكشك (النقدية) عبر Paymob. راسلنا وسنرتّب ذلك.",
    ],
  },
];
---

<Layout
  locale="ar"
  title="سياسة الاسترداد"
  description="متى يمكن استرداد مدفوعات AdFunnl، وكيف تطلب الاسترداد، وكم يستغرق وصول المبلغ إليك."
  noindex
>
  <main class="mx-auto max-w-3xl px-6 py-16 md:py-20">
    <h1 class="font-display text-3xl font-bold tracking-tight text-zinc-900">سياسة الاسترداد</h1>
    <p class="mt-2 text-sm text-zinc-500">{LAST_UPDATED}</p>

    <div class="mt-12 space-y-10">
      {SECTIONS.map((section) => (
        <section>
          <h2 class="text-lg font-semibold text-zinc-900">{section.title}</h2>
          <div class="mt-2 space-y-2">
            {section.body.map((paragraph) => (
              <p class="text-[15px] leading-relaxed text-zinc-600">{paragraph}</p>
            ))}
          </div>
        </section>
      ))}
    </div>

    <div class="mt-12 space-y-1 border-t border-zinc-200 pt-6 text-sm text-zinc-500">
      <p>
        لديك سؤال عن دفعة؟ تواصل معنا على{" "}
        <a href={`mailto:${SUPPORT_EMAIL}`} class="text-brand-700 underline">{SUPPORT_EMAIL}</a>.
      </p>
      <p>{ADDRESS}</p>
    </div>
  </main>
</Layout>
