---
import Layout from "../../layouts/Layout.astro";
import DataFlow from "../../components/DataFlow.astro";

const APP_URL = "https://app.adfunnl.com";

// ── The stakeholder pressure map ──────────────────────────────────────
// Four people, four different asks, four different places they arrive from.
// `channel` carries the vernacular of the job, and it does most of the
// recognition work, so keep it concrete when adding to this list.
const stakeholders = [
  {
    role: "The client",
    channel: "WhatsApp · 11:04pm",
    wants: "To know how their money is doing. Right now, not on the first of the month.",
    costs: "Every question becomes your evening.",
    icon: `<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>`,
  },
  {
    role: "The founder",
    channel: "Walks over · mid-afternoon",
    wants: "The big picture across every account, live, without asking anyone to pull it.",
    costs: "When they ask, someone drops what they're doing.",
    icon: `<path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/>`,
  },
  {
    role: "The team lead",
    channel: "Status meeting · Monday",
    wants: "Problems spotted before the client spots them.",
    costs: "Meetings that exist only to surface what a screen should have shown.",
    icon: `<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>`,
  },
  {
    role: "The media buyer",
    channel: "Slack · “can you just…”",
    wants: "To be left alone to optimise.",
    costs: "Rebuilding the same views and answering the same questions twice.",
    icon: `<path d="M12 20V10M18 20V4M6 20v-4"/>`,
  },
];

// ── Pain points ───────────────────────────────────────────────────────
// `when` is the recognition hook: a moment, not a category.
const moments = [
  {
    when: "First week of the month",
    body: "The deck takes you the better part of a week. The client skims it in four minutes and asks one question it doesn't answer.",
  },
  {
    when: "Tuesday, between reports",
    body: "A question arrives that nothing scheduled covers. Three tabs, two exports and an hour later, you have a number you're only mostly sure of.",
  },
  {
    when: "11:47pm",
    body: "You send a screenshot on WhatsApp, because sending a screenshot was genuinely faster than sending the real report.",
  },
  {
    when: "Two places, two answers",
    body: "The same metric reads differently in the deck and in the platform. Nobody else notices. You're the one who has to explain the difference.",
  },
  {
    when: "Since yesterday morning",
    body: "A campaign has been burning badly for a day and a half. You find it this afternoon, and now the conversation is about why you didn't find it sooner.",
  },
  {
    when: "Onboarding week",
    body: "A new client signs, and reporting isn't real for another two weeks. The first impression they get of you is a holding message.",
  },
];

// ── What changes ──────────────────────────────────────────────────────
// Every claim here maps to a shipped capability. Do not add one that doesn't.
const changes = [
  {
    title: "One link instead of an evening",
    body: "Live, view-only client dashboards. No login, no access to your ad accounts, and you choose exactly which widgets are on it.",
    answers: "Answers the client",
    icon: `<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>`,
  },
  {
    title: "Reports that build themselves",
    body: "Build the template once; it auto-fills from live data each month. Export to PDF when a client insists on a document, but the document is a byproduct, not the work.",
    answers: "Answers the deck",
    icon: `<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>`,
  },
  {
    title: "One canvas, every platform",
    body: "Meta, TikTok, Snapchat and Google with blended totals. The comparison clients actually want stops being a spreadsheet job.",
    answers: "Answers the founder",
    icon: `<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/>`,
  },
  {
    title: "One version of the truth",
    body: "The client sees the same numbers the media buyer sees. No version conflict for you to reconcile, and no meeting to establish whose export was right.",
    answers: "Answers the media buyer",
    icon: `<path d="M20 6L9 17l-5-5"/>`,
  },
  {
    title: "Creative signals that arrive early",
    body: "Best performers, hook-and-hold retention, and fatigue detection that flags a winning ad decaying before the results do.",
    answers: "Answers the team lead",
    icon: `<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>`,
  },
  {
    title: "Arabic, properly",
    body: "Fully localized, right-to-left, charts included. Not a translated label sitting on top of a left-to-right layout.",
    answers: "Answers the region",
    icon: `<path d="M2 5h12"/><path d="M7 2h1"/><path d="m4 14 6-6 2-3"/><path d="M5 8c0 3 2.5 6 7 8"/><path d="m22 22-5-10-5 10"/><path d="M14 18h6"/>`,
  },
];

// ── The internal argument ─────────────────────────────────────────────
const argument = [
  {
    who: "The media buyer",
    gets: "Stops rebuilding the same views and stops answering the same question twice. The reporting layer is somebody else's problem again.",
  },
  {
    who: "The team lead",
    gets: "Sees every account on one screen, so the status meeting stops being a data-gathering exercise and starts being a decision.",
  },
  {
    who: "The founder",
    gets: "Checks every account live, without pulling anyone off work to assemble it.",
  },
];

// ── Roadmap: campaign status & budget control from inside the dashboard ─
const control = [
  { platform: "Meta",     status: "Live" },
  { platform: "TikTok",   status: "Live" },
  { platform: "Snapchat", status: "In progress" },
  { platform: "Google",   status: "In progress" },
];
---

<Layout
  title="For Account Managers"
  description="You're the one in the middle. AdFunnl gives account managers live client dashboards, self-building reports and one version of the truth across Meta, TikTok, Snapchat and Google."
>

  <!-- ============================== HERO ============================== -->
  <section class="relative overflow-hidden bg-white px-6 pt-14 pb-16 sm:pt-16">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_70%_55%_at_50%_-15%,#e6e1fb,transparent)]"></div>

    <div class="mx-auto max-w-6xl">
      <nav class="mb-8 flex items-center gap-2 text-sm text-zinc-400">
        <a href="/" class="hover:text-zinc-700 transition">Home</a>
        <span>/</span>
        <span class="text-zinc-400">AdFunnl For</span>
        <span>/</span>
        <span class="font-medium text-zinc-700">Account Managers</span>
      </nav>

      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          AdFunnl For · Account Managers
        </span>

        <h1 class="mt-5 font-display text-4xl font-bold leading-[1.06] tracking-tight text-zinc-950 sm:text-6xl">
          You're the one<br class="hidden sm:block" /> in the middle.
        </h1>

        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-zinc-500">
          Every stakeholder wants a different answer from the same numbers.
          You're the one who has to give it to them.
        </p>

        <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href={`${APP_URL}/demo`}
             class="w-full rounded-xl bg-brand-600 px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand-200 transition hover:bg-brand-700 sm:w-auto">
            Set up one client with me
          </a>
          <a href="#what-changes"
             class="w-full rounded-xl border border-zinc-200 bg-white px-8 py-3.5 text-base font-semibold text-zinc-700 transition hover:bg-zinc-50 sm:w-auto">
            See what changes
          </a>
        </div>
      </div>

      <!-- Hero video -->
      <figure class="hero-video relative mt-14">
        <div class="group relative overflow-hidden rounded-2xl border border-zinc-200/80 bg-ink shadow-2xl shadow-brand-900/20 ring-1 ring-zinc-900/[0.04] sm:rounded-3xl">
          <video
            id="hero-video"
            class="block w-full"
            poster="/video/demo-explainer-poster.jpg"
            preload="metadata"
            autoplay
            muted
            loop
            playsinline
            aria-label="A walkthrough of AdFunnl: connecting ad platforms, building a dashboard, and sharing a live link with a client."
          >
            <source src="/video/demo-explainer.mp4" type="video/mp4" />
            Your browser doesn't support embedded video.
            <a href="/video/demo-explainer.mp4" class="underline">Watch the walkthrough</a> instead.
          </video>

          <!-- Sound toggle: the walkthrough is narrated, so make audio reachable
               without breaking muted autoplay. -->
          <button
            type="button"
            id="hero-video-sound"
            class="absolute bottom-3 right-3 inline-flex items-center gap-2 rounded-lg bg-black/55 px-3 py-2 text-xs font-semibold text-white backdrop-blur-sm transition hover:bg-black/75 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:bottom-4 sm:right-4"
            aria-pressed="false"
          >
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 5L6 9H2v6h4l5 4V5z"/>
              <g data-sound-off><path d="M22 9l-6 6M16 9l6 6"/></g>
              <g data-sound-on class="hidden"><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M18.5 5.5a9 9 0 0 1 0 13"/></g>
            </svg>
            <span data-sound-label>Play sound</span>
          </button>
        </div>
      </figure>
    </div>
  </section>

  <!-- ================== THE STAKEHOLDERS (pressure map) ================== -->
  <!-- The emotional core. Four asks branch off a single spine and converge,
       literally, on the person reading the page. -->
  <section class="relative overflow-hidden bg-ink px-6 py-24 sm:py-28">
    <div class="pointer-events-none absolute inset-0 -z-0 bg-[radial-gradient(ellipse_55%_45%_at_50%_0%,rgba(101,73,221,0.28),transparent)]"></div>

    <div class="relative mx-auto max-w-6xl">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-brand-300">Four people, one you</p>
        <h2 class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Everyone needs a different answer from the same numbers
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-zinc-400">
          Not one audience with one question. Four people, arriving from four
          different places, expecting four different things, and all four
          of them arrive at you.
        </p>
      </div>

      <!-- The spine -->
      <div class="relative mt-16 sm:mt-20">
        <!-- vertical line + travelling pulses -->
        <div class="pointer-events-none absolute inset-y-0 left-[1.125rem] w-px overflow-hidden lg:left-1/2 lg:-translate-x-1/2" aria-hidden="true">
          <div class="h-full w-full bg-gradient-to-b from-brand-500/10 via-brand-400/50 to-brand-400"></div>
          <span class="spine-pulse"></span>
          <span class="spine-pulse" style="animation-delay:1.6s"></span>
          <span class="spine-pulse" style="animation-delay:3.2s"></span>
        </div>

        <ol class="space-y-8 sm:space-y-10">
          {stakeholders.map((s, i) => (
            <li class="reveal relative pl-12 lg:grid lg:grid-cols-2 lg:gap-x-20 lg:pl-0">
              <!-- node on the spine -->
              <span
                class="absolute left-[1.125rem] top-7 z-10 flex h-[1.375rem] w-[1.375rem] -translate-x-1/2 items-center justify-center rounded-full border-2 border-brand-400 bg-ink lg:left-1/2"
                aria-hidden="true"
              >
                <span class="h-1.5 w-1.5 rounded-full bg-brand-300"></span>
              </span>

              <div class={i % 2 === 0 ? "lg:col-start-1" : "lg:col-start-2 lg:row-start-auto"}>
                <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-6 backdrop-blur-sm transition hover:border-brand-400/40 hover:bg-white/[0.07] sm:p-7">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-600 text-white">
                      <svg class="h-4.5 w-4.5" style="width:1.125rem;height:1.125rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
                    </span>
                    <h3 class="font-display text-xl font-bold tracking-tight text-white">{s.role}</h3>
                    <span class="rounded-md border border-white/10 bg-white/5 px-2 py-0.5 text-[11px] font-medium text-zinc-400">{s.channel}</span>
                  </div>

                  <p class="mt-4 text-lg leading-relaxed text-zinc-200">{s.wants}</p>

                  <div class="mt-5 flex items-start gap-2.5 border-t border-white/10 pt-4">
                    <span class="mt-0.5 shrink-0 text-[10px] font-semibold uppercase tracking-widest text-brand-300">Costs you</span>
                    <p class="text-sm leading-relaxed text-zinc-400">{s.costs}</p>
                  </div>
                </div>
              </div>
            </li>
          ))}

          <!-- The convergence: you. On lg the card is centred on the spine, so
               the node needs headroom above it rather than sitting on top of it. -->
          <li class="reveal relative pl-12 lg:pl-0 lg:pt-20">
            <span
              class="absolute left-[1.125rem] top-7 z-10 flex h-8 w-8 -translate-x-1/2 items-center justify-center rounded-full bg-brand-600 ring-4 ring-brand-500/25 lg:left-1/2 lg:top-4"
              aria-hidden="true"
            >
              <svg class="h-4 w-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
            </span>

            <div class="mx-auto max-w-3xl rounded-2xl border border-brand-400/40 bg-brand-600 p-7 shadow-2xl shadow-brand-900/40 sm:p-9">
              <h3 class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">And you</h3>
              <p class="mt-4 text-lg leading-relaxed text-brand-50">
                You're translating between all four, from four different places,
                in four different formats, and you're the one holding the version
                that has to be correct.
              </p>
            </div>
          </li>
        </ol>
      </div>

      <p class="reveal mx-auto mt-14 max-w-2xl text-center font-display text-xl font-bold leading-snug tracking-tight text-white sm:text-2xl">
        Nobody else in the agency carries all of them at once.<br class="hidden sm:block" />
        <span class="text-brand-300">This page is for you.</span>
      </p>
    </div>
  </section>

  <!-- ============================ PAIN POINTS ============================ -->
  <section class="border-b border-zinc-200/70 bg-cream px-6 py-24">
    <div class="mx-auto max-w-6xl">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-brand-600">You already know these</p>
        <h2 class="font-display text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">
          Six moments from an ordinary month
        </h2>
        <p class="mt-4 text-lg text-zinc-600">
          None of these are workflow problems in the abstract. They're specific
          afternoons you've had.
        </p>
      </div>

      <div class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-zinc-300/50 bg-zinc-300/50 sm:grid-cols-2">
        {moments.map((m) => (
          <div class="reveal bg-cream p-7 transition hover:bg-white sm:p-8">
            <p class="text-[11px] font-semibold uppercase tracking-widest text-brand-600">{m.when}</p>
            <p class="mt-3 leading-relaxed text-zinc-800">{m.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================== WHAT CHANGES =========================== -->
  <section id="what-changes" class="scroll-mt-20 bg-white px-6 py-24">
    <div class="mx-auto max-w-6xl">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-brand-600">What changes</p>
        <h2 class="font-display text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">
          One answer that satisfies all four
        </h2>
        <p class="mt-4 text-lg text-zinc-500">
          Not a faster way to do the same assembly work, but a setup where the
          assembly stops being yours to do.
        </p>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {changes.map((c) => (
          <div class="reveal flex flex-col rounded-2xl border border-zinc-100 bg-zinc-50/60 p-7 transition hover:border-brand-200 hover:bg-brand-50/40">
            <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-brand-600 text-white">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} />
            </div>
            <h3 class="font-display text-lg font-bold text-zinc-950">{c.title}</h3>
            <p class="mt-2.5 flex-1 text-sm leading-relaxed text-zinc-500">{c.body}</p>
            <p class="mt-5 text-[11px] font-semibold uppercase tracking-widest text-brand-600">{c.answers}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== DATA FLOW (animated) =====================
       Same diagram as the homepage; the framing and the terminal node are
       rewritten for this persona: the payoff is that the client self-serves
       rather than that a report gets delivered. -->
  <DataFlow
    sectionClass="relative overflow-hidden border-y border-zinc-100 bg-zinc-50/60 px-6 py-24"
    heading="Four platforms in, one client link out"
    body="Your ad platforms and your store stream in continuously. AdFunnl unifies and normalizes them, keeps one live dashboard current, and your client opens it whenever they want to. You are no longer a step in that path."
    outLabel="Your client"
    outSub="opens it, anytime"
    alt="Data flows from Meta, Google Ads, Shopify, TikTok, Snapchat and Bosta into AdFunnl, which unifies and visualizes it into one live dashboard that the client opens directly."
  />

  <!-- ======================= THE INTERNAL ARGUMENT ======================= -->
  <section class="bg-white px-6 pb-24">
    <div class="mx-auto max-w-6xl rounded-3xl border border-zinc-100 bg-zinc-50/70 p-8 sm:p-12">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-brand-600">The internal argument</p>
        <h2 class="font-display text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">
          You benefit on day one. Here's why it survives internally.
        </h2>
        <p class="mt-4 text-lg text-zinc-500">
          You can't buy this alone, so here's the line for each person whose
          agreement you'll need.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {argument.map((a) => (
          <div class="reveal rounded-2xl border border-zinc-200/70 bg-white p-7">
            <p class="font-display text-lg font-bold text-zinc-950">{a.who}</p>
            <p class="mt-2.5 text-sm leading-relaxed text-zinc-500">{a.gets}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================== ROADMAP NOTE ========================== -->
  <section class="bg-white px-6 pb-24">
    <div class="reveal mx-auto max-w-3xl rounded-2xl border border-zinc-200 bg-white p-7 sm:p-8">
      <div class="flex items-start gap-4">
        <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-zinc-100 text-zinc-500">
          <svg class="h-4.5 w-4.5" style="width:1.125rem;height:1.125rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l2.5 2.5"/></svg>
        </span>
        <div class="min-w-0">
          <h2 class="font-display text-lg font-bold text-zinc-950">Where control stands today</h2>
          <p class="mt-2 text-sm leading-relaxed text-zinc-500">
            Changing campaign status and budgets from inside the dashboard, without
            opening the ad platform, is live for Meta and TikTok. Snapchat and Google
            are in progress. Reporting works across all four today.
          </p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {control.map((c) => (
              <li class:list={[
                "inline-flex items-center gap-1.5 rounded-lg border px-2.5 py-1.5 text-xs font-medium",
                c.status === "Live"
                  ? "border-emerald-200 bg-emerald-50 text-emerald-700"
                  : "border-zinc-200 bg-zinc-50 text-zinc-500",
              ]}>
                {c.status === "Live" ? (
                  <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                ) : (
                  <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l2.5 2.5"/></svg>
                )}
                <span class="font-semibold text-zinc-800">{c.platform}</span>
                <span>· {c.status}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ CLOSING CTA ============================ -->
  <section class="px-6 pb-24">
    <div class="mx-auto max-w-5xl overflow-hidden rounded-3xl bg-ink px-6 py-16 text-center sm:py-20">
      <div class="mx-auto max-w-2xl">
        <h2 class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Pick one client, ideally a demanding one
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-zinc-400">
          We'll set their dashboard up together. If in two weeks reporting is
          faster and the client is happier, we talk about the rest. If not,
          you've lost an afternoon.
        </p>
        <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href={`${APP_URL}/demo`}
             class="w-full rounded-xl bg-brand-600 px-8 py-3.5 text-base font-semibold text-white transition hover:bg-brand-500 sm:w-auto">
            Set up one client with me
          </a>
          <a href={`${APP_URL}/signup`}
             class="w-full rounded-xl border border-white/20 px-8 py-3.5 text-base font-semibold text-white transition hover:bg-white/10 sm:w-auto">
            Start free instead
          </a>
        </div>
      </div>
    </div>
  </section>

  <style is:global>
    /* Scroll-reveal (only hidden when JS is present to reveal it) */
    .js .reveal { opacity: 0; transform: translateY(26px); transition: opacity .7s ease, transform .7s cubic-bezier(.2,.7,.2,1); }
    .js .reveal.in { opacity: 1; transform: none; }

    /* Hero entrance: CSS-only so above-the-fold content never depends on JS */
    @keyframes heroIn { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
    .hero-video { animation: heroIn .8s cubic-bezier(.2,.7,.2,1) both; animation-delay: .1s; }

    /* Stakeholder spine: pressure travelling down toward "you" */
    .spine-pulse {
      position: absolute;
      left: 0;
      top: 0;
      display: block;
      width: 100%;
      height: 22%;
      background: linear-gradient(to bottom, transparent, #b0a1ef, transparent);
      animation: spineTravel 4.8s cubic-bezier(.55,0,.45,1) infinite;
    }
    @keyframes spineTravel {
      0%        { transform: translateY(-120%); opacity: 0; }
      12%       { opacity: 1; }
      88%       { opacity: 1; }
      100%      { transform: translateY(560%); opacity: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
      .reveal, .hero-video, .spine-pulse { animation: none !important; transition: none !important; }
      .js .reveal { opacity: 1 !important; transform: none !important; }
      .spine-pulse { display: none; }
    }
  </style>

  <script>
    document.documentElement.classList.add("js");
    const rm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // ── Scroll reveal ──────────────────────────────────────────────
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
      }
    }, { threshold: 0.15 });
    document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

    // ── Hero video ─────────────────────────────────────────────────
    const video = document.getElementById("hero-video");
    const soundBtn = document.getElementById("hero-video-sound");

    if (video instanceof HTMLVideoElement) {
      // Reduced motion: don't loop a moving picture at someone unprompted.
      if (rm) {
        video.autoplay = false;
        video.loop = false;
        video.controls = true;
        video.pause();
      }

      if (soundBtn) {
        const label = soundBtn.querySelector("[data-sound-label]");
        const iconOn = soundBtn.querySelector("[data-sound-on]");
        const iconOff = soundBtn.querySelector("[data-sound-off]");

        const paint = () => {
          const on = !video.muted;
          soundBtn.setAttribute("aria-pressed", String(on));
          if (label) label.textContent = on ? "Mute" : "Play sound";
          iconOn?.classList.toggle("hidden", !on);
          iconOff?.classList.toggle("hidden", on);
          // Native controls carry their own volume button, and ours would sit
          // on top of them, so it only exists while they're hidden.
          soundBtn.classList.toggle("hidden", video.controls);
        };

        soundBtn.addEventListener("click", () => {
          video.muted = !video.muted;
          if (!video.muted) {
            // Sound means they're watching it properly: stop looping,
            // hand over the real controls, and start from the top.
            video.loop = false;
            video.controls = true;
            video.currentTime = 0;
            video.play().catch(() => {});
          }
          paint();
        });

        paint();
      }
    }
  </script>

</Layout>
