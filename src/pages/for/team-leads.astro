---
import Layout from "../../layouts/Layout.astro";
import DataFlow from "../../components/DataFlow.astro";

const APP_URL = "https://app.adfunnl.com";

// ── Hero board: the bird's-eye view ───────────────────────────────────
// Anonymized demo data (no real client or account), same convention as the
// homepage mocks. Kept internally consistent: the blended row is the sum of
// the platform rows, so nobody can check the arithmetic and find it wrong.
const platforms = [
  { key: "meta",     name: "Meta",     spend: 18824, purchases: 223, revenue: 108976, color: "#0082FB" },
  { key: "snapchat", name: "Snapchat", spend: 7081,  purchases: 120, revenue: 60906,  color: "#F5C518" },
  { key: "tiktok",   name: "TikTok",   spend: 3767,  purchases: 43,  revenue: 21653,  color: "#111111" },
  { key: "google",   name: "Google",   spend: 417,   purchases: 20,  revenue: 10256,  color: "#EA4335" },
];

const totalSpend     = platforms.reduce((a, p) => a + p.spend, 0);
const totalPurchases = platforms.reduce((a, p) => a + p.purchases, 0);
const totalRevenue   = platforms.reduce((a, p) => a + p.revenue, 0);
const blendedRoas    = totalRevenue / totalSpend;

const fmt = (n: number) => n.toLocaleString("en-US");

const blended = [
  { label: "Spend",     value: `SAR ${fmt(totalSpend)}` },
  { label: "Purchases", value: fmt(totalPurchases) },
  { label: "Revenue",   value: `SAR ${fmt(totalRevenue)}` },
  { label: "Blended ROAS", value: `${blendedRoas.toFixed(2)}×`, strong: true },
];

// ── The signature: one routine, two ways ──────────────────────────────
// The gap between the elapsed badges is the argument. Keep those badges
// vague on purpose: a precise figure here would be an invented measurement,
// and precision is what made the old version need a disclaimer under it.
// The pain is tab-switching and currency math, never CSV exports. See R8.
const lanes = [
  {
    key: "today",
    eyebrow: "How the number gets made today",
    elapsed: "Most of a morning, every time.",
    tone: "bad",
    stops: [
      { t: "Tab 1", s: "Meta. Read the numbers, hold them in your head, move on." },
      { t: "Tab 2, 3, 4", s: "TikTok, Snapchat, Google. Each one names the columns differently and counts a conversion over its own window, so none of it lines up." },
      { t: "The maths", s: "One account buys in riyals and bills in dirhams. You are converting as you go, and you are the only check on it." },
      { t: "The report", s: "Then all of it has to become something a client can read, which is where the rest of the day goes." },
    ],
  },
  {
    key: "adfunnl",
    eyebrow: "How it goes with AdFunnl",
    elapsed: "About two minutes.",
    tone: "good",
    stops: [
      { t: "One screen", s: "Every platform side by side, blended, already converted into one currency. Nothing to hold in your head." },
      { t: "The decision", s: "You are straight onto which account needs you today, which is the part you were actually hired for." },
    ],
    note: "There is no step three. The screen was current before you opened it.",
  },
];

// ── Pain points ───────────────────────────────────────────────────────
// The subject of this section is the manual labour of producing a report.
// `when` is the recognition hook: a moment in that job, not a category.
// Each `when` is referenced by an `answers` label in `changes` below, so the
// two lists stay paired. Rename one, rename the other.
const moments = [
  {
    when: "Four tabs, four date pickers",
    body: "Every platform names things differently and counts a conversion over its own window. Getting them to agree is somebody's morning, and it happens again next week.",
  },
  {
    when: "The conversion in your head",
    body: "One account bills in dirhams and buys in riyals. The rate lives in someone's memory or in a corner of a sheet, and nobody has checked it in months.",
  },
  {
    when: "Assembling the deliverable",
    body: "The numbers exist. Turning them into something a client can read is copy, paste, screenshot, format, repeat. None of it is judgment, and all of it takes a day.",
  },
  {
    when: "Old on arrival",
    body: "A report is true for the hour it was made in. The first question the client asks about it is almost always about now.",
  },
  {
    when: "The quiet account",
    body: "Nothing is on fire, so nobody brings it up. It has been drifting gently for three weeks and the first person to notice will be the client.",
  },
  {
    when: "Account number nine",
    body: "Reporting gets rebuilt from scratch, slightly differently, by whoever set it up. No two accounts report the same way.",
  },
];

// ── What changes ──────────────────────────────────────────────────────
// Every claim maps to a shipped capability. Do not add one that doesn't.
const changes = [
  {
    title: "Every platform on one line",
    body: "Meta, TikTok, Snapchat and Google side by side: spend, purchases, ROAS and revenue, with blended totals underneath. The comparison stops being a spreadsheet job.",
    answers: "Answers the four tabs",
    icon: `<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18"/>`,
  },
  {
    title: "Current before you open it",
    body: "Everything syncs hourly, so the screen is live rather than a picture of last Friday. You're not asking anyone to refresh anything first.",
    answers: "Answers old on arrival",
    icon: `<path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v5h-5"/>`,
  },
  {
    title: "One currency, every account",
    body: "Spend and revenue are unified into a single currency, so an account that bills in dirhams and one that bills in riyals are actually comparable without anyone doing the rate in their head.",
    answers: "Answers the conversion in your head",
    icon: `<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/>`,
  },
  {
    title: "The trajectory, not just today",
    body: "Add a “vs. prior” comparison to any tile and see month-over-month movement inline. A quiet account that has been sliding for three weeks looks like what it is.",
    answers: "Answers the quiet account",
    icon: `<path d="M3 3v18h18"/><path d="m7 14 4-4 3 3 5-6"/>`,
  },
  {
    title: "One template, every account",
    body: "Save a layout as an app-wide template so every account reports the same way, and a new client is set up in seconds rather than over a fortnight.",
    answers: "Answers account number nine",
    icon: `<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>`,
  },
  {
    title: "Ask it, instead of building it",
    body: "The assistant sits on every page. Ask which accounts slipped this week, or for a recap of TikTok against Meta this month, and the answer streams back showing the data it used. It also runs as an MCP server, so Claude or ChatGPT can query the same numbers.",
    answers: "Answers assembling the deliverable",
    icon: `<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M8 10h.01M12 10h.01M16 10h.01"/>`,
  },
];

// ── Breadth: the rest of what's on the same screen ────────────────────
const alsoOnScreen = [
  { label: "Creative winners", note: "Ranked creative, plus hook-and-hold retention on video" },
  { label: "Product-level ROAS", note: "Store revenue attributed down to product and category" },
  { label: "Geo maps & funnels", note: "Performance by region, and step-by-step drop-off" },
  { label: "Change annotations", note: "What changed, and the date it changed on" },
  { label: "Live links & PDF", note: "View-only client links, or a document when they insist" },
  { label: "Methodology & snapshots", note: "How every metric is calculated, and a frozen copy of what you sent" },
  { label: "Arabic, right-to-left", note: "Fully localized, charts included" },
];

// ── Rolling it out ────────────────────────────────────────────────────
const rollout = [
  {
    step: "Set up one account properly",
    body: "Build the view the way you actually want an account read, then save it as a template. This is the only part that takes real thought.",
  },
  {
    step: "Clone it across every account",
    body: "Every other account starts from that template, so the whole team reports the same way without a style guide or a meeting about it.",
  },
  {
    step: "Add the team, then the clients",
    body: "Invite buyers as Editors and clients as Viewers. Live share links mean client questions stop landing on your team as interruptions.",
  },
];

// ── Roadmap: campaign status & budget control from inside the dashboard ─
const control = [
  { platform: "Meta",     status: "Live" },
  { platform: "TikTok",   status: "Live" },
  { platform: "Snapchat", status: "In progress" },
  { platform: "Google",   status: "In progress" },
];
---

<Layout
  title="For Team Leads"
  description="Know where every account stands in one look. AdFunnl blends spend, purchases and ROAS across Meta, TikTok, Snapchat and Google onto a single live screen: one currency, one template, one version everyone reads."
>

  <!-- ============================== HERO ============================== -->
  <section class="relative overflow-hidden bg-ink px-6 pt-14 pb-20 sm:pt-16">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_65%_50%_at_50%_-5%,rgba(101,73,221,0.35),transparent)]"></div>

    <div class="relative mx-auto max-w-6xl">
      <nav class="mb-8 flex items-center gap-2 text-sm text-zinc-500">
        <a href="/" class="hover:text-zinc-300 transition">Home</a>
        <span>/</span>
        <span>AdFunnl For</span>
        <span>/</span>
        <span class="font-medium text-zinc-300">Team Leads</span>
      </nav>

      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs font-semibold text-brand-200">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
          AdFunnl For · Team Leads
        </span>

        <h1 class="mt-5 font-display text-4xl font-bold leading-[1.06] tracking-tight text-white sm:text-6xl">
          Know where the account<br class="hidden sm:block" /> stands in one look.
        </h1>

        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-zinc-400">
          Spend, purchases and ROAS across every platform, blended into one
          currency on a single live screen, instead of a report that was already
          out of date when you sent it.
        </p>

        <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href={`${APP_URL}/signup`}
             class="w-full rounded-xl bg-brand-600 px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand-900/40 transition hover:bg-brand-500 sm:w-auto">
            Try it now
          </a>
          <a href="#what-changes"
             class="w-full rounded-xl border border-white/20 px-8 py-3.5 text-base font-semibold text-white transition hover:bg-white/10 sm:w-auto">
            See what changes
          </a>
        </div>
      </div>

      <!-- The bird's-eye board: blended totals first, contributions underneath -->
      <div class="hero-board mx-auto mt-14 max-w-4xl overflow-hidden rounded-2xl border border-white/10 bg-white shadow-2xl shadow-black/50">
        <!-- app top bar -->
        <div class="flex items-center gap-2 border-b border-zinc-100 px-3.5 py-2.5">
          <span class="flex h-5 w-5 items-center justify-center rounded-md bg-brand-600 text-[10px] font-bold text-white">A</span>
          <span class="inline-flex items-center gap-1.5 rounded-md border border-zinc-200 px-2 py-0.5 text-[11px] font-semibold text-zinc-700">
            <span class="flex h-4 w-4 items-center justify-center rounded bg-brand-100 text-[8px] font-bold text-brand-700">AC</span>
            Acme Cosmetics
            <svg class="h-3 w-3 text-zinc-400" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8l4 4 4-4"/></svg>
          </span>
          <span class="ms-1 hidden rounded-md border border-zinc-200 px-2 py-0.5 text-[10px] font-medium text-zinc-500 sm:inline-block">This month</span>
          <span class="ms-auto inline-flex items-center gap-1.5 rounded-md bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-700">
            <span class="live-dot h-1.5 w-1.5 rounded-full bg-emerald-500"></span>Live
          </span>
        </div>

        <!-- blended totals: the glance -->
        <div class="grid grid-cols-2 gap-px bg-zinc-100 sm:grid-cols-4">
          {blended.map((b) => (
            <div class:list={["p-3.5 sm:p-4", b.strong ? "bg-brand-600" : "bg-white"]}>
              <p class:list={["text-[9px] font-semibold uppercase tracking-widest", b.strong ? "text-brand-200" : "text-zinc-400"]}>{b.label}</p>
              <p class:list={["mt-1 font-display text-lg font-bold tracking-tight sm:text-xl", b.strong ? "text-white" : "text-zinc-900"]}>{b.value}</p>
            </div>
          ))}
        </div>

        <!-- per-platform contribution -->
        <div class="border-t border-zinc-100 p-3.5 sm:p-4">
          <div class="mb-2.5 flex items-center justify-between">
            <p class="text-[10px] font-semibold uppercase tracking-widest text-zinc-400">Where it came from</p>
            <p class="hidden text-[10px] text-zinc-400 sm:block">Share of spend</p>
          </div>
          <div class="space-y-1.5">
            {platforms.map((p) => {
              const share = (p.spend / totalSpend) * 100;
              const roas = p.revenue / p.spend;
              return (
                <div class="flex items-center gap-2.5 sm:gap-3">
                  <span class="w-14 shrink-0 text-[11px] font-semibold text-zinc-700 sm:w-16">{p.name}</span>
                  <span class="h-2 flex-1 overflow-hidden rounded-full bg-zinc-100">
                    <!-- max() keeps a genuinely tiny share (Google, ~1%) reading as a
                         small bar rather than a rendering artefact -->
                    <span class="board-bar block h-full rounded-full" style={`width:max(${share.toFixed(1)}%, 8px);background:${p.color}`}></span>
                  </span>
                  <span class="w-16 shrink-0 text-right text-[11px] tabular-nums text-zinc-500 sm:w-20">SAR {fmt(p.spend)}</span>
                  <span class="hidden w-12 shrink-0 text-right text-[11px] tabular-nums text-zinc-500 sm:block">{p.purchases}</span>
                  <span class="w-12 shrink-0 text-right text-[11px] font-bold tabular-nums text-zinc-900">{roas.toFixed(1)}×</span>
                </div>
              );
            })}
          </div>
          <p class="mt-3 text-[10px] text-zinc-400">Four platforms, one currency, no export.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== DATA FLOW (animated) =====================
       Placed high on purpose: it explains where the screen above comes
       from before the page asks the reader to believe anything else. -->
  <DataFlow
    sectionClass="relative overflow-hidden border-b border-zinc-100 bg-white px-6 py-24"
    heading="Every platform in, one live view out"
    body="Each account's ad platforms and store stream in continuously. AdFunnl unifies and normalizes them the same way every time, so two accounts run by two different people are genuinely comparable, and the buyer, you and the client are all reading the same screen."
    outLabel="One screen"
    outSub="for the whole team"
    alt="Data flows from Meta, Google Ads, Shopify, TikTok, Snapchat and Bosta into AdFunnl, which unifies and visualizes it into one live screen shared by the team and the client."
  />

  <!-- ================== THE SIGNATURE: ONE ROUTINE, TWICE ================== -->
  <section class="border-b border-zinc-200/70 bg-cream px-6 py-24">
    <div class="mx-auto max-w-6xl">
      <div class="reveal mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">
          The same morning, twice
        </h2>
        <p class="mt-4 text-lg text-zinc-600">
          Reading four platforms in four tabs is like judging a race by watching
          each runner on a separate screen. You can do it. You just cannot see
          who is winning.
        </p>
      </div>

      <div class="mt-14 space-y-6">
        {lanes.map((lane) => (
          <div class:list={[
            "reveal rounded-2xl border p-6 sm:p-8",
            lane.tone === "bad" ? "border-zinc-300/60 bg-white/50" : "border-brand-200 bg-white shadow-sm",
          ]}>
            <div class="mb-7 flex flex-wrap items-center justify-between gap-3">
              <p class:list={[
                "text-sm font-semibold uppercase tracking-widest",
                lane.tone === "bad" ? "text-zinc-400" : "text-brand-600",
              ]}>{lane.eyebrow}</p>
              <span class:list={[
                "inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold",
                lane.tone === "bad" ? "bg-zinc-200/70 text-zinc-600" : "bg-brand-600 text-white",
              ]}>
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l2.5 2.5"/></svg>
                {lane.elapsed}
              </span>
            </div>

            <ol class="grid gap-7 sm:grid-cols-4 sm:gap-5">
              {lane.stops.map((stop, i) => (
                <li class="relative sm:pt-7">
                  <!-- connector rail (desktop only) -->
                  <span
                    class:list={[
                      "absolute left-0 top-1.5 hidden h-px sm:block",
                      i === lane.stops.length - 1 ? "w-2.5" : "w-[calc(100%+1.25rem)]",
                      lane.tone === "bad" ? "bg-zinc-300" : "bg-brand-200",
                    ]}
                    aria-hidden="true"
                  ></span>
                  <span
                    class:list={[
                      "absolute left-0 top-1.5 hidden h-2.5 w-2.5 -translate-y-1/2 rounded-full sm:block",
                      lane.tone === "bad"
                        ? (i === lane.stops.length - 1 ? "bg-zinc-500" : "bg-zinc-300")
                        : (i === lane.stops.length - 1 ? "bg-brand-600" : "bg-brand-300"),
                    ]}
                    aria-hidden="true"
                  ></span>

                  <p class:list={[
                    "text-xs font-bold uppercase tracking-wider tabular-nums",
                    lane.tone === "bad" ? "text-zinc-500" : "text-brand-600",
                  ]}>{stop.t}</p>
                  <p class="mt-2 text-sm leading-relaxed text-zinc-700">{stop.s}</p>
                </li>
              ))}
            </ol>

            {lane.note && (
              <p class="mt-6 border-t border-zinc-100 pt-5 text-sm italic leading-relaxed text-zinc-400">
                {lane.note}
              </p>
            )}
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ============================ PAIN POINTS ============================ -->
  <section class="bg-white px-6 py-24">
    <div class="mx-auto max-w-6xl">
      <div class="reveal mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">
          Every report is still assembled by hand
        </h2>
        <p class="mt-4 text-lg text-zinc-500">
          Gathering the same numbers off four platforms, reconciling them and
          formatting the result is manual labour that a tool should be doing.
          None of it is the judgment you hired anyone for.
        </p>
      </div>

      <div class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-zinc-200 bg-zinc-200 sm:grid-cols-2">
        {moments.map((m) => (
          <div class="reveal bg-white p-7 transition hover:bg-zinc-50/80 sm:p-8">
            <p class="text-[11px] font-semibold uppercase tracking-widest text-brand-600">{m.when}</p>
            <p class="mt-3 leading-relaxed text-zinc-700">{m.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================== WHAT CHANGES =========================== -->
  <section id="what-changes" class="scroll-mt-20 border-y border-zinc-100 bg-zinc-50/60 px-6 py-24">
    <div class="mx-auto max-w-6xl">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-brand-600">What changes</p>
        <h2 class="font-display text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">
          The overview stops being something you assemble
        </h2>
        <p class="mt-4 text-lg text-zinc-500">
          Not a better spreadsheet. A screen that was already correct before
          anyone went looking for it.
        </p>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {changes.map((c) => (
          <div class="reveal flex flex-col rounded-2xl border border-zinc-200/70 bg-white p-7 transition hover:border-brand-200 hover:shadow-sm">
            <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-brand-600 text-white">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} />
            </div>
            <h3 class="font-display text-lg font-bold text-zinc-950">{c.title}</h3>
            <p class="mt-2.5 flex-1 text-sm leading-relaxed text-zinc-500">{c.body}</p>
            <p class="mt-5 text-[11px] font-semibold uppercase tracking-widest text-brand-600">{c.answers}</p>
          </div>
        ))}
      </div>

      <!-- Breadth: the page shouldn't read as one feature -->
      <div class="reveal mt-6 rounded-2xl border border-zinc-200/70 bg-white p-7 sm:p-8">
        <p class="text-sm font-semibold text-zinc-900">And on the same canvas</p>
        <div class="mt-5 grid gap-x-8 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
          {alsoOnScreen.map((a) => (
            <div class="flex items-start gap-2.5">
              <svg class="mt-1 h-3.5 w-3.5 shrink-0 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
              <p class="text-sm leading-snug text-zinc-600">
                <span class="font-semibold text-zinc-900">{a.label}</span>
                <span class="mt-0.5 block text-xs text-zinc-500">{a.note}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ========================== ROLLING IT OUT ========================== -->
  <section class="bg-white px-6 py-24">
    <div class="mx-auto max-w-6xl">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-brand-600">Rolling it out</p>
        <h2 class="font-display text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">
          Three steps, and only one of them is work
        </h2>
        <p class="mt-4 text-lg text-zinc-500">
          You're the one who'll have to run this rollout, so here's the honest
          shape of it.
        </p>
      </div>

      <ol class="mt-14 grid gap-6 md:grid-cols-3">
        {rollout.map((r, i) => (
          <li class="reveal relative rounded-2xl border border-zinc-100 bg-zinc-50/60 p-7">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-600 font-display text-sm font-bold text-white">{i + 1}</span>
            <h3 class="mt-5 font-display text-lg font-bold text-zinc-950">{r.step}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-zinc-500">{r.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ========================== ROADMAP NOTE ========================== -->
  <section class="bg-white px-6 pb-24">
    <div class="reveal mx-auto max-w-3xl rounded-2xl border border-zinc-200 bg-white p-7 sm:p-8">
      <div class="flex items-start gap-4">
        <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-zinc-100 text-zinc-500">
          <svg style="width:1.125rem;height:1.125rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l2.5 2.5"/></svg>
        </span>
        <div class="min-w-0">
          <h2 class="font-display text-lg font-bold text-zinc-950">Where control stands today</h2>
          <p class="mt-2 text-sm leading-relaxed text-zinc-500">
            Changing campaign status and budgets from inside the dashboard, without
            opening the ad platform, is live for Meta and TikTok. Snapchat and Google
            are in progress. Reporting works across all four today.
          </p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {control.map((c) => (
              <li class:list={[
                "inline-flex items-center gap-1.5 rounded-lg border px-2.5 py-1.5 text-xs font-medium",
                c.status === "Live"
                  ? "border-emerald-200 bg-emerald-50 text-emerald-700"
                  : "border-zinc-200 bg-zinc-50 text-zinc-500",
              ]}>
                {c.status === "Live" ? (
                  <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                ) : (
                  <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l2.5 2.5"/></svg>
                )}
                <span class="font-semibold text-zinc-800">{c.platform}</span>
                <span>· {c.status}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ CLOSING CTA ============================ -->
  <section class="px-6 pb-24">
    <div class="mx-auto max-w-5xl overflow-hidden rounded-3xl bg-ink px-6 py-16 text-center sm:py-20">
      <div class="mx-auto max-w-2xl">
        <h2 class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Start with one account
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-zinc-400">
          Connect one client's platforms and run it for a couple of weeks. Once
          the screen reads the way you want an account read, save it as a
          template and clone it across every brand you manage, until one hub
          holds all of them.
        </p>
        <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href={`${APP_URL}/signup`}
             class="w-full rounded-xl bg-brand-600 px-8 py-3.5 text-base font-semibold text-white transition hover:bg-brand-500 sm:w-auto">
            Try it now
          </a>
          <a href={`${APP_URL}/demo`}
             class="w-full rounded-xl border border-white/20 px-8 py-3.5 text-base font-semibold text-white transition hover:bg-white/10 sm:w-auto">
            Book a demo
          </a>
        </div>
      </div>
    </div>
  </section>

  <style is:global>
    /* Scroll-reveal (only hidden when JS is present to reveal it) */
    .js .reveal { opacity: 0; transform: translateY(26px); transition: opacity .7s ease, transform .7s cubic-bezier(.2,.7,.2,1); }
    .js .reveal.in { opacity: 1; transform: none; }

    /* Hero entrance: CSS-only so above-the-fold content never depends on JS */
    @keyframes heroIn { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
    .hero-board { animation: heroIn .8s cubic-bezier(.2,.7,.2,1) both; animation-delay: .1s; }

    /* Contribution bars fill on load: the glance assembling itself */
    @keyframes barFill { from { transform: scaleX(0); } to { transform: scaleX(1); } }
    .board-bar { transform-origin: left; animation: barFill .9s cubic-bezier(.2,.7,.2,1) both; animation-delay: .5s; }

    /* Ambient live indicator */
    @keyframes livePulse { 0%,100% { opacity: 1; } 50% { opacity: .35; } }
    .live-dot { animation: livePulse 1.6s ease-in-out infinite; }

    @media (prefers-reduced-motion: reduce) {
      .reveal, .hero-board, .live-dot, .board-bar { animation: none !important; transition: none !important; }
      .js .reveal { opacity: 1 !important; transform: none !important; }
      .board-bar { transform: none; }
    }
  </style>

  <script>
    document.documentElement.classList.add("js");

    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
      }
    }, { threshold: 0.15 });
    document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
  </script>

</Layout>
