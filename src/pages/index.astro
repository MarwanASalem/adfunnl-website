---
import Layout from "../layouts/Layout.astro";
import PlatformIcon from "../components/PlatformIcon.astro";
import DataFlow from "../components/DataFlow.astro";
import AnalysisStages from "../components/AnalysisStages.astro";

const APP_URL = "https://app.adfunnl.com";

// ── Live snapshots section (faithful recreations of real app screens) ──
// Pulse: real verdicts are Scale (emerald) / Hold (amber) / Cut (rose).
const pulseRows = [
  { name: "Retargeting · Broad",        key: "meta",       spend: "$3,240", revenue: "$16,900", roas: "5.2×", ctr: "2.4%", verdict: "scale" },
  { name: "Prospecting · Lookalike 3%", key: "tiktok",     spend: "$5,110", revenue: "$14,300", roas: "2.8×", ctr: "1.9%", verdict: "hold"  },
  { name: "Cold · Interest stack",      key: "google_ads", spend: "$2,780", revenue: "$3,900",  roas: "1.4×", ctr: "1.1%", verdict: "cut"   },
  { name: "Story ads · Gen Z",          key: "snapchat",   spend: "$1,960", revenue: "$7,450",  roas: "3.8×", ctr: "2.1%", verdict: "scale" },
];

// Ad-level table widget. The Cost / purchase column carries the green wash that
// stands in for the app's conditional table formatting. Anonymized demo data.
const adRows = [
  { ad: "Reel · Pack it Sunday",       key: "meta",     campaign: "Website sales · Tiffin Co.", spend: "EGP 53,133", purchases: "611", cpp: "EGP 86.96",  roas: "4.81×", photo: "/ad-1.jpg", video: true  },
  { ad: "Reel · Leakproof test",       key: "tiktok",   campaign: "Website sales · Tiffin Co.", spend: "EGP 30,738", purchases: "341", cpp: "EGP 90.14",  roas: "4.35×", photo: "/ad-2.jpg", video: true  },
  { ad: "Static · School lunch set",   key: "snapchat", campaign: "Back to school · Tiffin Co.", spend: "EGP 14,804", purchases: "208", cpp: "EGP 71.17",  roas: "5.62×", photo: "/ad-3.jpg", video: false },
  { ad: "Reel · Bento unboxing",       key: "meta",     campaign: "Website sales · Tiffin Co.", spend: "EGP 10,907", purchases: "119", cpp: "EGP 91.66",  roas: "4.02×", photo: "/ad-4.jpg", video: true  },
  { ad: "UGC · Mum's morning routine", key: "tiktok",   campaign: "Website sales · Tiffin Co.", spend: "EGP 10,730", purchases: "152", cpp: "EGP 70.59",  roas: "5.74×", photo: "/ad-5.jpg", video: true  },
  { ad: "Reel · Keeps food warm 6h",   key: "snapchat", campaign: "Page views · Tiffin Co.",    spend: "EGP 9,056",  purchases: "74",  cpp: "EGP 122.38", roas: "2.91×", photo: "/ad-2.jpg", video: true  },
];

// Best Creatives Calculator: composite score, ranked. Ranks 1-3 get the green
// outline the app uses for its top band.
const bestCreatives = [
  { rank: 1, score: "1.00", name: "IG Post · Leakproof test", campaign: "Website sales · Tiffin Co.",  photo: "/ad-1.jpg", spend: "EGP 5,002",  ctr: "5.21%", purchases: "87",  roas: "24.16×", top: true  },
  { rank: 2, score: "0.42", name: "Reel · Pack it Sunday",    campaign: "Page views · Tiffin Co.",     photo: "/ad-5.jpg", spend: "EGP 9,056",  ctr: "3.14%", purchases: "74",  roas: "6.02×",  top: true  },
  { rank: 3, score: "0.41", name: "UGC · Mum's morning",      campaign: "Website sales · Tiffin Co.",  photo: "/ad-4.jpg", spend: "EGP 10,730", ctr: "2.25%", purchases: "152", roas: "5.74×",  top: true  },
  { rank: 4, score: "0.40", name: "Reel · Bento unboxing",    campaign: "Back to school · Tiffin Co.", photo: "/ad-3.jpg", spend: "EGP 7,272",  ctr: "3.46%", purchases: "96",  roas: "5.33×",  top: false },
  { rank: 5, score: "0.40", name: "Static · School set",      campaign: "Back to school · Tiffin Co.", photo: "/ad-2.jpg", spend: "EGP 4,938",  ctr: "5.22%", purchases: "68",  roas: "5.11×",  top: false },
];

// Spend vs. store revenue. The maths has to hold:
// 53,133 + 30,738 + 14,804 + 9,056 = 107,731, and 517,109 / 107,731 = 4.80×.
const storeSpend = [
  { name: "Meta",       key: "meta",       amount: "EGP 53,133" },
  { name: "TikTok",     key: "tiktok",     amount: "EGP 30,738" },
  { name: "Snapchat",   key: "snapchat",   amount: "EGP 14,804" },
  { name: "Google Ads", key: "google_ads", amount: "EGP 9,056"  },
];

// ── Audience breakdowns: real app screenshots, privacy toggle on ──
// Breakdowns come from Meta and Snapchat only (docs/what-ships.md, checked
// 10 September 2026), which is why the body names them. The headline opens
// with the reader's problem, see R11 in docs/voice.md. An age chart goes into
// `shots` next to gender and device once the corrected screenshot is in.
const breakdowns = {
  heading: "How long would it take you to see your breakdowns?",
  body: "Age, gender, device and location show you who your ads reach and who actually buys. In the ad platform you get them one campaign at a time, one breakdown at a time, then export and stitch the files together. Connect your accounts and AdFunnl adds them up across all your Meta and Snapchat campaigns, already drawn as charts.",
  shots: [
    { src: "/screens/breakdown-location.png", w: 1481, h: 391, wide: true, alt: "AdFunnl geo map widget shading ad spend by region across Egypt, darkest around Cairo." },
    { src: "/screens/breakdown-gender.png",   w: 725,  h: 387, wide: false, alt: "AdFunnl donut chart of Meta purchases by gender: male, female and unknown." },
    { src: "/screens/breakdown-device.png",   w: 722,  h: 386, wide: false, alt: "AdFunnl bar chart of Meta purchases and cost per purchase by device, from iPhone and Android phones to desktop and tablets." },
  ],
};

// ── Data analysis stages: Google's six, animated in AnalysisStages ──
// Heading and body are Hussein's wording. Prepare and Process are automated
// sync and normalization, NOT AI: the app only uses AI in the assistant, the
// MCP server and the dashboard builder (checked 10 September 2026). Keep AI
// out of those two stages. owner: "you" | "auto" | "ai".
const analysisStages = {
  heading: "How much time are you spending gathering data instead of analyzing it?",
  body: "Data analysis passes through 6 stages. Preparing and processing is the slow part 🫠 this is where you open many tabs, take many screenshots, do mental math trying to normalize all currencies, export data and import it into sheets to analyze and filter. Instead, your time should focus on actually asking, analyzing, and acting.",
  slowLabel: "The slow part 🫠",
  stages: [
    { key: "ask",     name: "Ask",     owner: "you",  line: "Decide what you need to know, like which campaign deserves more budget." },
    { key: "prepare", name: "Prepare", owner: "auto", line: "Every ad platform and store connects once, then syncs every hour." },
    { key: "process", name: "Process", owner: "auto", line: "Every platform's numbers are normalized and converted into your reporting currency, so blended ROAS adds up." },
    { key: "analyze", name: "Analyze", owner: "ai",   line: "Dashboards build from live data, and the AI assistant answers questions about it in plain language." },
    { key: "share",   name: "Share",   owner: "auto", line: "A live view-only link or a PDF, current whenever someone opens it." },
    { key: "act",     name: "Act",     owner: "you",  line: "Pulse flags accounts Scale, Hold or Cut against your rules. The decision stays yours, and on Meta and TikTok you can change status and budget without leaving AdFunnl." },
  ],
};

// ── Hero signature: the Blended Overview (e-commerce) dashboard ──
// Faithful to the real template: per-platform metric cards + a blended row.
// Numbers are anonymized demo data (no real client/account).
const ovCols = [
  { label: "Spend",     cur: true },
  { label: "Purchases", cur: false, hideSm: true },
  { label: "Cost/Conv.",cur: true,  hideSm: true },
  { label: "ROAS",      cur: false },
  { label: "Revenue",   cur: true },
];
// cell = [value, deltaPct, up?, good?]
const ovRows = [
  { name: "Meta",     key: "meta",       color: "#1877F2", cells: [["18,824","17.6",false,true],["223","20.5",true,true],["84.41","31.6",false,true],["5.79×","42.8",true,true],["108,976","17.6",true,true]] },
  { name: "TikTok",   key: "tiktok",     color: "#111111", cells: [["3,767","19.5",false,true],["43","23.2",false,false],["87.60","4.8",true,false],["5.75×","2.6",false,false],["21,653","21.6",false,false]] },
  { name: "Google",   key: "google_ads", color: "#EA4335", cells: [["417","13.9",false,true],["20","60.1",false,false],["21.18","55.6",true,false],["24.5×","51.6",true,true],["10,256","58.3",true,true]] },
  { name: "Snapchat", key: "snapchat",   color: "#FFC300", cells: [["7,081","1.9",true,false],["120","10.1",true,true],["59.01","7.5",false,true],["8.60×","8.1",true,true],["60,906","8.7",true,true]] },
];
const ovBlended = [
  { label: "Total spend",  v: "26,323", cur: true },
  { label: "Conversions",  v: "363",    cur: false, hideSm: true },
  { label: "Blended CPP",  v: "74",     cur: true,  hideSm: true },
  { label: "Blended ROAS", v: "6.69×",  cur: false },
  { label: "Revenue",      v: "180,138",cur: true },
];

// ── Month-over-month showcase: spend (bars, $k) + ROAS (line, ×) ──
const momRows = [
  { m: "Feb", spend: 32, roas: 3.1 },
  { m: "Mar", spend: 41, roas: 3.6 },
  { m: "Apr", spend: 38, roas: 4.0 },
  { m: "May", spend: 55, roas: 4.3 },
  { m: "Jun", spend: 61, roas: 4.8 },
  { m: "Jul", spend: 72, roas: 5.2 },
];
const MOM_W = 480, MOM_H = 220, MOM_PL = 14, MOM_PR = 14, MOM_PT = 16, MOM_PB = 30;
const momPlotW = MOM_W - MOM_PL - MOM_PR;
const momPlotH = MOM_H - MOM_PT - MOM_PB;
const momMaxSpend = Math.max(...momRows.map((r) => r.spend));
const momMinRoas = Math.min(...momRows.map((r) => r.roas)) - 0.6;
const momMaxRoas = Math.max(...momRows.map((r) => r.roas)) + 0.4;
const momStep = momPlotW / momRows.length;
const momBarW = momStep * 0.46;
const momBars = momRows.map((r, i) => {
  const cx = MOM_PL + momStep * i + momStep / 2;
  const h = (r.spend / momMaxSpend) * momPlotH;
  return { x: cx - momBarW / 2, y: MOM_PT + momPlotH - h, w: momBarW, h, cx, m: r.m };
});
const momLinePts = momBars.map((b, i) => {
  const y = MOM_PT + momPlotH - ((momRows[i].roas - momMinRoas) / (momMaxRoas - momMinRoas)) * momPlotH;
  return [Math.round(b.cx * 10) / 10, Math.round(y * 10) / 10];
});
const momLine = momLinePts.map((p, i) => `${i ? "L" : "M"}${p[0]} ${p[1]}`).join(" ");
const momBaseY = MOM_PT + momPlotH;

// Shared cell classes for the two dark-section tables.
const numCell = "px-3 py-2.5 text-right tabular-nums lining-nums text-zinc-600";
---

<Layout
  title="Less time collecting numbers, more time using them"
  description="AdFunnl gathers every ad platform and your store revenue into one live dashboard, so your week starts with decisions instead of a report to put together."
>

  <!-- ============================== HERO ============================== -->
  <section class="relative overflow-hidden bg-white px-6 pt-16 pb-10 sm:pt-20">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_70%_55%_at_50%_-15%,#e6e1fb,transparent)]"></div>

    <div class="mx-auto grid max-w-6xl items-center gap-14 lg:grid-cols-[1.05fr_1fr]">
      <!-- Copy -->
      <div class="text-center lg:text-left">
        <h1 class="font-display text-[2.6rem] font-bold leading-[1.05] tracking-tight text-zinc-950 sm:text-6xl">
          Less time collecting numbers, more time <em class="text-brand-600">using</em> them
        </h1>

        <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-zinc-500 lg:mx-0">
          AdFunnl gathers every ad platform and your store revenue into one live
          dashboard, so your week starts with decisions instead of a report to put
          together.
        </p>

        <div class="mt-9 flex flex-col items-center gap-4 sm:flex-row lg:justify-start justify-center">
          <a href={`${APP_URL}/signup`}
             class="w-full rounded-xl bg-brand-600 px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand-200 transition hover:bg-brand-700 sm:w-auto">
            Start free
          </a>
        </div>
      </div>

      <!-- Signature: the real Blended Overview (e-commerce) dashboard, in an
           app window. Anonymized demo data, reveals + count-up on load. -->
      <div class="hero-app relative mx-auto w-full max-w-md lg:max-w-none">
        <div class="relative overflow-hidden rounded-2xl border border-zinc-200/80 bg-white shadow-2xl shadow-brand-900/20 ring-1 ring-zinc-900/[0.04]">
          <!-- app top bar -->
          <div class="flex items-center gap-2 border-b border-zinc-100 bg-white px-3.5 py-2.5">
            <span class="flex h-5 w-5 items-center justify-center rounded-md bg-brand-600 text-[10px] font-bold text-white">A</span>
            <div class="flex items-center gap-1.5 text-[11px] font-semibold text-zinc-700">
              <span class="flex h-4 w-4 items-center justify-center rounded bg-brand-100 text-[8px] font-bold text-brand-700">BD</span>
              Brand Data
            </div>
            <span class="ms-1 hidden rounded-md border border-zinc-200 px-2 py-0.5 text-[10px] font-medium text-zinc-500 sm:inline-block">This month</span>
            <span class="hidden rounded-md border border-brand-200 bg-brand-50 px-2 py-0.5 text-[10px] font-medium text-brand-700 sm:inline-block">vs. last period</span>
            <div class="ms-auto flex items-center gap-1.5">
              <span class="hidden rounded-md border border-zinc-200 px-2 py-0.5 text-[10px] font-medium text-zinc-500 sm:inline-block">Share</span>
              <span class="rounded-md bg-brand-600 px-2 py-0.5 text-[10px] font-semibold text-white">+ Widget</span>
            </div>
          </div>

          <!-- dashboard body -->
          <div class="space-y-2.5 bg-zinc-50/50 p-3.5">
            <!-- Overview banner -->
            <div class="flex items-center justify-between rounded-lg bg-brand-600 px-3.5 py-2 shadow-sm shadow-brand-900/20">
              <span class="font-display text-sm font-bold tracking-tight text-white">Overview</span>
              <span class="inline-flex items-center gap-1.5 rounded-md bg-white/15 px-2 py-0.5 text-[9px] font-semibold uppercase tracking-wide text-white">
                <span class="live-dot h-1.5 w-1.5 rounded-full bg-emerald-300"></span>Live
              </span>
            </div>

            <!-- per-platform metric rows -->
            {ovRows.map((row) => (
              <div class="flex items-stretch gap-2">
                <div class="flex w-7 shrink-0 items-center justify-center">
                  <span class="flex h-7 w-7 items-center justify-center overflow-hidden rounded-lg" title={row.name} aria-label={row.name}>
                    <PlatformIcon platform={row.key} class="h-5 w-5" />
                  </span>
                </div>
                <div class="grid flex-1 grid-cols-3 gap-1.5 sm:grid-cols-5">
                  {row.cells.map((c, i) => (
                    <div class={`rounded-lg border border-zinc-100 bg-white px-2 py-1.5 ${ovCols[i].hideSm ? "hidden sm:block" : ""}`}>
                      <p class="truncate text-[8px] font-medium uppercase tracking-wide text-zinc-400">{ovCols[i].label}</p>
                      <p class="mt-0.5 truncate font-display text-[12px] font-bold leading-tight text-zinc-900">
                        {ovCols[i].cur && <span class="text-[8px] font-semibold text-zinc-400">SAR </span>}{c[0]}
                      </p>
                      <p class={`mt-0.5 flex items-center gap-0.5 text-[8px] font-semibold ${c[3] ? "text-emerald-600" : "text-rose-500"}`}>
                        <span>{c[2] ? "▲" : "▼"}</span>{c[1]}%
                      </p>
                    </div>
                  ))}
                </div>
              </div>
            ))}

            <div class="border-t border-dashed border-zinc-200"></div>

            <!-- blended row (highlighted) -->
            <div class="flex items-stretch gap-2">
              <div class="flex w-7 shrink-0 items-center justify-center">
                <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-brand-600 text-white shadow-sm">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h18l-7 8v6l-4 2v-8z"/></svg>
                </span>
              </div>
              <div class="grid flex-1 grid-cols-3 gap-1.5 sm:grid-cols-5">
                {ovBlended.map((b, i) => (
                  <div class={`rounded-lg border border-brand-100 bg-brand-50/60 px-2 py-1.5 ${b.hideSm ? "hidden sm:block" : ""}`}>
                    <p class="truncate text-[8px] font-medium uppercase tracking-wide text-brand-400">{b.label}</p>
                    <p class="mt-0.5 truncate font-display text-[13px] font-bold leading-tight text-brand-900">
                      {b.cur && <span class="text-[8px] font-semibold text-brand-400">SAR </span>}
                      {i === 3 ? <span class="count" data-value={b.v}>{b.v}</span> : b.v}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- floating assistant bubble -->
        <div class="absolute -bottom-4 -left-3 hidden max-w-[15rem] rounded-xl border border-zinc-200 bg-white p-3 shadow-xl lg:block">
          <div class="flex items-start gap-2">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-600 text-[11px] font-bold text-white">AI</span>
            <p class="text-[11px] leading-snug text-zinc-600">"Which campaigns wasted budget last week?"</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================= SOCIAL PROOF ========================= -->
  <section class="border-y border-zinc-100 bg-zinc-50/70">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-center gap-x-10 gap-y-3 px-6 py-5 text-sm font-medium text-zinc-500">
      <span class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>Connect in minutes</span>
      <span class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>Synced hourly</span>
      <span class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>Shareable live dashboards</span>
      <span class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>Agency-ready multi-client</span>
    </div>
  </section>

  <!-- ===================== DATA FLOW (animated) ===================== -->
  <DataFlow sectionId="integrations" heading="Observe and share data in a couple of clicks." />

  <!-- ============== DATA ANALYSIS STAGES (animated time bar) ============== -->
  <AnalysisStages {...analysisStages} />

  <!-- ========================= SEE IT LIVE ========================= -->
  <section id="live" class="relative overflow-hidden bg-ink px-6 py-24">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_60%_50%_at_50%_0%,rgba(87,56,201,0.35),transparent)]"></div>
    <div class="mx-auto max-w-6xl">
      <div class="reveal mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Check campaign performance live &amp; side by side.
        </h2>
        <p class="mt-4 text-lg text-zinc-400">
          Instead of multiple tabs to see your ads, just open AdFunnl.. Imagine the
          time saved which can be re-invested where it truly matters.
        </p>
      </div>

      <!-- Pulse: featured, wide -->
      <div class="reveal mt-14 overflow-hidden rounded-2xl border border-white/10 bg-white shadow-2xl shadow-black/40">
        <div class="flex items-center gap-2 border-b border-zinc-100 bg-zinc-50 px-4 py-2.5">
          <span class="h-2.5 w-2.5 rounded-full bg-zinc-300"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-zinc-300"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-zinc-300"></span>
          <div class="ms-2 flex items-center gap-1.5 text-[11px] font-medium text-zinc-400">
            <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>Pulse · All platforms · Acme Cosmetics
          </div>
          <span class="ms-auto rounded-md bg-brand-50 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-brand-700">Scaling verdicts</span>
        </div>
        <div class="p-5 sm:p-6">
          <div class="mb-3 flex items-center justify-between">
            <p class="text-sm font-semibold text-zinc-800">Active campaigns</p>
            <p class="text-xs text-zinc-400">Rule: ROAS ≥ 3.0 to scale</p>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[560px] text-left text-sm">
              <thead>
                <tr class="border-b border-zinc-100 text-[11px] font-semibold uppercase tracking-wide text-zinc-400">
                  <th class="py-2 pe-3 font-semibold">Campaign</th>
                  <th class="py-2 px-3 text-right font-semibold">Spend</th>
                  <th class="py-2 px-3 text-right font-semibold">Revenue</th>
                  <th class="py-2 px-3 text-right font-semibold">ROAS</th>
                  <th class="py-2 px-3 text-right font-semibold">CTR</th>
                  <th class="py-2 ps-3 text-right font-semibold">Verdict</th>
                </tr>
              </thead>
              <tbody>
                {pulseRows.map((r, i) => (
                  <tr class="border-b border-zinc-50 last:border-0" data-pulse-row={i === 0 ? "cycle" : undefined}>
                    <td class="py-3 pe-3 font-medium text-zinc-700">
                      <span class="flex items-center gap-2">
                        <span class="flex h-[22px] w-[22px] shrink-0 items-center justify-center overflow-hidden rounded-md bg-white ring-1 ring-zinc-200/90">
                          <PlatformIcon platform={r.key} class="h-[15px] w-[15px]" />
                        </span>
                        {r.name}
                      </span>
                    </td>
                    <td class="py-3 px-3 text-right tabular-nums lining-nums text-zinc-600">{r.spend}</td>
                    <td class="py-3 px-3 text-right tabular-nums lining-nums text-zinc-600">{r.revenue}</td>
                    <td class="py-3 px-3 text-right font-semibold tabular-nums lining-nums text-zinc-900" data-roas>{r.roas}</td>
                    <td class="py-3 px-3 text-right tabular-nums lining-nums text-zinc-600">{r.ctr}</td>
                    <td class="py-3 ps-3 text-right">
                      <span class="verdict inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium" data-verdict={r.verdict}></span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Ad-level table widget, with the app's conditional formatting -->
      <div class="reveal mt-6 overflow-hidden rounded-2xl border border-white/10 bg-white shadow-2xl shadow-black/40">
        <div class="flex items-center gap-2 border-b border-zinc-100 bg-zinc-50 px-4 py-2.5">
          <span class="h-2.5 w-2.5 rounded-full bg-zinc-300"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-zinc-300"></span>
