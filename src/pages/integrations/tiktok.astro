---
import Layout from "../../layouts/Layout.astro";
import IntegrationDetail from "../../components/IntegrationDetail.astro";
import type { Copy } from "../../components/IntegrationDetail.astro";
import { faqPage } from "../../data/plans";

// ── The brief ─────────────────────────────────────────────────────────
//   Who     A media buyer or performance marketer running TikTok next to
//           other platforms, who searched for TikTok ads reporting or a
//           TikTok ads dashboard.
//   Promise TikTok read down to the ad, next to every other platform and
//           the store, with campaigns switched and launched without opening
//           TikTok Ads Manager.
//   Action  Start free.
//
// CAPABILITY WARNINGS (docs/what-ships.md, checked 29 October 2026):
//   - TikTok ad control from Claude or ChatGPT is Live.
//   - TikTok brings in NO audience breakdowns. The FAQ says so plainly.
//   - TikTok is in Best Creatives since the connector gained ad-level data.

const copy: Copy = {
  platform: "tiktok",
  hero: {
    heading: "TikTok ads reporting, next to every other platform",
    body: "AdFunnl reads your TikTok ad accounts down to the ad, ranks your TikTok creatives with the rest, and lets you switch campaigns and change budgets without opening TikTok Ads Manager.",
    cta: "Start free",
    shot: { src: "/screens/tiktok-dashboard.png", alt: "An AdFunnl dashboard filtered to TikTok, with spend, purchases and ROAS for a demo brand" },
  },
  pain: {
    heading: "TikTok Ads Manager only knows what TikTok did",
    body: "TikTok reports its own conversions, with its own column names and its own attribution window. Whether TikTok is really paying for itself depends on what Meta, Snapchat and Google did the same week and on what the store sold, and finding that out means another tab and more arithmetic by hand.",
  },
  comesIn: {
    heading: "What comes in from TikTok",
    items: [
      "Campaign, ad group and ad results, from as many ad accounts as your plan holds",
      "Each ad's creative, shown next to its numbers",
      "Ad fatigue across your TikTok ads",
      "Your last 90 days on the day you connect",
    ],
  },
  sections: [
    {
      heading: "Your TikTok creatives, ranked with the rest",
      body: "Best Creatives ranks TikTok ads by one score, ROAS 40%, cost per purchase 40% and outbound CTR 20%, next to your Meta and Snapchat ads, across several ad accounts at once and with each creative on the page.",
      points: [
        "A minimum spend filter keeps low-spend noise out of the ranking",
        "Ad Fatigue flags TikTok ads that are wearing out",
        "Spend timeline shows budget moving from one ad to another",
      ],
      shot: { src: "/screens/best-creatives.png", alt: "The Best Creatives page in AdFunnl, ranking demo ads by score" },
    },
    {
      heading: "Switch campaigns and change budgets from AdFunnl",
      body: "The Ads manager report lists every TikTok campaign next to the rest, opening into ad groups and ads. Turn a campaign on or off and edit its budget right there, without leaving the numbers that told you to.",
      shot: { src: "/screens/ads-manager.png", alt: "The Ads manager report in AdFunnl, with on and off switches and budgets per campaign" },
    },
    {
      heading: "Run TikTok from Claude or ChatGPT",
      body: "Connect AdFunnl to Claude or ChatGPT and ask it to make the change. Every change comes back as a plan first and only happens once you approve it in the chat.",
      tag: "Live",
      points: [
        "Pause, turn on and change budgets",
        "Duplicate, rename and delete, and edit the audience, ad text and URL tags",
        "New campaigns from your images and videos on Google Drive, and new ad groups and ads in running campaigns, all created switched off",
        "Run posts already on your TikTok profile as ads",
        "Website, ad engagement, lead form and lookalike audiences",
      ],
      link: { label: "What AI ad control can change on each platform", href: "/ai-ad-control" },
    },
  ],
  compare: {
    heading: "TikTok Ads Manager next to AdFunnl",
    cols: ["The job", "In TikTok Ads Manager", "In AdFunnl"],
    rows: [
      ["Seeing TikTok next to Meta, Snapchat and Google", "Open each platform in its own tab", "One table, one currency"],
      ["Checking TikTok against store revenue", "Line it up with your store by hand", "Store ROAS next to blended ROAS"],
      ["Finding the winning creative", "TikTok ads only, account by account", "Ranked with every platform's ads"],
      ["Pausing a campaign that is losing money", "Log in to TikTok and find it", "Switch it off in Ads manager"],
    ],
  },
  faq: {
    heading: "Questions about TikTok",
    items: [
      { q: "Does AdFunnl show TikTok age and gender?", a: "No. Audience breakdowns come from Meta and Snapchat. TikTok brings in campaign, ad group and ad results and the creatives." },
      { q: "Can I pause TikTok campaigns inside AdFunnl?", a: "Yes. Turn campaigns on and off and edit their budgets from the Ads manager report or a dashboard table. From Claude or ChatGPT you can do more, after approving each change." },
      { q: "How often does TikTok data refresh?", a: "Every 12 hours on Free and Solo, every 6 hours on Growth and every hour on Agency. The last 3 days are fetched again on every sync, so conversions that report late still land." },
      { q: "Can I connect several TikTok ad accounts?", a: "Yes. Your plan sets how many, from 3 ad accounts on Free upwards, and they can be grouped by brand or client." },
      { q: "Does a new TikTok campaign go live straight away?", a: "No. Anything created from Claude or ChatGPT starts switched off, so you can check it in TikTok before it spends." },
    ],
  },
  others: {
    heading: "Other ad platforms",
    links: [
      { label: "Meta", href: "/integrations/meta", icon: "meta" },
      { label: "Snapchat", href: "/integrations/snapchat", icon: "snapchat" },
      { label: "Every integration", href: "/integrations" },
    ],
  },
  closing: {
    heading: "Start with one TikTok account",
    body: "Connect it on the Free plan and see it next to the rest. Add your other platforms when it earns its place.",
    cta: "Start free",
  },
};
---

<Layout
  title="TikTok"
  seoTitle="TikTok ads reporting and dashboard, with every other platform · AdFunnl"
  description="TikTok ads reporting down to the ad, next to Meta, Snapchat, Google and your store in one currency, with creatives ranked and campaigns switched in place."
  schema={[faqPage(copy.faq.items)]}
  crumbTrail={[{ name: "Integrations", path: "/integrations" }, { name: "TikTok", path: "/integrations/tiktok" }]}
>
  <IntegrationDetail copy={copy} />
</Layout>
