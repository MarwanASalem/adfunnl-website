---
import Layout from "../layouts/Layout.astro";

const SUPPORT_EMAIL = "support@adfunnl.com";

// ── Privacy policy ────────────────────────────────────────────────────────
// This is the same policy the app serves at app.adfunnl.com/privacy, mirrored
// here so app stores and platform reviewers have a public URL on the marketing
// domain to point at. The app is the source: if the policy changes there,
// change it here too, and move the "Last updated" line on both.
//
// Deliberately low-visibility: linked from the footer only, and kept out of
// the nav and the sitemap-facing pages.
const LAST_UPDATED = "Last updated: August 2026";

type Section = { title: string; body: string[] };

const SECTIONS: Section[] = [
  {
    title: "Overview",
    body: [
      `AdFunnl ("we", "us", or "our") provides an advertising analytics platform that connects to your ad accounts and data sources to give you a unified view of your marketing performance. This Privacy Policy explains what data we collect, how we use it, and your rights.`,
    ],
  },
  {
    title: "Data we collect",
    body: [
      "We collect the following categories of data:",
      "• Account information: your email address and workspace name when you register.",
      "• Ad platform data: campaign metrics, spend, impressions, clicks and conversions fetched from connected platforms (Meta, TikTok, Snapchat and Google).",
      "• Google user data: when you connect Google Ads or Google Sheets, we access your Google account email, ad account metrics, and spreadsheet data that you explicitly authorize.",
      "• Usage data: logs of actions taken within the app, for debugging and reliability.",
    ],
  },
  {
    title: "How we use your data",
    body: [
      "We use the data we collect solely to provide and improve the AdFunnl service:",
      "• Displaying your advertising performance metrics in your dashboard.",
      "• Syncing and storing historical campaign data so you can analyze trends over time.",
      "• Sending transactional emails (account verification, password reset, workspace invitations).",
      "We do not use your data for advertising, profiling, or any purpose unrelated to providing the service.",
    ],
  },
  {
    title: "Google API services",
    body: [
      "AdFunnl's use of information received from Google APIs adheres to the Google API Services User Data Policy, including the Limited Use requirements. Specifically:",
      "• We only request the minimum Google scopes needed to fetch your ad metrics and spreadsheet data.",
      "• Google user data is used exclusively to display your own performance data within your AdFunnl dashboard.",
      "• We do not transfer, sell, or share Google user data with third parties except as necessary to operate the service, such as storing encrypted credentials in our database.",
      "• We do not use Google user data to serve advertisements.",
    ],
  },
  {
    title: "Shopify data",
    body: [
      "When you connect a Shopify store, we access your order and product data, including revenue, refunds, quantities and product details, to calculate aggregate revenue, blended ROAS and per-product performance in your dashboards. We do not store individual customer personal information such as names, email addresses or shipping addresses. You can disconnect your store at any time from the Connections page, which revokes our access to that data. We also honor Shopify's customer and shop data-erasure requests automatically.",
    ],
  },
  {
    title: "Data storage and security",
    body: [
      "Your data is stored in a secured PostgreSQL database hosted on Railway. OAuth credentials (access tokens and refresh tokens) are encrypted at rest using AES-256 encryption before storage. We use HTTPS for all data in transit. Access to production systems is restricted to authorized personnel.",
    ],
  },
  {
    title: "Data retention",
    body: [
      "We retain your account data for as long as your account is active. Ad performance data synced from connected platforms is retained to support historical analysis. You may request deletion of your account and associated data at any time by contacting us.",
    ],
  },
  {
    title: "Third-party sharing",
    body: [
      "We do not sell, rent, or share your personal data or Google user data with third parties for their own purposes. We may share data with service providers who assist us in operating the platform, such as Railway for hosting and Resend for email delivery, under confidentiality obligations. We may disclose data if required by law.",
    ],
  },
  {
    title: "Your rights",
    body: [
      "You have the right to access, correct, or delete the personal data we hold about you. You may disconnect any integrated platform at any time from the Connections page, which revokes our access to that platform's data. To exercise any of these rights, contact us at the address below.",
    ],
  },
];
---

<Layout
  title="Privacy Policy"
  description="How AdFunnl collects, uses and stores the data in your workspace, including data from connected ad platforms and stores."
  noindex
>
  <main class="mx-auto max-w-3xl px-6 py-16 md:py-20">
    <h1 class="font-display text-3xl font-bold tracking-tight text-zinc-900">Privacy Policy</h1>
    <p class="mt-2 text-sm text-zinc-500">{LAST_UPDATED}</p>

    <div class="mt-12 space-y-10">
      {SECTIONS.map((section) => (
        <section>
          <h2 class="text-lg font-semibold text-zinc-900">{section.title}</h2>
          <div class="mt-2 space-y-2">
            {section.body.map((paragraph) => (
              <p class="text-[15px] leading-relaxed text-zinc-600">{paragraph}</p>
            ))}
          </div>
        </section>
      ))}
    </div>

    <p class="mt-12 border-t border-zinc-200 pt-6 text-sm text-zinc-500">
      Questions or requests? Contact us at{" "}
      <a href={`mailto:${SUPPORT_EMAIL}`} class="text-brand-700 underline">{SUPPORT_EMAIL}</a>.
    </p>
  </main>
</Layout>
